# Ayu Ink: delta colours, included by ~/.gitconfig. lazygit's diffRenderers use the feature.
[delta "theme"]
	line-numbers = true
	syntax-theme = ayu-ink
	file-style = bold "#59c2ff"
	file-decoration-style = "#615f5d" ul
	hunk-header-style = line-number syntax
	hunk-header-decoration-style = "#615f5d" ol
	plus-style = syntax "#1e2112"
	plus-emph-style = syntax "#252c15"
	minus-style = syntax "#251717"
	minus-emph-style = syntax "#382020"
	plus-empty-line-marker-style = normal "#1e2112"
	minus-empty-line-marker-style = normal "#251717"
	line-numbers-left-style = "#93908a"
	line-numbers-right-style = "#93908a"
	line-numbers-minus-style = "#f07178"
	line-numbers-plus-style = "#aad94c"
	line-numbers-zero-style = "#93908a"
