# Ayu Neutral: delta colours, included by ~/.gitconfig. lazygit's diffRenderers use the feature.
[delta "theme"]
	line-numbers = true
	syntax-theme = ayu-neutral
	file-style = bold "#59c2ff"
	file-decoration-style = "#696764" ul
	hunk-header-style = line-number syntax
	hunk-header-decoration-style = "#696764" ol
	plus-style = syntax "#292d1e"
	plus-emph-style = syntax "#343926"
	minus-style = syntax "#2e2121"
	minus-emph-style = syntax "#3e2a2a"
	plus-empty-line-marker-style = normal "#292d1e"
	minus-empty-line-marker-style = normal "#2e2121"
	line-numbers-left-style = "#93908a"
	line-numbers-right-style = "#93908a"
	line-numbers-minus-style = "#f7777e"
	line-numbers-plus-style = "#aad94c"
	line-numbers-zero-style = "#93908a"
