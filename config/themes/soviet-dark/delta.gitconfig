# Soviet Dark: delta colours, included by ~/.gitconfig. lazygit's diffRenderers use the feature.
[delta "theme"]
	line-numbers = true
	syntax-theme = soviet-dark
	file-style = bold "#6ca0c6"
	file-decoration-style = "#555452" ul
	hunk-header-style = line-number syntax
	hunk-header-decoration-style = "#555452" ol
	plus-style = syntax "#33312a"
	plus-emph-style = syntax "#35332a"
	minus-style = syntax "#342929"
	minus-emph-style = syntax "#412e2b"
	plus-empty-line-marker-style = normal "#33312a"
	minus-empty-line-marker-style = normal "#342929"
	line-numbers-left-style = "#a3a187"
	line-numbers-right-style = "#a3a187"
	line-numbers-minus-style = "#f07666"
	line-numbers-plus-style = "#b8ba73"
	line-numbers-zero-style = "#a3a187"
