name "soviet-dark"

base {
    appearance "dark"
    background #242222
    separator #373535
    text #d8cfc4
}

actionBar {
    separator #373535

    button {
        background #1a1818
        hotkey #6ca0c6
        text #a8a68d
    }
}

asyncProgressBar {
    border #555452
    progress #6ca0c6
    itemProgress #b8ba73
}

breadcrumbs {
    color1 #242222
    color2 #3c3a3a
    color3 #343130
    separator #61615e
    text #d8cfc4
}

files {
    background {
        alternate #242222
        current #343130
        currentSelected #343130
        selected #3c3a3a
    }

    dragDropSelection {
        color #6ca0c6
        width 1
    }

    text {
        current #e9dfd0
        currentSelected #c58f9d
        hidden #a8a68d
        matched #d1b078
        selected #c58f9d

        highlighting1 #6ca0c6
        highlighting2 #b8ba73
        highlighting3 #c58f9d
        highlighting4 #d1b078
    }
}

searchBar {
    query {
        border #555452
        placeholder #a8a68d
    }

    results {
        highlighting #6ca0c6
        selection #343130
        subtitle #a8a68d
    }

    rowSeparator {
        color #3c3a3a
        show true
    }
}

statusBar {
    background #1a1818
    border #373535
    text #d8cfc4
    quickSelectNoResultsHighlighting #f07666
}

tableHeader {
    separator #373535
    text #a8a68d

    pressed {
        background #3c3a3a
    }
}

tabs {
    active {
        text #d8cfc4
    }

    inactive {
        background #1a1818
        text #a3a187
    }
}

terminal {
    caret {
        background #d1b078
        text #242222
    }
}

textEditor {
    error #f07666
    warning #2e271a
    keyword #d1b078
    comment #a3a187
    identifier #ec796b

    literal {
        string #b8ba73
        number #d29a69
        color #d29a69
    }

    gutter {
        background #242222
        text #8b8988
    }
}

titleBar {
    text #d8cfc4
}
