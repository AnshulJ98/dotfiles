#!/usr/bin/python3
# AeroSpace cmd-enter: focus the one workspace kitty, or start it on the main workspace.
import fcntl
import json
import os
from pathlib import Path
import socket
import stat
import subprocess
import sys
import time

# kitty and kitten come from PATH (Homebrew links both, wherever it puts the app); no install folder is named.
os.environ["PATH"] = "/opt/homebrew/bin:" + os.environ["PATH"]
sock = "/tmp/kitty-main"
main = Path.home() / ".local/state/kitty/workspaces/main.kitty-session"


def window_id():
    try:
        result = subprocess.run(["kitten", "@", "--to", "unix:" + sock, "ls"],
                                capture_output=True, text=True, timeout=1)
        return next((o["platform_window_id"] for o in json.loads(result.stdout)
                     if o.get("platform_window_id")), None)
    except (OSError, subprocess.TimeoutExpired, ValueError):
        return None


def dead_socket():
    # kitty 0.50.0 binds without unlinking, so the socket a crashed kitty left makes the next
    # one start without remote control ("Invalid listen_on=..., ignoring").
    try:
        if not stat.S_ISSOCK(os.stat(sock).st_mode):
            return False
        with socket.socket(socket.AF_UNIX) as probe:
            probe.settimeout(1)
            probe.connect(sock)
        return False
    except ConnectionRefusedError:
        return True
    except OSError:
        return False


def focus(wid):
    try:
        if subprocess.run(["aerospace", "focus", "--window-id", str(wid)]).returncode == 0:
            return
    except OSError:
        pass  # AeroSpace is not installed
    # AeroSpace does not always list kitty's windows; kitty can raise its own.
    subprocess.run(["kitten", "@", "--to", "unix:" + sock, "focus-window"], check=True, timeout=2)


def start():
    args = ["--listen-on", "unix:" + sock, "--session", str(main)]
    # macOS finds the app by name in any folder; elsewhere, or when it cannot, run kitty from PATH.
    if sys.platform == "darwin" and subprocess.run(["open", "-n", "-a", "kitty", "--args", *args],
                                                   timeout=5).returncode == 0:
        return
    subprocess.Popen(["kitty", *args], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)


# Keep the lock inode: unlinking it would let another starter bypass the lock.
try:
    with open(sock + ".lock", "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        wid = window_id()
        if wid:
            focus(wid)
        elif subprocess.run(["pgrep", "-f", "--", "--listen-on unix:" + sock],
                            stdout=subprocess.DEVNULL, timeout=2).returncode == 0:
            pass  # still starting; never remove a potentially active socket
        else:
            if dead_socket():
                os.unlink(sock)
            main.parent.mkdir(parents=True, exist_ok=True)
            try:
                with main.open("x") as session:
                    session.write("cd ~\nlaunch\n")
            except FileExistsError:
                pass
            start()
            deadline = time.monotonic() + 10
            while time.monotonic() < deadline:
                if window_id():
                    break
                time.sleep(0.1)
finally:
    # zmx 1.0.1 writes a crash report on every session exit (zmx #294).
    reports = Path.home() / "Library/Logs/DiagnosticReports"
    try:
        for report in reports.glob("zmx-*.ips"):
            try:
                if report.is_file() and report.stat().st_mtime < time.time() - 60 * 60:
                    os.unlink(report)
            except OSError:
                pass
    except OSError:
        pass  # The reports folder may not exist.
