#!/usr/bin/python3
# kmain [HOST]: focus or start one workspace kitty; the ssh host comes from the instance.
import fcntl
import json
import os
import re
import socket
import stat
import subprocess
import sys
import time
from pathlib import Path

# kitty and kitten come from PATH (Homebrew links both, wherever it puts the app); no install folder is named.
os.environ["PATH"] = "/opt/homebrew/bin:" + os.environ["PATH"]
host = sys.argv[1] if len(sys.argv) > 1 else ""
if len(sys.argv) > 2 or (
    len(sys.argv) > 1 and not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", host)
):
    print("kmain: invalid host", file=sys.stderr)
    sys.exit(2)
state = Path.home() / ".local/state/kitty"


def window_id(sock):
    try:
        result = subprocess.run(
            ["kitten", "@", "--to", "unix:" + sock, "ls"],
            capture_output=True,
            text=True,
            timeout=1,
        )
        return next(
            (
                o["platform_window_id"]
                for o in json.loads(result.stdout)
                if o.get("platform_window_id")
            ),
            None,
        )
    except (OSError, subprocess.TimeoutExpired, ValueError):
        return None


def dead_socket(sock):
    # kitty 0.50.0 binds without unlinking, so the socket a crashed kitty left makes the next
    # one start without remote control ("Invalid listen_on=..., ignoring").
    try:
        if not stat.S_ISSOCK(os.stat(sock).st_mode):
            return False
        with socket.socket(socket.AF_UNIX) as probe:
            probe.settimeout(1)
            probe.connect(sock)
        return False
    except ConnectionRefusedError:
        return True
    except OSError:
        return False


def focus(sock, wid):
    try:
        if (
            subprocess.run(["aerospace", "focus", "--window-id", str(wid)]).returncode
            == 0
        ):
            return
    except OSError:
        pass  # AeroSpace is not installed
    # AeroSpace does not always list kitty's windows; kitty can raise its own.
    subprocess.run(
        ["kitten", "@", "--to", "unix:" + sock, "focus-window"], check=True, timeout=2
    )


def start(host, sock, directory, main, background):
    args = ["--listen-on", "unix:" + sock, "--session", str(main)]
    if host:
        args += ["--title", host]
    env = (
        dict(os.environ, ZWS_HOST=host, ZWS_DIR=str(directory))
        if host
        else dict(os.environ)
    )
    app_env = (
        ["--env", "ZWS_HOST=" + host, "--env", "ZWS_DIR=" + str(directory)]
        if host
        else []
    )
    # macOS finds the app by name in any folder; elsewhere, or when it cannot, run kitty from PATH.
    if (
        sys.platform == "darwin"
        and subprocess.run(
            [
                "open",
                "-n",
                *(["-g"] if background else []),
                "-a",
                "kitty",
                *app_env,
                "--args",
                *args,
            ],
            timeout=5,
        ).returncode
        == 0
    ):
        return
    subprocess.Popen(
        ["kitty", *args],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
        env=env,
    )


def attached(directory):
    try:
        record = (directory / ".attached").read_text()
        return (
            record == "attached"
            or abs(float(record) - float((state / ".main-quit").read_text())) <= 5
        )
    except (OSError, ValueError):
        return False


def ensure(host, background=False):
    sock = "/tmp/kitty-" + host if host else "/tmp/kitty-main"
    directory = state / ("hosts/" + host if host else "workspaces")
    main = directory / "main.kitty-session"
    # Keep the lock inode: unlinking it would let another starter bypass the lock.
    with open(sock + ".lock", "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if host:
            directory.mkdir(parents=True, exist_ok=True)
            (directory / ".attached").write_text("attached")
        wid = window_id(sock)
        if wid:
            if not background:
                focus(sock, wid)
        elif (
            subprocess.run(
                ["pgrep", "-f", "--", "--listen-on unix:" + sock],
                stdout=subprocess.DEVNULL,
                timeout=2,
            ).returncode
            == 0
        ):
            pass  # still starting; never remove a potentially active socket
        else:
            if dead_socket(sock):
                os.unlink(sock)
            main.parent.mkdir(parents=True, exist_ok=True)
            try:
                with main.open("x") as session:
                    session.write("cd ~\nlaunch\n")
            except FileExistsError:
                pass
            start(host, sock, directory, main, background)
            deadline = time.monotonic() + 10
            while time.monotonic() < deadline:
                if window_id(sock):
                    break
                time.sleep(0.1)
            return True
    return False


try:
    if ensure(host) and not host:
        for directory in sorted((state / "hosts").glob("*")):
            if (
                directory.is_dir()
                and re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", directory.name)
                and attached(directory)
            ):
                ensure(directory.name, background=True)
finally:
    # zmx 1.0.1 writes a crash report on every session exit (zmx #294).
    reports = Path.home() / "Library/Logs/DiagnosticReports"
    try:
        for report in reports.glob("zmx-*.ips"):
            try:
                if report.is_file() and report.stat().st_mtime < time.time() - 60 * 60:
                    os.unlink(report)
            except OSError:
                pass
    except OSError:
        pass  # The reports folder may not exist.
