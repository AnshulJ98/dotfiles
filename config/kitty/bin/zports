#!/usr/bin/python3
from __future__ import annotations

import argparse
import fcntl
import ipaddress
import json
import os
import re
import signal
import socket
import subprocess
import sys
import time
from pathlib import Path

# Sent on stdin over the existing SSH master; no files are installed on the box.
SCAN = r"""
import json
import os
import socket
from pathlib import Path

def listeners(proc="/proc"):
    proc = Path(proc)
    sockets = {}
    for table, family in (("tcp", socket.AF_INET), ("tcp6", socket.AF_INET6)):
        try:
            rows = (proc / "net" / table).read_text().splitlines()[1:]
        except FileNotFoundError:
            if table == "tcp6":
                continue
            raise
        for row in rows:
            fields = row.split()
            if fields[3] != "0A":
                continue
            address, port = fields[1].split(":")
            raw = bytes.fromhex(address)
            raw = b"".join(raw[i:i+4][::-1] for i in range(0, len(raw), 4))
            address = socket.inet_ntop(family, raw)
            sockets[fields[9]] = dict(port=int(port, 16), address=address, program=None)
    for process in proc.iterdir():
        if not process.name.isdigit():
            continue
        try:
            inodes = []
            for fd in (process / "fd").iterdir():
                try:
                    link = os.readlink(fd)
                    if link.startswith("socket:["):
                        inodes.append(link[8:-1])
                except OSError:
                    continue  # Processes and fds can disappear during the walk.
            name = (process / "comm").read_text().strip()
            for inode in inodes:
                if inode in sockets:
                    sockets[inode]["program"] = name
        except OSError:
            continue  # An invisible owner does not hide its listener.
    return list(sockets.values())

if __name__ == "__main__":
    print(json.dumps(listeners()))
"""


def detect(host, ssh_port):
    try:
        result = subprocess.run(
            [
                "ssh",
                "-q",
                "-o",
                "ControlPath=/tmp/zcm-%C",
                "-o",
                "ControlMaster=no",
                "-o",
                "BatchMode=yes",
                "-o",
                "ConnectTimeout=2",
                host,
                "python3 - --ports-scan",
            ],
            input=SCAN,
            capture_output=True,
            text=True,
            timeout=2,
        )
        if result.returncode:
            return None
        found = {}
        for item in json.loads(result.stdout):
            remote = str(port(str(item["port"])))
            address = ipaddress.ip_address(item["address"])
            if isinstance(address, ipaddress.IPv6Address):
                address = address.ipv4_mapped or address
            if int(remote) < 1024 or int(remote) == ssh_port:
                continue
            if not (address.is_loopback or address.is_unspecified):
                continue
            target = (
                "127.0.0.1"
                if address.is_unspecified
                else f"[{address}]"
                if address.version == 6
                else str(address)
            )
            previous = found.get(remote)
            if previous is None or target == "127.0.0.1":
                name = item.get("program") or (previous and previous["program"])
                found[remote] = dict(target=target, program=name)
            elif not previous["program"]:
                previous["program"] = item.get("program")
        return found
    except (
        OSError,
        subprocess.TimeoutExpired,
        ValueError,
        KeyError,
        TypeError,
        argparse.ArgumentTypeError,
    ):
        return None  # A partial/failed scan must never look like an empty box.


def configured_port(host):
    try:
        result = subprocess.run(
            ["ssh", "-G", host], capture_output=True, text=True, timeout=2
        )
        if result.returncode == 0:
            match = re.search(r"^port ([0-9]+)$", result.stdout, re.MULTILINE)
            if match:
                return port(match.group(1))
    except (OSError, subprocess.TimeoutExpired, argparse.ArgumentTypeError):
        pass
    return None


def notify(host, added):
    script = (
        "on run argv\n"
        "display notification (item 2 of argv) with title (item 1 of argv)\nend run"
    )
    message = ", ".join(f"{remote}→{item['local']}" for remote, item in added)
    try:
        result = subprocess.run(
            ["osascript", "-e", script, host, message],
            capture_output=True,
            text=True,
            timeout=2,
        )
        if result.returncode:
            print(
                f"zports: notification failed: {result.stderr.strip()}", file=sys.stderr
            )
    except (OSError, subprocess.TimeoutExpired) as error:
        print(f"zports: notification failed: {error}", file=sys.stderr)


def port(value):
    if not re.fullmatch(r"[0-9]+", value) or not 1 <= int(value) <= 65535:
        raise argparse.ArgumentTypeError("port must be 1..65535")
    return int(value)


def ssh(host, operation, item=None, remote=None):
    args = [
        "ssh",
        "-o",
        "ControlPath=/tmp/zcm-%C",
        "-o",
        "ControlMaster=no",
        "-o",
        "BatchMode=yes",
        "-O",
        operation,
    ]
    if item is not None:
        args += ["-L", f"127.0.0.1:{item['local']}:{item['target']}:{remote}"]
    try:
        result = subprocess.run(
            [*args, host], capture_output=True, text=True, timeout=2
        )
        return result.returncode, result.stdout + result.stderr
    except (OSError, subprocess.TimeoutExpired) as error:
        return 255, str(error)


def free(local):
    try:
        with socket.socket() as probe:
            # TIME_WAIT connections are not listeners and must not reserve a mapping.
            probe.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            probe.bind(("127.0.0.1", local))
        # macOS permits the reusable bind above alongside a wildcard listener.
        for family, address in (
            (socket.AF_INET, "127.0.0.1"),
            (socket.AF_INET6, "::1"),
        ):
            try:
                with socket.socket(family) as probe:
                    probe.settimeout(0.2)
                    if probe.connect_ex((address, local)) == 0:
                        return False
            except OSError:
                continue  # IPv6 may be disabled.
        return True
    except OSError:
        return False


def alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def engine(directory, host, owner):
    record = (
        directory / "ports.json"
    )  # sidebar contract: forwards keyed by box port, plus stopped ports
    address = directory / ".ports.sock"
    state = (
        json.loads(record.read_text())
        if record.exists()
        else dict(forwards={}, stopped=[])
    )
    for item in state["forwards"].values():
        item.setdefault("automatic", False)
        item.setdefault("program", None)
    state.setdefault("waiting", [])
    master, next_sync, next_scan, running = None, 0, 0, True
    ssh_port = None
    targets = {}  # Last successfully scanned target for each observed port, even when stopped.
    pending = set()  # Only genuinely new forwards in this engine lifetime may announce.

    def end(signum, frame):
        nonlocal running
        running = False

    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, end)

    def save():
        temporary = record.with_suffix(".tmp")
        temporary.write_text(json.dumps(state) + "\n")
        os.replace(temporary, record)

    def cancel(remote, item):
        if item["local"] is not None:
            code, message = ssh(host, "cancel", item, remote)
            # A failed reply may still have removed the listener; never retain active=True.
            item["active"] = False
            save()
            if not code:
                for attempt in range(5):
                    if free(item["local"]):
                        return
                    time.sleep(0.05)
            raise RuntimeError(
                "cancel failed: " + (message.strip() or "local port is still busy")
            )

    def reconcile(found):
        for remote, item in list(state["forwards"].items()):
            if item["automatic"] and (
                remote not in found or item["target"] != found[remote]["target"]
            ):
                try:
                    cancel(remote, item)
                except RuntimeError as error:
                    print(f"zports: {error}", file=sys.stderr)
                    continue
                del state["forwards"][remote]
                pending.discard(remote)
        count = sum(item["automatic"] for item in state["forwards"].values())
        state["waiting"] = []
        for remote in sorted(found, key=int):
            item = state["forwards"].get(remote)
            if item:
                item["program"] = found[remote]["program"]
            elif int(remote) not in state["stopped"]:
                if count >= 20:
                    state["waiting"].append(int(remote))
                    continue
                state["forwards"][remote] = dict(
                    local=None, active=False, automatic=True, **found[remote]
                )
                pending.add(remote)
                count += 1

    def sync(poll=False):
        nonlocal master, next_sync, next_scan, ssh_port
        found = None
        code, message = ssh(host, "check")
        match = (
            re.search(r"Master running \(pid=(\d+)\)", message) if code == 0 else None
        )
        pid = match.group(1) if match else None
        if pid != master:
            master = pid
            for item in state["forwards"].values():
                item["active"] = False
        if poll and time.monotonic() >= next_scan:
            if master and ssh_port is None:
                ssh_port = configured_port(host)
            found = detect(host, ssh_port) if master and ssh_port is not None else None
            if found is not None:
                targets.update(
                    {remote: item["target"] for remote, item in found.items()}
                )
                reconcile(found)
            next_scan = time.monotonic() + 2
        if master:
            for remote, item in state["forwards"].items():
                if item["active"]:
                    continue
                local = item["local"] or int(remote)
                while local <= 65535:
                    # A saved mapping may still belong to this master: forward is idempotent.
                    if item["local"] == local or free(local):
                        item["local"] = local
                        code, _ = ssh(host, "forward", item, remote)
                        if code == 0:
                            item["active"] = True
                            break
                        if free(local):
                            break  # connection failure, not a local collision; retry next poll
                    local += 1
        save()
        announced = (
            [
                (remote, state["forwards"][remote])
                for remote in sorted(pending, key=int)
                if state["forwards"][remote]["active"]
            ]
            if found is not None
            else []
        )
        if announced:
            notify(host, announced)
            pending.difference_update(remote for remote, _ in announced)
        next_sync = time.monotonic() + 2

    def request(data):
        command = data["command"]
        if command != "list":
            remote = str(port(str(data["port"])))
            destination = data.get("target")
            if destination is None:
                destination = targets.get(remote, "127.0.0.1")
            if command not in ("forward", "stop"):
                raise ValueError("unknown command")
            if not re.fullmatch(
                r"[A-Za-z0-9][A-Za-z0-9._-]*|\[[0-9a-fA-F:.]+\]", destination
            ):
                raise ValueError("invalid target host")
            item = state["forwards"].get(remote)
            if item and (command == "stop" or item["target"] != destination):
                cancel(remote, item)
                del state["forwards"][remote]
            if command == "stop":
                state["stopped"] = sorted(set(state["stopped"]) | {int(remote)})
            else:
                item = state["forwards"].setdefault(
                    remote,
                    dict(local=None, target=destination, active=False, program=None),
                )
                item["automatic"] = False
                state["stopped"] = [p for p in state["stopped"] if p != int(remote)]
            pending.discard(remote)
            save()
        sync()
        return state

    try:
        address.unlink(missing_ok=True)
        with socket.socket(socket.AF_UNIX) as server:
            server.bind(str(address))
            address.chmod(0o600)
            server.listen()
            server.settimeout(0.5)
            for item in state["forwards"].values():
                item["active"] = False
            progress = 0
            while running and alive(owner):
                if time.monotonic() >= min(next_sync, next_scan):
                    sync(poll=True)
                if time.monotonic() >= progress:
                    print(f"zports: watching {host} for kitty {owner}", flush=True)
                    progress = time.monotonic() + 30
                try:
                    connection, _ = server.accept()
                except socket.timeout:
                    continue
                with connection:
                    connection.settimeout(5)
                    try:
                        with connection.makefile("r") as stream:
                            reply = request(json.loads(stream.readline(4096)))
                    except (
                        ValueError,
                        TypeError,
                        OSError,
                        RuntimeError,
                        KeyError,
                        argparse.ArgumentTypeError,
                    ) as error:
                        reply = dict(error=str(error))
                    try:
                        connection.sendall((json.dumps(reply) + "\n").encode())
                    except OSError as error:
                        print(f"zports: reply failed: {error}", file=sys.stderr)
    finally:
        for remote, item in state["forwards"].items():
            try:
                cancel(remote, item)
            except RuntimeError as error:
                print(f"zports: {error}", file=sys.stderr)
            item["active"] = False
        save()
        address.unlink(missing_ok=True)
        print("zports: stopped", flush=True)


def main():
    parser = argparse.ArgumentParser()
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("run").add_argument("owner", type=int)
    forward = commands.add_parser("forward")
    forward.add_argument("port", type=port)
    forward.add_argument("target", nargs="?")
    commands.add_parser("stop").add_argument("port", type=port)
    commands.add_parser("list")
    args = parser.parse_args()
    host = os.environ.get("ZWS_HOST", "")
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", host):
        parser.error("a valid ZWS_HOST is required (no forwarding on Mac)")
    directory = Path(
        os.environ.get("ZWS_DIR") or Path.home() / ".local/state/kitty/hosts" / host
    )
    if args.command == "run":
        if args.owner <= 0:
            parser.error("owner must be a positive pid")
        directory.mkdir(parents=True, exist_ok=True)
        with (directory / ".ports.lock").open("a") as lock:
            deadline = time.monotonic() + 3
            while True:
                try:
                    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    break
                except BlockingIOError:
                    if time.monotonic() >= deadline:
                        return
                    time.sleep(0.05)
            engine(directory, host, args.owner)
    else:
        with socket.socket(socket.AF_UNIX) as client:
            client.settimeout(10)
            client.connect(str(directory / ".ports.sock"))
            client.sendall((json.dumps(vars(args)) + "\n").encode())
            with client.makefile("r") as stream:
                reply = json.loads(stream.readline())
        if "error" in reply:
            raise RuntimeError(reply["error"])
        print(json.dumps(reply))


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, RuntimeError) as error:
        sys.exit(f"zports: {error}")
