#!/usr/bin/env bash
# Workspaces are kitty sessions shown one at a time in the tab bar (tab_bar_filter). Each has a
# session file in $ZWS_DIR that workspaces.py keeps current, so goto_session reopens it whole.
#   zws new [--ask | --window]  new workspace on the current folder (--ask prompts for a name,
#                               --window opens it in an OS window of its own)
#   zws rename NAME | close NAME | worktree new|open CWD   the sidebar's right-click menu
# The session name is fixed. What the sidebar and picker show is the ws_name user var of its
# panes and sidebars if set (rename, --ask), otherwise the repo or folder of its first pane.
set -u
export PATH=/opt/homebrew/bin:$PATH
DIR=${ZWS_DIR:-$HOME/.local/state/kitty/workspaces}
mkdir -p "$DIR"
self=$(realpath "$0")

# Prints: active session, active pane's folder, then open workspaces in tab order, one per line.
# kitty reports the folder of 'zmx attach' for held panes, so ask the session's shell instead.
state() {
  kitten @ ls | /usr/bin/python3 -c '
import json, subprocess, sys
order, cur, cwd, holder = [], "", "", ""
for o in json.load(sys.stdin):
    for t in o["tabs"]:
        for w in t["windows"]:
            s = w.get("session_name", "")
            if s and s not in order: order.append(s)
            if o["is_active"] and t["is_active"] and w["is_active"]:
                cur, cwd, holder = s, w["cwd"], w["user_vars"].get("holder", "")
if holder:
    try:  # zmx 1.0.1 ls line: tab-separated name= pid= clients= created= cwd= (tests/test_workspaces.py)
        out = subprocess.run(["zmx", "ls"], capture_output=True, text=True, timeout=3).stdout
        pid = next((p.split("=")[1] for l in out.splitlines() if f"name={holder}\t" in l
                    for p in l.split("\t") if p.strip().startswith("pid=")), "")
        live = subprocess.run(["lsof", "-a", "-d", "cwd", "-p", pid, "-Fn"], capture_output=True, text=True, timeout=3).stdout if pid else ""
        cwd = next((l[1:] for l in live.splitlines() if l.startswith("n")), cwd)
    except (OSError, subprocess.TimeoutExpired):  # keep the folder kitty reported
        pass
print(cur); print(cwd); print("\n".join(order))'
}

go() { kitten @ action goto_session "$DIR/$1.kitty-session"; }

# A free session name for a folder: its lower-cased name, then -2, -3...
unique() { # cwd
  local open base name n=2
  open=$(state | tail -n +3)
  base=$(basename "$1" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9._\n-' '-'); [ "$1" = "$HOME" ] && base=home
  name=$base
  while grep -qx "$name" <<<"$open" || [ -e "$DIR/$name.kitty-session" ]; do name=$base-$n; n=$((n + 1)); done
  echo "$name"
}

create() { # name cwd [shown-name] [window]
  local published
  published=$(/usr/bin/python3 - "$DIR" "$1" "$2" "${3:-}" "${4:-}" <<'PY'
import os, re, shlex, sys, tempfile, unicodedata
directory, base, cwd, shown, window = sys.argv[1:]
if (base in (".", "..") or not re.fullmatch(r"[a-zA-Z0-9._-]+", base)
        or any(unicodedata.category(c).startswith("C") or c in "\u2028\u2029"
               for value in (base, cwd, shown) for c in value)):
    sys.exit("zws: invalid workspace name or control character")
body = ("new_os_window\n" if window else "") + "cd " + cwd + "\n"
body += "launch" + (" --var " + shlex.quote("ws_name=" + shown) if shown else "") + "\n"
fd, temporary = tempfile.mkstemp(prefix=".create-", dir=directory)
try:
    with os.fdopen(fd, "w") as stream:
        stream.write(body)
    name, suffix = base, 2
    while True:
        try:
            os.link(temporary, os.path.join(directory, name + ".kitty-session"))
            break
        except FileExistsError:
            name, suffix = base + "-" + str(suffix), suffix + 1
    print(name)
finally:
    os.unlink(temporary)
PY
  ) || return
  go "$published"
}

# Run a prompt in an overlay over the active pane. In the script $0 is this file.
overlay() { # cwd script args...
  local cwd=$1 script=$2; shift 2
  kitten @ launch --type=overlay --cwd "$cwd" bash -c "export PATH=/opt/homebrew/bin:\$PATH; $script" "$self" ${1+"$@"} >/dev/null
}
# wt's error would vanish with the overlay, so keep it up until a key.
PAUSE='|| { echo; read -n1 -rsp "wt failed; press a key"; }'

case ${1:-} in
  new)
    cwd=$(state | sed -n 2p); cwd=${cwd:-$HOME}; name=$(unique "$cwd")
    case ${2:-} in
      --ask) overlay "$cwd" 'read -e -i "$1" -p "Workspace name: " n && [ -n "$n" ] && exec "$0" create "$1" "$2" "$n"' "$name" "$cwd" ;;
      --window) create "$name" "$cwd" '' window ;;
      *) create "$name" "$cwd" ;;
    esac ;;
  create) create "$2" "$3" "${4:-}" ;;
  here) # a workspace on $PWD (wt runs this in the worktree): the one already there, or a new one
    for f in "$DIR"/*.kitty-session; do
      [ -e "$f" ] && grep -qxF "cd $PWD" "$f" && { kitten @ action goto_session "$f"; exit; }
    done
    create "$(unique "$PWD")" "$PWD" ;;
  rename) # empty answer: back to the folder's name
    overlay "$HOME" 'read -e -p "Name for workspace $1 (empty: follow the folder): " n && exec kitten @ set-user-vars --match "session:^$1\$" "ws_name=$n"' "$2" ;;
  close) kitten @ action close_session "$2" ;;
  worktree) # wt makes or picks the worktree and runs 'zws here' inside it
    case $2 in
      new) overlay "$3" 'read -e -p "Branch for the new worktree: " b && [ -n "$b" ] || exit 0; wt switch -c "$b" --no-cd -x "$0" -- here '"$PAUSE" ;;
      open) overlay "$3" 'wt switch --no-cd -x "$0" -- here '"$PAUSE" ;;
    esac ;;
  *) sed -n '2,8p' "$0" >&2; exit 2 ;;
esac
