#!/usr/bin/env bash
# Workspaces are kitty sessions shown one at a time in the tab bar (tab_bar_filter). Each has a
# session file in $ZWS_DIR that workspaces.py keeps current, so goto_session reopens it whole.
#   zws new [--ask | --window] CWD  new workspace on CWD (home if absent; --ask prompts for a
#     name, --window opens it in an OS window of its own; ZWS_HOST comes from the instance, CWD is remote there)
#   zws rename NAME | close NAME | worktree new|open CWD   the sidebar's right-click menu
# The session name is fixed. What the sidebar and picker show is the ws_name user var of its
# panes and sidebars if set (rename, --ask), otherwise the repo or folder of its first pane.
set -u
export PATH=/opt/homebrew/bin:$PATH
DIR=${ZWS_DIR:-$HOME/.local/state/kitty/workspaces}
mkdir -p "$DIR"
self=$(realpath "$0")

go() { kitten @ action goto_session "$DIR/$1.kitty-session"; }

# A free session name for a folder: its lower-cased name, then -2, -3...
unique() { # cwd [home]
  local open= base name n=2
  [ ! -f "$DIR/.open" ] || open=$(<"$DIR/.open")
  base=$(basename "$1" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9._\n-' '-')
  [ "$1" = "${2:-$HOME}" ] && base=home
  name=$base
  while grep -qx "$name" <<<"$open" || [ -e "$DIR/$name.kitty-session" ]; do
    name=$base-$n
    n=$((n + 1))
  done
  echo "$name"
}

create() { # name cwd [shown-name] [window] [host] [remote-dir]
  local published
  published=$(
    /usr/bin/python3 - "$DIR" "$1" "$2" "${3:-}" "${4:-}" "${5:-}" "${6:-}" <<'PY'
import os, re, shlex, sys, tempfile, unicodedata
directory, base, cwd, shown, window, host, remote = sys.argv[1:]
if (base in (".", "..") or not re.fullmatch(r"[a-zA-Z0-9._-]+", base)
        or (host and not re.fullmatch(r"[a-zA-Z0-9][a-zA-Z0-9._-]*", host))
        or any(unicodedata.category(c).startswith("C") or c in "\u2028\u2029"
               for value in (base, cwd, shown, remote) for c in value)):
    sys.exit("zws: invalid workspace name, host or control character")
body = ("new_os_window\n" if window else "") + "cd " + cwd + "\n"
body += "launch" + "".join(" --var " + shlex.quote(var + "=" + value) for var, value in
                           (("ws_name", shown), ("host", host), ("host_dir", remote)) if value) + "\n"
fd, temporary = tempfile.mkstemp(prefix=".create-", dir=directory)
try:
    with os.fdopen(fd, "w") as stream:
        stream.write(body)
    name, suffix = base, 2
    while True:
        try:
            os.link(temporary, os.path.join(directory, name + ".kitty-session"))
            break
        except FileExistsError:
            name, suffix = base + "-" + str(suffix), suffix + 1
    print(name)
finally:
    os.unlink(temporary)
PY
  ) || return
  go "$published"
}

# Run a prompt in an overlay over the active pane. In the script $0 is this file.
overlay() { # cwd script args...
  local cwd=$1 script=$2
  shift 2
  kitten @ launch --type=overlay --cwd "$cwd" bash -c "export PATH=/opt/homebrew/bin:\$PATH; $script" "$self" ${1+"$@"} >/dev/null
}
# wt's error would vanish with the overlay, so keep it up until a key.
PAUSE='|| { echo; read -n1 -rsp "wt failed; press a key"; }'

case ${1:-} in
forward-port)
  overlay "$HOME" '
      read -e -p "Forward port: " n && [ -n "$n" ] || exit 0
      if [[ ! $n =~ ^[0-9]{1,5}$ ]] || (( 10#$n < 1 || 10#$n > 65535 )); then
        echo "Port must be a number from 1 to 65535"
      elif "$(dirname "$0")/zports" forward "$n" >/dev/null; then
        exit 0
      fi
      echo; read -n1 -rsp "Forward failed; press a key"
    '
  ;;
new)
  shift
  mode= host=${ZWS_HOST:-}
  while :; do
    case ${1:-} in
    --ask | --window)
      mode=$1
      shift
      ;;
    *) break ;;
    esac
  done
  # A host workspace's folder is remote (the panes' remote home if absent); kitty starts it in ~.
  # The box's home is unknown here without ssh; a user folder at the top of /home is taken as it.
  if [ -n "$host" ]; then
    remote=${1:-} cwd=$HOME home=$HOME
    case $remote in /home/*/*) ;; /root | /home/?*) home=$remote ;; esac
    name=$(unique "${remote:-$HOME}" "$home")
  else
    remote= cwd=${1:-$HOME}
    name=$(unique "$cwd")
  fi
  case $mode in
  --ask) overlay "$cwd" 'read -e -i "$1" -p "Workspace name: " n && [ -n "$n" ] && exec "$0" create "$1" "$2" "$n" "$3" "$4"' "$name" "$cwd" ${host:+"$host" "$remote"} ;;
  --window) create "$name" "$cwd" '' window "$host" "$remote" ;;
  *) create "$name" "$cwd" '' '' "$host" "$remote" ;;
  esac
  ;;
create) create "$2" "$3" "${4:-}" '' "${5:-}" "${6:-}" ;;
here) # a workspace on $PWD locally, or on the folder reported by host wt
  if [ -n "${ZWS_HOST:-}" ]; then
    remote=${2:-$PWD}
    found=$(
      /usr/bin/python3 - "$DIR" "$remote" <<'PY'
import glob, os, shlex, sys, unicodedata
directory, remote = sys.argv[1:]
if not remote.startswith("/") or any(unicodedata.category(c).startswith("C") or c in "\u2028\u2029"
                                      for c in remote):
    sys.exit("zws: invalid host folder")
for path in sorted(glob.glob(os.path.join(directory, "*.kitty-session"))):
    try:
        with open(path) as stream:
            for line in stream:
                if not line.startswith("launch "):
                    continue
                args = shlex.split(line)
                values = [args[i + 1] for i, arg in enumerate(args[:-1]) if arg == "--var"]
                values += [arg[6:] for arg in args if arg.startswith("--var=")]
                if "host_dir=" + remote in values:
                    print(path)
                    sys.exit(0)
    except (OSError, ValueError):
        continue
PY
    ) || exit
    if [ -n "$found" ]; then
      kitten @ action goto_session "$found"
    else create "$(unique "$remote")" "$HOME" '' '' "$ZWS_HOST" "$remote"; fi
    exit
  fi
  for f in "$DIR"/*.kitty-session; do
    [ -e "$f" ] && grep -qxF "cd $PWD" "$f" && {
      kitten @ action goto_session "$f"
      exit
    }
  done
  create "$(unique "$PWD")" "$PWD"
  ;;
rename) # empty answer: back to the folder's name
  overlay "$HOME" 'read -e -p "Name for workspace $1 (empty: follow the folder): " n && exec kitten @ set-user-vars --match "session:^$1\$" "ws_name=$n"' "$2"
  ;;
close) kitten @ action close_session "$2" ;;
worktree) # wt makes or picks the worktree and reports it to this instance
  if [ -n "${ZWS_HOST:-}" ]; then
    case $2 in
    new) script='read -e -p "Branch for the new worktree: " b && [ -n "$b" ] || exit 0; "$1" "$2" wt switch -c "$b"' ;;
    open) script='"$1" "$2" wt switch' ;;
    *) exit 2 ;;
    esac
    # Only standard host tools: the box may still have an older dotfiles checkout.
    report='printf "\033]1337;SetUserVar=zworktree=%s\007" "$(printf "%s" "$PWD" | base64 | tr -d "\n")"'
    # zrun already pauses on a missing program or an unreachable host.
    pause='|| { case $? in 97|255) ;; *) echo; read -n1 -rsp "wt failed; press a key";; esac; }'
    overlay "$HOME" "$script"' --no-cd -x sh -- -c "$3" '"$pause" "$(dirname "$self")/zrun" "$3" "$report"
    exit
  fi
  case $2 in
  new) overlay "$3" 'read -e -p "Branch for the new worktree: " b && [ -n "$b" ] || exit 0; wt switch -c "$b" --no-cd -x "$0" -- here '"$PAUSE" ;;
  open) overlay "$3" 'wt switch --no-cd -x "$0" -- here '"$PAUSE" ;;
  esac
  ;;
*)
  sed -n '2,8p' "$0" >&2
  exit 2
  ;;
esac
