#!/bin/bash
# kitty's shell: run every pane's shell inside a zmx session so closing kitty only detaches.
# The watcher (workspaces.py) supplies the session name over this pane's terminal: the saved
# holder=<name>, or a new folder-based one. Without an answer or without zmx, run plain zsh.
# In a workspace bound to an ssh host the answer adds the host and a remote folder, and the
# zmx session runs there over one shared ssh connection.
export PATH=/opt/homebrew/bin:$PATH
ZMX=/opt/homebrew/bin/zmx
SHELL_BIN=/bin/zsh
[ -x "$ZMX" ] || exec "$SHELL_BIN" -il

name= pi_session= host= dir=
if [ -t 0 ] && [ -t 2 ] &&
   IFS=' ' read -r -s -t 2 -p $'\033]1337;SetUserVar=zq=MQ==\007' a b c d &&
   [ "$a" = : ] && [ "$b" = zq ] && [ -n "$c" ]; then
  IFS=' ' read -r d e f <<<"$d"
  printf -v name '%b' "${c//%/\\x}"
  [ "$d" = - ] || printf -v pi_session '%b' "${d//%/\\x}"
  [ -z "$e" ] || [ "$e" = - ] || printf -v host '%b' "${e//%/\\x}"
  [ -z "$f" ] || [ "$f" = - ] || printf -v dir '%b' "${f//%/\\x}"
fi
if [ -z "$name" ]; then
  echo "zshell: the workspace watcher did not answer; starting plain shell" >&2
  exec "$SHELL_BIN" -il
fi

if [ -n "$host" ]; then
  # Any pane can set user vars, so a host that ssh would read as an option is refused.
  case $host in
    [A-Za-z0-9]*) ;;
    *) echo "zshell: refusing ssh host '$host'; starting plain shell" >&2; exec "$SHELL_BIN" -il ;;
  esac
  remote=
  [ -z "$dir" ] || remote="cd $(printf %q "$dir") 2>/dev/null; "
  remote+='for d in /usr/lib/kitty/shell-integration/zsh ~/.local/kitty.app/lib/kitty/shell-integration/zsh; do [ -d "$d" ] && export ZDOTDIR=$d && break; done; '
  remote+="ZMX_NO_DETACH_KEY=1 KITTY_SHELL_INTEGRATION=enabled exec \"\$(command -v zmx || echo ~/.local/bin/zmx)\" attach $(printf %q "$name")"
  # %C keeps the control socket path under macOS's 103-byte limit.
  exec ssh -tt -o ControlMaster=auto -o ControlPath=/tmp/zcm-%C -o ControlPersist=600 "$host" "$remote"
fi

if ! existing=$(timeout 3 "$ZMX" ls --short 2>/dev/null); then
  echo "zshell: zmx discovery failed or timed out; starting plain shell" >&2
  exec "$SHELL_BIN" -il
fi

# zmx's own detach key would steal ctrl+\ from programs; closing the pane already detaches.
export ZMX_NO_DETACH_KEY=1
unset ZMX_SESSION
# kitty only injects shell integration into a shell it starts itself.
export KITTY_SHELL_INTEGRATION=enabled
export ZDOTDIR=${KITTY_INSTALLATION_DIR:-/Applications/kitty.app/Contents/Resources/kitty}/shell-integration/zsh
case $'\n'"$existing"$'\n' in
  *$'\n'"$name"$'\n'*) present=1 ;;
  *) present=0 ;;
esac

if [ "$present" = 0 ] && [ -n "$pi_session" ] && [ -f "$pi_session" ]; then
  # The session is gone (reboot) but pi ran here: resume it in its own folder, then a shell.
  cwd=$(head -1 "$pi_session" | /usr/bin/python3 -c 'import json,sys; print(json.load(sys.stdin).get("cwd",""))' 2>/dev/null)
  exec "$ZMX" attach "$name" "$SHELL_BIN" -lc 'cd "$1" 2>/dev/null; pi --session "$2"; exec "$0" -il' "$SHELL_BIN" "${cwd:-$PWD}" "$pi_session"
fi
exec "$ZMX" attach "$name"
