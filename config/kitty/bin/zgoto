#!/usr/bin/env bash
# cmd+alt+g. One picker tab at most: open it, focus it, or, if it has focus, switch its
# view between all and detached sessions (forwards ctrl-t to fzf). esc closes it.
# $1 = the window it came from. kitty.conf passes @active-kitty-window-id, which kitty does not
# fill in for remote_control_script (0.50.0, boss.py), so then the focused window is looked up.
# --key (ctrl+\, zmx-pick's key elsewhere): the same, but a pane running ssh gets the key itself,
# so the remote zmx-pick has it. ssh may run in kitty's pane or inside the pane's zmx session,
# whose terminal kitty does not see. A pane of a host workspace (user var host) is kitty's own:
# its remote zmx has the detach key off, so the picker opens here.
export PATH=/opt/homebrew/bin:$PATH
read -r state wid < <(kitten @ ls 2>/dev/null | python3 -c '
import json, os, subprocess, sys
wid, key = sys.argv[1], sys.argv[2:] == ["--key"]
REMOTE = {"ssh", "mosh", "mosh-client", "et"}
def run(*cmd):
    try: return subprocess.run(cmd, capture_output=True, text=True, timeout=2).stdout
    except (OSError, subprocess.SubprocessError): return ""
def inside(holder):  # the foreground program of a zmx session, as bin/zpick-rows finds it
    pid = next((f.split("=", 1)[1] for line in run("zmx", "ls").splitlines() for f in line.split("\t")
                if line.strip().lstrip("→ ").startswith(f"name={holder}\t") and f.startswith("pid=")), "")
    procs = {p[0]: p[1:] for p in (l.split(None, 2) for l in run("ps", "-Ao", "pid=,tpgid=,comm=").splitlines()) if len(p) == 3}
    tpgid = procs.get(pid, ("", ""))[0]
    return os.path.basename(procs.get(tpgid, procs.get(pid, ("", "")))[1]).lstrip("-")
st, windows = "none", {}
for o in json.load(sys.stdin):
    for t in o["tabs"]:
        for w in t["windows"]:
            focused = o["is_focused"] and t["is_focused"] and w["is_focused"]
            windows[str(w.get("id"))] = w
            if focused and not wid.isdigit():
                wid = str(w.get("id"))
            if w.get("user_vars", {}).get("role") == "zgoto":
                st = "focused" if focused else "open"
w = windows.get(wid, {})
if key and st != "focused" and w:
    fg = {os.path.basename(p["cmdline"][0]) for p in w.get("foreground_processes", []) if p.get("cmdline")}
    holder, host = (w.get("user_vars", {}).get(k, "") for k in ("holder", "host"))
    if not host and (fg & REMOTE or (holder and inside(holder) in REMOTE)):
        st = "remote"
print(st, wid if wid.isdigit() else "")' "$1" "${2:-}")
case $state in
  remote)  kitten @ send-key --match "id:$wid" ctrl+backslash ;;
  focused) kitten @ send-key --match var:role=zgoto ctrl+t ;;
  open)    kitten @ focus-window --match var:role=zgoto ;;
  *)       kitten @ launch --type=tab --tab-title 'Go to' --var role=zgoto "$(dirname "$(realpath "$0")")/zpick" ${wid:+"$wid"} >/dev/null ;;
esac
