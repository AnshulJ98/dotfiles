#!/usr/bin/env python3
"""Rows for zpick: workspaces > tabs > panes of this kitty, then zmx sessions no pane holds,
then closed workspaces (session files with no open tabs).

usage: zpick-rows VIEW [WINDOW]   VIEW is all | detached (detached sessions and closed workspaces
only) | zmx (every zmx session, no kitty: zmx-pick in any terminal); WINDOW is the pane the picker was opened from, whose workspace is marked current.
Each row: kind, target, holder, cwd, clients, display; tab separated. kind is ws | tab | pane |
det | closed; target is the session name, tab id, window id, zmx session or session file.
clients is 0 only for a session no terminal is attached to. Inside fzf (FZF_COLUMNS) the right
hand columns are set flush against the preview.
"""
import json
import os
import re
import subprocess
import sys
import time

HOME = os.path.expanduser('~')
DIR = os.environ.get('ZWS_DIR', os.path.join(HOME, '.local/state/kitty/workspaces'))
SHELLS = {'zsh', 'bash', 'fish', 'sh'}
ACCENT = '\033[38;2;68;221;255m'
STATUS = {'working': '\033[38;2;255;136;68m', 'blocked': '\033[38;2;255;85;85m',
          'done': '\033[38;2;102;255;136m', 'running': '', 'idle': '\033[2m', 'shell': '\033[2m'}
DIM, BOLD, OFF = '\033[2m', '\033[1m', '\033[0m'
ANSI = re.compile(r'\033\[[0-9;]*m')
# fzf's list: its width less the preview and the pointer, marker, scrollbar and border columns
WIDTH = int(os.environ.get('FZF_COLUMNS') or 0) - int(os.environ.get('FZF_PREVIEW_COLUMNS') or 0) - 5
if WIDTH < 20:  # not in fzf
    WIDTH = 96


def run(*cmd: str) -> str:
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ''


def age(seconds: float) -> str:
    s = max(0, int(seconds))
    return f'{s // 60}m' if s < 3600 else (f'{s // 3600}h' if s < 86400 else f'{s // 86400}d')


def short(path: str) -> str:
    return '~' + path[len(HOME):] if path.startswith(HOME) else path


def fit(text: str, width: int) -> str:
    return text[:width - 1] + '…' if len(text) > width else text.ljust(width)


def zmx_sessions() -> dict[str, dict[str, str]]:
    # zmx 1.0.1 ls line: tab-separated name= pid= clients= created= cwd= (tests/test_workspaces.py)
    out = {}
    for line in run('zmx', 'ls').splitlines():
        line = line.strip().removeprefix('→')  # the arrow marks the session zmx ls ran in
        f = dict(p.strip().split('=', 1) for p in line.split('\t') if '=' in p)
        if 'name' in f:
            f['cwd'] = f.get('cwd', '').split('://', 1)[-1]
            f['cwd'] = f['cwd'][f['cwd'].find('/'):] if '/' in f['cwd'] else ''
            out[f['name']] = f
    return out


def spaces() -> dict[str, tuple[str, str, str]]:
    """zmx session -> (session file, the file's first session, its first folder): the kitty space
    that holds it, read from the saved session files. The newest file wins."""
    out = {}
    try:
        files = sorted((os.path.join(DIR, f) for f in os.listdir(DIR) if f.endswith('.kitty-session')),
                       key=os.path.getmtime)
    except OSError:
        return out
    for path in files:
        try:
            text = open(path, errors='replace').read()
        except OSError:
            continue
        holders = re.findall(r'--var=holder=(\S+)', text)
        cd = next((ln[3:].strip() for ln in text.splitlines() if ln.startswith('cd ')), '')
        for h in holders:
            out[h] = (os.path.basename(path), holders[0], cd)
    return out


def live_cwds(pids: list[str]) -> dict[str, str]:
    """pid -> current folder. zmx ls only knows the folder a session started in."""
    out, pid = {}, ''
    for line in run('lsof', '-a', '-d', 'cwd', '-p', ','.join(pids), '-Fn').splitlines() if pids else []:
        if line.startswith('p'):
            pid = line[1:]
        elif line.startswith('n'):
            out[pid] = line[1:]
    return out


def foreground() -> dict[int, str]:
    """Session child pid -> name of the foreground program on its terminal."""
    procs = {}
    for line in run('ps', '-Ao', 'pid=,tpgid=,comm=').splitlines():
        parts = line.split(None, 2)
        if len(parts) == 3 and parts[0].isdigit():
            procs[int(parts[0])] = (int(parts[1]) if parts[1].lstrip('-').isdigit() else 0, parts[2])
    def name(pid: int) -> str:
        tpgid, comm = procs.get(pid, (0, ''))
        comm = procs.get(tpgid, (0, comm))[1] if tpgid > 0 else comm
        return os.path.basename(comm).lstrip('-')
    return {pid: name(pid) for pid in procs}


def git_ref(cwd: str) -> tuple[str, str]:
    """('branch' or 'branch · worktree of repo', the checkout's folder); read from .git, no
    subprocess. ('', '') outside a repo."""
    d = cwd
    # git's own setting: the search does not climb into these folders
    ceilings = {os.path.abspath(p) for p in os.environ.get('GIT_CEILING_DIRECTORIES', '').split(':') if p}
    while d and d != '/':
        git = os.path.join(d, '.git')
        try:
            of = ''
            if os.path.isfile(git):  # "gitdir: <repo>/.git/worktrees/<name>"
                git = os.path.join(d, open(git).read().split(':', 1)[1].strip())
                if '/.git/worktrees/' in git:
                    of = os.path.basename(git.split('/.git/worktrees/')[0])
            head = open(os.path.join(git, 'HEAD')).read().strip()
            name = head.rpartition('refs/heads/')[2] if head.startswith('ref:') else head[:7]
            return name + (f' · worktree of {of}' if of else ''), d
        except (OSError, IndexError):
            d = os.path.dirname(d)
            if d in ceilings:
                break
    return '', ''


def row(kind: str, target: str, holder: str, cwd: str, clients: str, display: str) -> str:
    return '\t'.join((kind, target, holder, cwd, clients, display))


def flush(left: str, rights: list[str], label: str = '', keep: str = '') -> str:
    """left, the label, then the first of rights that leaves the label room, set against the
    right edge. rights go from the fullest to the leanest; in a narrow list none may fit.
    keep follows the label and is never cut: a long label gives way to it."""
    for right in [*rights, '']:
        room = WIDTH - len(ANSI.sub('', left)) - len(ANSI.sub('', right)) - 1
        if room >= (12 if label else 0):
            break
    if len(label) + len(keep) > room:
        label = label[:max(0, room - len(keep) - 1)] + '…'
    label += keep
    return left + label + ' ' * (room - len(label) + 1) + right


def main() -> None:
    view = sys.argv[1] if len(sys.argv) > 1 else 'all'
    origin = sys.argv[2] if len(sys.argv) > 2 else ''
    now = time.time()
    zs = zmx_sessions()
    cwds = live_cwds([z['pid'] for z in zs.values() if z.get('pid', '').isdigit()])
    for z in zs.values():
        z['cwd'] = cwds.get(z.get('pid', ''), z['cwd'])
    fg = foreground()
    zmx = view in ('zmx', 'zmx-detached')  # zmx-pick: no kitty
    kitty = [] if zmx else json.loads(run('kitten', '@', 'ls') or '[]')

    def proc_status(w: dict, holder: str) -> tuple[str, str, str]:
        z = zs.get(holder)
        if z:
            proc = fg.get(int(z.get('pid', 0) or 0), '')
            when = age(now - int(z.get('created', now)))
        else:
            fps = w.get('foreground_processes') or [{}]
            proc = os.path.basename((fps[0].get('cmdline') or [''])[0]).lstrip('-')
            when = age(now - w.get('created_at', now * 1e9) / 1e9)
        st = (w.get('program_status') or [{}])[0].get('state', '') if w else ''
        status = st or ('shell' if proc in SHELLS else 'running')
        return proc, status, when

    held, open_ws = set(), []
    workspaces: dict[str, list[dict]] = {}
    named: dict[str, str] = {}  # names given with rename; on panes and sidebars
    current = ''
    for o in kitty:
        for t in o['tabs']:
            ws = next((w.get('session_name', '') for w in t['windows'] if w.get('session_name')), '')
            if any(w['user_vars'].get('role') == 'zgoto' for w in t['windows']):
                continue
            named[ws] = named.get(ws) or next((w['user_vars']['ws_name'] for w in t['windows']
                                               if w['user_vars'].get('ws_name')), '')
            t['windows'] = [w for w in t['windows'] if w['user_vars'].get('role') != 'sidebar'] or t['windows']
            workspaces.setdefault(ws, []).append(t)
            for w in t['windows']:
                held.add(w['user_vars'].get('holder', ''))
                if str(w['id']) == origin or (not origin and o['is_active'] and t['is_active'] and w['is_active']):
                    current = ws
    det = [z for name, z in zs.items() if name not in held]
    hw = max([len(h) for h in held] + [len(z['name']) for z in det] + [0])  # the session column

    def pane_cols(proc: str, status: str, when: str, holder: str) -> list[str]:
        state = f'{STATUS.get(status, "")}{fit(status, 8)}{OFF}'
        return [f'{fit(proc, 8)} {state} {DIM}{when:>3}  {holder:>{hw}}{OFF}',
                f'{fit(proc, 8)} {state} {DIM}{when:>3}{OFF}', state]

    rows = []
    if view == 'all':
        for ws, tabs in workspaces.items():
            open_ws.append(ws)
            panes = [w for t in tabs for w in t['windows']]
            first = panes[0]  # names the workspace, as in the sidebar
            holder = first['user_vars'].get('holder', '')
            cwd = zs.get(holder, {}).get('cwd') or first.get('cwd', '')
            ref, top = git_ref(cwd)
            shown = named[ws] or ('home' if cwd == HOME else os.path.basename(top or cwd)) or ws
            mark = f'{ACCENT}◆{OFF}' if ws == current else f'{DIM}◇{OFF}'
            rows.append(row('ws', ws, holder, first.get('cwd', ''), '', flush(
                f'{mark} {BOLD}{shown if ws else "(no workspace)"}{OFF} {DIM}{len(tabs)} tab{"s" if len(tabs) > 1 else ""}{OFF}',
                [f'{DIM}{ref}{OFF}'])))
            for ti, t in enumerate(tabs):
                last_t = ti == len(tabs) - 1
                active = next((w for w in t['windows'] if w['is_active']), t['windows'][0])
                if len(t['windows']) == 1:  # nothing to nest: the tab's row carries its pane
                    holder = active['user_vars'].get('holder', '')
                    rows.append(row('pane', str(active['id']), holder, active.get('cwd', ''), '1', flush(
                        f'  {"└─" if last_t else "├─"} ', pane_cols(*proc_status(active, holder), holder), t['title'])))
                    continue
                rows.append(row('tab', str(t['id']), active['user_vars'].get('holder', ''), active.get('cwd', ''), '',
                                flush(f'  {"└─" if last_t else "├─"} ', [], t['title'])))
                for wi, w in enumerate(t['windows']):
                    holder = w['user_vars'].get('holder', '')
                    stem = '   ' if last_t else '│  '
                    branch = '└─' if wi == len(t['windows']) - 1 else '├─'
                    rows.append(row('pane', str(w['id']), holder, w.get('cwd', ''), '1',
                                    flush(f'  {stem}{branch} ', pane_cols(*proc_status(w, holder), holder), w['title'])))
    else:
        open_ws = list(workspaces)

    if view == 'zmx-detached':
        det = [z for z in det if z.get('clients', '0') == '0']
    if det and zmx:
        # No kitty to ask: a session sits in the space whose saved session file holds it, named as
        # cmd+alt+g names it; one no file holds is grouped by where it is, the git checkout (branch
        # alongside) or the plain folder.
        where = spaces()
        groups: dict[str, tuple[str, str, list[tuple[dict, str]]]] = {}
        for z in det:
            space = where.get(z['name'])
            cwd = (zs.get(space[1], {}).get('cwd') or space[2]) if space else z['cwd']
            ref, top = git_ref(cwd)
            folder = (top or cwd).rstrip('/') or '/'
            shown = 'home' if folder == HOME.rstrip('/') else os.path.basename(folder) or folder
            at = short(z['cwd']) if space else os.path.relpath(z['cwd'], folder) if z['cwd'].rstrip('/') != folder else ''
            groups.setdefault(space[0] if space else folder, (shown, ref, []))[2].append((z, at))
        for shown, ref, members in groups.values():
            n = len(members)
            rows.append(row('hdr', '', '', '', '', flush(
                f'{DIM}◇{OFF} {BOLD}{shown}{OFF} {DIM}{n} session{"s" if n > 1 else ""}{OFF}',
                [f'{DIM}{ref}{OFF}'])))
            for i, (z, below) in enumerate(members):
                other = z.get('clients', '0') != '0'
                proc, status, when = proc_status({}, z['name'])
                cols = f'{fit(proc, 8)} {STATUS.get(status, "")}{fit(status, 8)}{OFF} {DIM}{when:>3}{OFF}'
                # the session name leads, so fzf searches it
                rows.append(row('det', z['name'], z['name'], z['cwd'], z.get('clients', '0'), flush(
                    f'  {"└─" if i == n - 1 else "├─"} ', [f'{DIM}{fit(below, 22)}{OFF} {cols}', cols],
                    z['name'], ' · attached' if other else '')))
    elif det:
        rows.append(row('hdr', '', '', '', '', f'{DIM}detached{OFF}'))
        for i, z in enumerate(det):
            other = z.get('clients', '0') != '0'
            branch = '└─' if i == len(det) - 1 else '├─'
            rows.append(row('det', z['name'], z['name'], z['cwd'], z.get('clients', '0'), flush(
                f'  {branch} ', pane_cols(*proc_status({}, z['name']), z['name']),
                short(z['cwd']) + (' · other kitty' if other else ''))))
    try:
        files = sorted(f for f in os.listdir(DIR) if f.endswith('.kitty-session'))
    except OSError:
        files = []
    closed = [] if zmx else [f for f in files if f[:-len('.kitty-session')] not in open_ws]
    if closed:
        rows.append(row('hdr', '', '', '', '', f'{DIM}closed workspaces{OFF}'))
        for i, f in enumerate(closed):
            path = os.path.join(DIR, f)
            text = open(path, errors='replace').read()
            tabs = max(1, text.count('\nnew_tab') + text.startswith('new_tab'))
            ref = git_ref(next((ln[3:].strip() for ln in text.splitlines() if ln.startswith('cd ')), ''))[0]
            count = f'{tabs} tab{"s" if tabs > 1 else ""}  {age(now - os.path.getmtime(path)):>3}'
            branch = '└─' if i == len(closed) - 1 else '├─'
            rows.append(row('closed', path, '', '', '', flush(
                f'  {branch} ',
                [f'{DIM}{ref + "  " if ref else ""}{count}{OFF}', f'{DIM}{count}{OFF}'],
                f[:-len('.kitty-session')])))
    print('\n'.join(rows))


if __name__ == '__main__':
    main()
