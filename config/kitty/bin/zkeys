#!/usr/bin/env bash
# cmd+/. Keys popup: a full tab listing keys.txt in the Go to picker's box. Type to filter;
# esc, enter or cmd+/ again closes it.
export PATH=/opt/homebrew/bin:$PATH
self=$(realpath "$0")
if [ "${1:-}" != --show ]; then
  kitten @ close-window --match var:role=zkeys 2>/dev/null ||
    kitten @ launch --type=tab --tab-title Keys --var role=zkeys "$self" --show >/dev/null
  exit 0
fi
A='#44ddff'
awk -F'\t' '
  /^##/ || !NF { next }
  /^# /  { printf "%s\033[1;38;2;68;221;255m%s\033[0m\n", (n++ ? "\n" : ""), substr($0, 3); next }
  { sub(/left\|right\|up\|down/, "arrows", $1); printf "  \033[1m%-22s\033[0m%s%s\n", $1, $2, ($3 ? "  \033[2m" $3 "\033[0m" : "") }
' "$(dirname "$self")/../keys.txt" |
  FZF_DEFAULT_OPTS= fzf --ansi --no-sort --exact --no-hscroll --layout reverse \
    --border rounded --border-label ' Keys ' --border-label-pos 3 --margin 6%,10% --padding 1,2 \
    --prompt '/ ' --ghost 'type to filter' --info inline-right --pointer '▌' --gutter ' ' \
    --input-border line --list-border none --footer 'esc or cmd+/ closes' --footer-border line \
    --color "fg:-1,bg:-1,hl:$A,hl+:$A,fg+:-1:bold,bg+:#22313c,gutter:-1,border:$A,label:$A:bold" \
    --color "prompt:$A,pointer:$A,info:8,ghost:8,footer:8,separator:8,scrollbar:8,input-border:8,footer-border:8" \
    >/dev/null
exit 0
