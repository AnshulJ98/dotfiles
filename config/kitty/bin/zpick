#!/usr/bin/env bash
# Go to: full-tab picker over this kitty's workspaces > tabs > panes, then zmx sessions no pane
# holds and closed workspaces (zpick-rows). Runs in a tab opened by zgoto; $1 = id of the window
# the user came from. ctrl-t (or cmd+alt+g, forwarded by zgoto) switches to detached and closed only.
# ctrl-x kills sessions: never the one the picker was opened from, and an attached one only when
# pressed a second time.
# zpick --zmx: the same picker over zmx sessions only, no kitty; prints the session to attach (a
# typed name when nothing matches, or with ctrl-n), fails on esc. bin/../../zmx/zmx-pick loops on it.
set -u
export PATH=/opt/homebrew/bin:$PATH:$HOME/.local/bin
self=$(realpath "$0")
here=$(dirname "$self")
DIR=${ZWS_DIR:-$HOME/.local/state/kitty/workspaces}

# The view (all | detached) lives in a file so fzf's reload and label commands can read it.
export ZPICK_VIEW=${ZPICK_VIEW:-}
# zmx mode has the same two, over zmx sessions: zmx | zmx-detached.
view() {
  local v
  v=$(cat "$ZPICK_VIEW" 2>/dev/null) || v=all
  if [ "${ZPICK_MODE:-}" = zmx ]; then [ "$v" = detached ] && echo zmx-detached || echo zmx; else echo "$v"; fi
}
toggle() {
  local next=all
  case $(view) in all | zmx) next=detached ;; esac
  echo "$next" >"$ZPICK_VIEW"
}
label() {
  case $(view) in all) echo ' Go to ' ;; zmx) echo ' zmx ' ;; zmx-detached) echo ' zmx · detached ' ;;
  *) echo ' Go to · detached and closed ' ;; esac
}
ghost() {
  case $(view) in all) echo 'search workspaces, tabs and panes' ;; zmx) echo 'search, or type a new name' ;;
  zmx-detached) echo 'search detached, or type a new name' ;; *) echo 'search detached sessions' ;; esac
}
footer() {
  if [ -s "$ZPICK_VIEW.ask" ]; then
    echo "attached: $(tr '\n' ' ' <"$ZPICK_VIEW.ask")· ^x again kills"
  elif [ "${ZPICK_MODE:-}" = zmx ]; then
    echo 'enter attach · ^n new · ^t view · ^x kill · ^\ back · esc'
  else echo 'enter go · ^o open there · ^s split · ^t view · tab mark · ^x kill · esc'; fi
}
# fzf runs this for the list. It also notes the row of the pane the picker came from.
list() {
  local rows
  rows=$("$here/zpick-rows" "$(view)" "${ZPICK_FROM:-}")
  # the pane the picker came from; in zmx mode the first session, below its header
  awk -F'\t' -v w="${ZPICK_FROM:-}" -v zmx="$([ "${ZPICK_MODE:-}" = zmx ] && echo 1)" \
    '($1 == "pane" && $2 == w) || (zmx && $1 == "det") { print NR; exit }' <<<"$rows" >"$ZPICK_VIEW.pos"
  echo "$rows"
}
# fzf only knows its width once it is up, so the first load (of nothing) asks for the list and
# the second puts the cursor on the pane the picker came from.
onload() {
  if [ -e "$ZPICK_VIEW.pos" ]; then
    echo "pos($(grep . "$ZPICK_VIEW.pos" || echo 1))+unbind(load)"
  else echo "reload($self --list)"; fi
}

# Keep the local invocation intact; only host windows route it through the bounded transport.
on_machine() {
  if [ -n "${ZWS_HOST:-}" ] && [ "${ZPICK_MODE:-}" != zmx ]; then
    [ "$1" != timeout ] || shift 2
    "$here/zhost" "$ZWS_HOST" "$@"
  else
    "$@"
  fi
}

# Preview: the session's screen in colour, cut to the preview height. fzf only understands colour
# codes, so cursor-forward gaps become spaces and other controls are dropped. Full-screen apps
# (alternate screen) keep their top rows with blank runs squeezed, shells their last non-blank rows.
preview() { # name lines
  local raw vt
  raw=$(on_machine timeout 3 zmx history "$1" --vt 2>/dev/null)
  vt=$(LC_ALL=C perl -pe 's/\e\[(\d*)C/" " x ($1||1)/ge; s/\e\[[0-9;?]*[A-Za-ln-z]|\e[()][0-9A-Za-z]|\e\][^\a\e]*(\a|\e\\)|\r//g' <<<"$raw")
  if [[ $raw == *$'\e[?1049h'* ]]; then
    # squeeze blank runs so a mostly-empty app (pi) still shows its bottom rows
    awk '{ b = $0; gsub(/\033\[[0-9;]*m|[[:space:]]/, "", b); if (b == "" && last) next; last = (b == ""); print }' <<<"$vt" | head -n "$2"
  else
    sed -e :a -e '/^\([[:space:]]\|\x1b\[[0-9;]*m\)*$/{$d;N;ba' -e '}' <<<"$vt" | tail -n "$2"
  fi
}
preview_row() { # kind target holder lines
  case $1 in
  closed) grep -o 'cd .*\|holder=[^ ]*' "$2" | sed 's/^holder=/  /' | head -n "$4" ;;
  hdr) ;;
  *) if [ -n "$3" ]; then
    preview "$3" "$4"
  elif [ "$1" = pane ]; then kitten @ get-text --match "id:$2" --ansi | tail -n "$4"; fi ;;
  esac
}
kill_rows() { # file of selected rows: kills the zmx session behind panes and detached sessions,
  # and forgets closed workspaces (their sessions stay, as detached). A session some terminal is
  # attached to is only named in .ask the first time, for the footer, and killed the second.
  local asked
  asked=$(cat "$ZPICK_VIEW.ask" 2>/dev/null)
  : >"$ZPICK_VIEW.ask"
  while IFS=$'\037' read -r kind target holder _ clients _; do # tabs would swallow empty fields
    case $kind in
    pane | det)
      [ -n "$holder" ] || continue
      [ "$kind" = pane ] && [ "$target" = "${ZPICK_FROM:-}" ] && continue
      if [ "$clients" != 0 ] && ! grep -qxF "$holder" <<<"$asked"; then
        echo "$holder" >>"$ZPICK_VIEW.ask"
      else on_machine zmx kill "$holder" >/dev/null 2>&1; fi
      ;;
    closed) case $target in "$DIR"/*.kitty-session) rm -f "$target" ;; esac ;;
    esac
  done < <(tr '\t' '\037' <"$1")
}

case ${1:-} in
--list)
  list
  exit
  ;;
--onload)
  onload
  exit
  ;;
--footer)
  footer
  exit
  ;;
--toggle)
  toggle
  exit
  ;;
--label)
  label
  exit
  ;;
--ghost)
  ghost
  exit
  ;;
--preview)
  preview_row "$2" "$3" "$4" "$5"
  exit
  ;;
--kill)
  kill_rows "$2"
  exit
  ;;
--zmx)
  export ZPICK_MODE=zmx
  shift
  ;;
esac
scratch=$(mktemp -d "${TMPDIR:-/tmp}/zpick.XXXXXXXX") || exit 1
export ZPICK_VIEW=$scratch/view
# Keep the list current: every 2 s, when a session has come, gone, or been attached or detached,
# ask fzf over its socket to reload. Only on a change, because fzf drops keys typed while a
# tracked reload runs (0.75.0).
tick() {
  local last now first=1
  while sleep 2; do
    now=$(on_machine zmx ls 2>/dev/null | cut -f1,3)
    if [ -z "$first" ] && [ "$now" != "$last" ]; then
      curl -s -m 2 --unix-socket "$ZPICK_VIEW.sock" -X POST http://fzf -d "reload($self --list)"
    fi
    last=$now first=
  done
}
tick </dev/null >/dev/null 2>&1 &
ticker=$!
trap 'kill "$ticker" 2>/dev/null; rm -rf -- "$scratch"' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
from=${1:-}
export ZPICK_FROM=$from
ws=$([ "${ZPICK_MODE:-}" = zmx ] || kitten @ ls --match "id:$from" 2>/dev/null | /usr/bin/python3 -c '
import json, sys
try: print(json.load(sys.stdin)[0]["tabs"][0]["windows"][0].get("session_name", ""))
except (ValueError, IndexError, KeyError): pass')

attach() { # name cwd split|tab [plain]: reattach a detached session as a split next to $from or
  # a tab in the picker's workspace. No command: kitty runs its shell (zshell), which reattaches
  # the holder session; a kitty whose shell is not zshell (plain, cmd+alt+enter's) is given it by name.
  local args=(--var "holder=$1") cmd=()
  if [ -z "${ZWS_HOST:-}" ] || [ "${ZPICK_MODE:-}" = zmx ]; then args=(--cwd "$2" "${args[@]}"); fi
  [ "${4:-}" = plain ] && cmd=("$here/zshell")
  [ -n "$ws" ] && args+=(--add-to-session "$ws")
  if [ "$3" = split ] && [ -n "$from" ]; then
    # launch opens in the active tab (the picker) unless --match names the target window's tab.
    kitten @ focus-window --match "id:$from" >/dev/null 2>&1
    kitten @ launch --match "window_id:$from" --location=vsplit "${args[@]}" ${cmd[@]+"${cmd[@]}"} >/dev/null
  else
    kitten @ launch --type=tab "${args[@]}" ${cmd[@]+"${cmd[@]}"} >/dev/null
  fi
}
put() { # name cwd WORKSPACE place window [keep]: reattach into the open WORKSPACE, in whichever OS
  # window holds it, where the pane last was (zpick-rows --route): split next to window, a tab
  # before window's tab, else its last tab. keep: focus stays here, so a tab only goes last, since
  # kitty places a new tab relative to its OS window's active tab.
  local args=(--add-to-session "$3") id=
  if [ -z "${ZWS_HOST:-}" ]; then args+=(--cwd "$2"); fi
  args+=(--var "holder=$1")
  if [ -n "${6:-}" ]; then args+=(--keep-focus); fi
  case $4:${6:-} in
  split:*) id=$(kitten @ launch --match "window_id:$5" --next-to "id:$5" --location=split "${args[@]}") ;;
  before:) kitten @ focus-tab --match "window_id:$5" >/dev/null &&
    id=$(kitten @ launch --type=tab --match "window_id:$5" --location=before "${args[@]}") ;;
  *) false ;;
  esac ||
    # zpick-rows only names workspaces of [a-zA-Z0-9._-], so only the dot needs escaping
    id=$(kitten @ launch --type=tab --match "session:^${3//./\\.}\$" "${args[@]}") || return
  [ -n "${6:-}" ] || [ -z "$id" ] || kitten @ focus-window --match "id:$id" >/dev/null
}
ask() { # question: yes unless n is pressed. The picker's terminal is fds 3 and 4 (see the loop).
  local key=
  read -r -s -n 1 -p "$1 [Y/n] " key <&4 2>&3
  echo >&3
  [ "$key" != n ] && [ "$key" != N ]
}
where() { # session: sets state space place window (zpick-rows --route)
  IFS=$'\t' read -r state space place window < <("$here/zpick-rows" --route "$1" "$from")
}
reattach() { # name cwd key: back to where the session last was
  local state='' space='' place='' window=''
  where "$1"
  case $3:$state in
  ctrl-s:plain) attach "$1" "$2" split plain ;;
  ctrl-s:*) attach "$1" "$2" split ;;
  *:plain) attach "$1" "$2" tab plain ;;
  ctrl-o:other) put "$1" "$2" "$space" "$place" "$window" keep || attach "$1" "$2" tab ;;
  *:other) # its tabs move into this OS window with their panes attached, so nothing redraws
    kitten @ detach-tab --match "session:^${space//./\\.}\$" --target-tab "window_id:$from" >/dev/null
    put "$1" "$2" "$space" "$place" "$window" || attach "$1" "$2" tab
    ;;
  *:here) put "$1" "$2" "$space" "$place" "$window" || attach "$1" "$2" tab ;;
  *:closed)
    if ask "reopen $space?"; then
      kitten @ action goto_session "$DIR/$space.kitty-session"
      where "$1" # its panes have window ids now
      put "$1" "$2" "$space" "$place" "$window" || attach "$1" "$2" tab
    else attach "$1" "$2" tab; fi
    ;;
  *:none)
    if ask "$1 in this workspace? (n: a new one)"; then
      attach "$1" "$2" tab
    else "$here/zws" new --holder "$1" "$2"; fi
    ;;
  *) attach "$1" "$2" tab ;; # zpick-rows gave no answer: where the picker was opened
  esac
}
open_row() { # kind target holder cwd key
  case $1 in
  ws) [ -n "$2" ] && kitten @ action goto_session "$DIR/$2.kitty-session" ;;
  tab) kitten @ focus-tab --match "id:$2" ;;
  pane) kitten @ focus-window --match "id:$2" ;;
  det) reattach "$2" "$4" "$5" ;;
  closed) kitten @ action goto_session "$2" ;;
  esac >/dev/null 2>&1
}

THEME_ACCENT=4 THEME_SEL=8 # the active theme's accent and selection, where the themes are installed
[ -r "$HOME/.config/themes/current/colors.sh" ] && . "$HOME/.config/themes/current/colors.sh"
A=$THEME_ACCENT
keys=(--bind "ctrl-t:execute-silent($self --toggle)+reload($self --list)+transform-border-label($self --label)+transform-ghost($self --ghost)"
  --bind 'zero:change-ghost(nothing here · ctrl-t switches view)')
if [ "${ZPICK_MODE:-}" = zmx ]; then keys+=(--print-query --expect ctrl-n); else keys+=(--expect 'ctrl-s,ctrl-o'); fi
out=$(FZF_DEFAULT_OPTS= SHELL=$(command -v bash) fzf --ansi --multi \
  --delimiter '\t' --with-nth 6 --no-sort --layout reverse \
  --track --id-nth 1,2 --listen "$ZPICK_VIEW.sock" \
  --border rounded --border-label "$(label)" --border-label-pos 3 --padding 1,2 \
  --prompt '/ ' --ghost "$(ghost)" --info inline-right --pointer '▌' --marker '+' --gutter ' ' \
  --input-border line --list-border none \
  --preview "$self --preview {1} {2} {3} \$FZF_PREVIEW_LINES" \
  --preview-window 'right,55%,border-left,nowrap,noinfo' --preview-label ' screen ' \
  --footer "$(footer)" --footer-border line \
  --color "fg:-1,bg:-1,hl:$A,hl+:$A,fg+:-1:bold,bg+:$THEME_SEL,gutter:-1,border:$A,label:$A:bold" \
  --color "prompt:$A,pointer:$A,marker:$A,info:8,ghost:8,footer:8,separator:8,scrollbar:8" \
  --color "input-border:8,preview-border:8,preview-label:8,footer-border:8" \
  --bind "load:transform($self --onload)" \
  --bind "ctrl-x:execute-silent($self --kill {+f})+reload($self --list)+transform-footer($self --footer)" \
  "${keys[@]}" </dev/null)
rc=$?
if [ "${ZPICK_MODE:-}" = zmx ]; then
  [ $rc = 0 ] || [ $rc = 1 ] || exit 1 # 1: no match, the typed name stands
  {
    IFS= read -r query
    IFS= read -r key
    IFS=$'\t' read -r kind target _
  } <<<"$out"
  [ "$key" != ctrl-n ] && [ "${kind:-}" = det ] && query=$target
  [ -z "$query" ] || printf '%s\n' "$query"
  exit 0
fi
[ $rc = 0 ] || exit 0
key=$(head -1 <<<"$out")
# The loop reads the rows on stdin, and open_row discards output, so ask() keeps the terminal.
exec 3>&2 4<&0
while IFS=$'\t' read -r kind target holder cwd _; do
  [ -n "$kind" ] && open_row "$kind" "$target" "$holder" "$cwd" "$key"
done < <(tail -n +2 <<<"$out")
exit 0
