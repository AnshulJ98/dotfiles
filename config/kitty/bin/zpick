#!/usr/bin/env bash
# Go to: full-tab picker over this kitty's workspaces > tabs > panes, then zmx sessions no pane
# holds and closed workspaces (zpick-rows). Runs in a tab opened by zgoto; $1 = id of the window
# the user came from. ctrl-t (or cmd+alt+g, forwarded by zgoto) switches to detached and closed only.
# ctrl-x kills sessions: never the one the picker was opened from, and an attached one only when
# pressed a second time.
set -u
export PATH=/opt/homebrew/bin:$PATH
self=$(realpath "$0"); here=$(dirname "$self")
DIR=${ZWS_DIR:-$HOME/.local/state/kitty/workspaces}

# The view (all | detached) lives in a file so fzf's reload and label commands can read it.
export ZPICK_VIEW=${ZPICK_VIEW:-}
view() { cat "$ZPICK_VIEW" 2>/dev/null || echo all; }
toggle() { local next=all; [ "$(view)" = all ] && next=detached; echo "$next" > "$ZPICK_VIEW"; }
label() { [ "$(view)" = all ] && echo ' Go to ' || echo ' Go to · detached and closed '; }
ghost() { [ "$(view)" = all ] && echo 'search workspaces, tabs and panes' || echo 'search detached sessions'; }
footer() {
  if [ -s "$ZPICK_VIEW.ask" ]; then echo "attached: $(tr '\n' ' ' < "$ZPICK_VIEW.ask")· ^x again kills"
  else echo 'enter go · ^s split · ^t view · tab mark · ^x kill · esc'; fi
}
# fzf runs this for the list. It also notes the row of the pane the picker came from.
list() {
  local rows; rows=$("$here/zpick-rows" "$(view)" "${ZPICK_FROM:-}")
  awk -F'\t' -v w="${ZPICK_FROM:-}" '$1 == "pane" && $2 == w { print NR; exit }' <<<"$rows" > "$ZPICK_VIEW.pos"
  echo "$rows"
}
# fzf only knows its width once it is up, so the first load (of nothing) asks for the list and
# the second puts the cursor on the pane the picker came from.
onload() {
  if [ -e "$ZPICK_VIEW.pos" ]; then echo "pos($(grep . "$ZPICK_VIEW.pos" || echo 1))+unbind(load)"
  else echo "reload($self --list)"; fi
}

# Preview: the session's screen in colour, cut to the preview height. fzf only understands colour
# codes, so cursor-forward gaps become spaces and other controls are dropped. Full-screen apps
# (alternate screen) keep their top rows with blank runs squeezed, shells their last non-blank rows.
preview() { # name lines
  local raw vt; raw=$(timeout 3 zmx history "$1" --vt 2>/dev/null)
  vt=$(LC_ALL=C perl -pe 's/\e\[(\d*)C/" " x ($1||1)/ge; s/\e\[[0-9;?]*[A-Za-ln-z]|\e[()][0-9A-Za-z]|\e\][^\a\e]*(\a|\e\\)|\r//g' <<<"$raw")
  if [[ $raw == *$'\e[?1049h'* ]]; then
    # squeeze blank runs so a mostly-empty app (pi) still shows its bottom rows
    awk '{ b = $0; gsub(/\033\[[0-9;]*m|[[:space:]]/, "", b); if (b == "" && last) next; last = (b == ""); print }' <<<"$vt" | head -n "$2"
  else
    sed -e :a -e '/^\([[:space:]]\|\x1b\[[0-9;]*m\)*$/{$d;N;ba' -e '}' <<<"$vt" | tail -n "$2"
  fi
}
preview_row() { # kind target holder lines
  case $1 in
    closed) grep -o 'cd .*\|holder=[^ ]*' "$2" | sed 's/^holder=/  /' | head -n "$4" ;;
    hdr) ;;
    *) if [ -n "$3" ]; then preview "$3" "$4"
       elif [ "$1" = pane ]; then kitten @ get-text --match "id:$2" --ansi | tail -n "$4"; fi ;;
  esac
}
kill_rows() { # file of selected rows: kills the zmx session behind panes and detached sessions,
  # and forgets closed workspaces (their sessions stay, as detached). A session some terminal is
  # attached to is only named in .ask the first time, for the footer, and killed the second.
  local asked; asked=$(cat "$ZPICK_VIEW.ask" 2>/dev/null); : > "$ZPICK_VIEW.ask"
  while IFS=$'\037' read -r kind target holder _ clients _; do  # tabs would swallow empty fields
    case $kind in
      pane|det)
        [ -n "$holder" ] || continue
        [ "$kind" = pane ] && [ "$target" = "${ZPICK_FROM:-}" ] && continue
        if [ "$clients" != 0 ] && ! grep -qxF "$holder" <<<"$asked"; then echo "$holder" >> "$ZPICK_VIEW.ask"
        else zmx kill "$holder" >/dev/null 2>&1; fi ;;
      closed) case $target in "$DIR"/*.kitty-session) rm -f "$target" ;; esac ;;
    esac
  done < <(tr '\t' '\037' < "$1")
}

case ${1:-} in
  --list) list; exit ;;
  --onload) onload; exit ;;
  --footer) footer; exit ;;
  --toggle) toggle; exit ;;
  --label) label; exit ;;
  --ghost) ghost; exit ;;
  --preview) preview_row "$2" "$3" "$4" "$5"; exit ;;
  --kill) kill_rows "$2"; exit ;;
esac
scratch=$(mktemp -d "${TMPDIR:-/tmp}/zpick.XXXXXXXX") || exit 1
export ZPICK_VIEW=$scratch/view
trap 'rm -rf -- "$scratch"' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
from=${1:-}
export ZPICK_FROM=$from
ws=$(kitten @ ls --match "id:$from" 2>/dev/null | /usr/bin/python3 -c '
import json, sys
try: print(json.load(sys.stdin)[0]["tabs"][0]["windows"][0].get("session_name", ""))
except (ValueError, IndexError, KeyError): pass')

attach() { # name cwd where: reattach a detached session as a tab, or a split next to $from
  # No command: kitty runs its shell (zshell), which reattaches the holder session.
  local args=(--cwd "$2" --var "holder=$1")
  [ -n "$ws" ] && args+=(--add-to-session "$ws")
  if [ "$3" = split ] && [ -n "$from" ]; then
    # launch opens in the active tab (the picker) unless --match names the target window's tab.
    kitten @ focus-window --match "id:$from" >/dev/null 2>&1
    kitten @ launch --match "window_id:$from" --location=vsplit "${args[@]}" >/dev/null
  else
    kitten @ launch --type=tab "${args[@]}" >/dev/null
  fi
}
open_row() { # kind target holder cwd key
  case $1 in
    ws) [ -n "$2" ] && kitten @ action goto_session "$DIR/$2.kitty-session" ;;
    tab) kitten @ focus-tab --match "id:$2" ;;
    pane) kitten @ focus-window --match "id:$2" ;;
    det) attach "$2" "$4" "$([ "$5" = ctrl-s ] && echo split || echo tab)" ;;
    closed) kitten @ action goto_session "$2" ;;
  esac >/dev/null 2>&1
}

. "$HOME/.config/themes/current/colors.sh" # the active theme's accent and selection
A=$THEME_ACCENT
out=$(FZF_DEFAULT_OPTS= SHELL=$(command -v bash) fzf --ansi --multi \
  --delimiter '\t' --with-nth 6 --no-sort --layout reverse \
  --border rounded --border-label "$(label)" --border-label-pos 3 --margin 6%,10% --padding 1,2 \
  --prompt '/ ' --ghost "$(ghost)" --info inline-right --pointer '▌' --marker '+' --gutter ' ' \
  --input-border line --list-border none \
  --preview "$self --preview {1} {2} {3} \$FZF_PREVIEW_LINES" \
  --preview-window 'right,45%,border-left,nowrap,noinfo' --preview-label ' screen ' \
  --footer "$(footer)" --footer-border line \
  --color "fg:-1,bg:-1,hl:$A,hl+:$A,fg+:-1:bold,bg+:$THEME_SEL,gutter:-1,border:$A,label:$A:bold" \
  --color "prompt:$A,pointer:$A,marker:$A,info:8,ghost:8,footer:8,separator:8,scrollbar:8" \
  --color "input-border:8,preview-border:8,preview-label:8,footer-border:8" \
  --bind "load:transform($self --onload)" \
  --bind "ctrl-x:execute-silent($self --kill {+f})+reload($self --list)+transform-footer($self --footer)" \
  --bind "ctrl-t:execute-silent($self --toggle)+reload($self --list)+transform-border-label($self --label)+transform-ghost($self --ghost)" \
  --bind 'zero:change-ghost(nothing here · ctrl-t switches view)' \
  --expect ctrl-s </dev/null) || exit 0
key=$(head -1 <<<"$out")
while IFS=$'\t' read -r kind target holder cwd _; do
  [ -n "$kind" ] && open_row "$kind" "$target" "$holder" "$cwd" "$key"
done < <(tail -n +2 <<<"$out")
exit 0
