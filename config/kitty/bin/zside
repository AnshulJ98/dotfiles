#!/usr/bin/python3
"""Render pushed workspace views: draw first, then refresh git counts asynchronously.

Kitty supplies framed JSON views after the raw-terminal readiness handshake. Folder and
branch discovery read .git files only; row clicks send zdo intents, menus use bin/zws.
"""
from __future__ import annotations  # /usr/bin/python3 is 3.9

import base64
import json
import os
import re
import select
import shutil
import signal
import subprocess
import sys
import termios
import time
import tty

os.environ['PATH'] = '/opt/homebrew/bin:' + os.environ.get('PATH', '')
ZWS = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'zws')
GIT = shutil.which('git')
if GIT in (None, '/usr/bin/git'):
    GIT = next((p for p in ('/Applications/Xcode.app/Contents/Developer/usr/bin/git',
                            '/Library/Developer/CommandLineTools/usr/bin/git')
                if os.path.exists(p)), '/usr/bin/git')
# glyph, SGR colour (terminal palette, so it follows the kitty theme)
ICON = {'': ('·', '39'), 'idle': ('○', '32'), 'working': ('◐', '33'), 'done': ('●', '36'),
        'error': ('✗', '31'), 'blocked': ('◉', '31')}
BAND = '48;5;8;'  # selected row
MENU = (('Rename', 'rename'), ('Close', 'close'), ('New worktree', 'new'), ('Open worktree…', 'open'))
REST_MAX = 1 << 20
INPUT = re.compile(
    rb'\x1b(?:_z([vt])([^\x1b]*)\x1b\\|\[<(\d+);(\d+);(\d+)([Mm])|'
    rb'(?P<rest>(?:_z[vt][^\x1b]*\x1b?|_z?|_|\[(?:<(?:\d+(?:;(?:\d+(?:;\d*)?)?)?)?)?)?)\Z)')


def run(*cmd: str) -> str:
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=3).stdout
    except (OSError, subprocess.SubprocessError):
        return ''


def fit(text: str, width: int) -> str:
    return text if len(text) <= width else text[:max(0, width - 1)] + '…'


def repo(cwd):
    folder = os.path.abspath(cwd) if cwd else ''
    # git's own setting: the search does not climb into these folders
    ceilings = {os.path.abspath(p) for p in os.environ.get('GIT_CEILING_DIRECTORIES', '').split(':') if p}
    for _ in range(40):
        if not folder:
            break
        gitdir = os.path.join(folder, '.git')
        if os.path.isfile(gitdir):
            try:
                with open(gitdir) as f:
                    pointer = f.read().strip()
                gitdir = os.path.join(folder, pointer[8:]) if pointer.startswith('gitdir: ') else ''
            except OSError:
                gitdir = ''
        if os.path.isdir(gitdir):
            try:
                with open(os.path.join(gitdir, 'HEAD')) as f:
                    head = f.read().strip()
                branch = head[len('ref: refs/heads/'):] if head.startswith('ref: refs/heads/') else 'HEAD'
            except OSError:
                branch = ''
            return folder, branch
        parent = os.path.dirname(folder)
        if parent == folder or parent in ceilings:
            break
        folder = parent
    return '', ''


def split_input(data):
    rest, mouse, view, tick = b'', [], None, False
    for match in INPUT.finditer(data):
        kind, body, button, col, row, event, partial = match.groups()
        if partial is not None:
            if len(data) - match.start() <= REST_MAX:
                rest = data[match.start():]
        elif button is not None:
            mouse.append((button, col, row, event))
        elif kind == b't':
            tick = True
        else:
            try:
                obj = json.loads(body)
                if (isinstance(obj, dict) and obj.get('v') == 1
                        and isinstance(obj.get('current'), str)
                        and isinstance(obj.get('spaces'), list) and isinstance(obj.get('agents'), list)):
                    view = obj
            except (ValueError, UnicodeError):
                pass
    return rest, mouse, view, tick


class Git:
    def __init__(self):
        self.cache, self.queue = {}, []
        self.proc = None
        self.top = None

    def request(self, tops, current, now):
        for top in dict.fromkeys(tops):
            if (top and top not in self.queue and top != self.top
                    and now - self.cache.get(top, (-float('inf'), ''))[0] >= (3 if top == current else 30)):
                self.queue.append(top)

    def start(self, now):
        if self.proc or not self.queue:
            return
        self.top = self.queue.pop(0)
        self.started, self.output = now, b''
        try:
            self.proc = subprocess.Popen(
                [GIT, '-C', self.top, 'rev-list', '--left-right', '--count', '@{u}...HEAD'],
                stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                env=dict(os.environ, GIT_OPTIONAL_LOCKS='0'))
            os.set_blocking(self.proc.stdout.fileno(), False)
        except OSError:
            self.cache[self.top] = now, ''
            self.top = None

    def collect(self, ready, now):
        if not self.proc:
            return False
        p = self.proc
        if p.stdout in ready:
            self.output += os.read(p.stdout.fileno(), 65536)
        if now - self.started > 3 and p.poll() is None:
            p.kill()
        code = p.poll()
        if code is None:
            return False
        self.output += p.stdout.read() or b''
        p.stdout.close()
        status = ''
        counts = self.output.split()
        if code == 0 and len(counts) == 2 and all(c.isdigit() for c in counts):
            behind, ahead = (int(c) for c in counts)
            status = ' '.join(x for x in ('↑' + str(ahead) if ahead else '',
                                          '↓' + str(behind) if behind else '') if x)
        changed = status != self.cache.get(self.top, (0, ''))[1]
        self.cache[self.top] = now, status
        self.proc, self.top = None, None
        return changed


def rows(view, info, menu, cols, lines):
    spaces = {s['name']: s for s in view['spaces']}
    agents, current = view['agents'], view['current']

    def line(segs: list[tuple[str, str]], band: bool = False) -> str:
        out, used = [], 0
        bg = BAND if band else ''
        for text, sgr in segs:
            text = text[:max(0, cols - used)]
            used += len(text)
            out.append(f'\x1b[0;{bg}{sgr}m{text}')
        return ''.join(out) + f'\x1b[0;{bg}39m' + ' ' * (cols - used) + '\x1b[0m'

    top: list[tuple[str, tuple | None]] = [(line([(' spaces', '1;97')]), None), (line([]), None)]
    for number, (name, sp) in enumerate(spaces.items(), 1):  # cmd+alt+N goes to space N
        shown, branch, status = info[name]
        glyph, colour = ICON.get(sp['state'], ICON[''])
        on, go = name == current, ('space', name)
        tag = f' {number} '
        indent = len(tag) + 2  # the name's column, after the glyph
        top.append((line([(tag, '39'), (glyph + ' ', colour), (fit(shown, cols - indent - 1), '1;97' if on else '97')], on), go))
        if branch:
            room = cols - indent - 1 - (len(status) + 1 if status else 0)
            segs = [(' ' * indent, ''), (fit(branch, room), '39')]
            for part in status.split():
                segs.append((' ' + part, '32' if part[0] == '↑' else '31'))
            top.append((line(segs, on), go))
        if name == menu:  # the worktree entries need a repo
            for label, what in MENU if branch else MENU[:2]:
                top.append((line([('   ▸ ', '36'), (label, '36')]), ('menu', what, name, sp['cwd'])))

    bottom: list[tuple[str, tuple | None]] = []
    if agents:
        bottom += [(line([('─' * cols, '38;5;8')]), None), (line([(' agents', '1;97')]), None), (line([]), None)]
    for a in agents:  # same rows whichever workspace is shown
        glyph, colour = ICON.get(a['state'], ICON[''])
        go = ('pane', a['pane'], '' if a['space'] == current else a['space'])
        shown, _, _ = info.get(a['space'], (a['space'], '', ''))
        label = fit(f"{a['app']} · {shown} {a['tab']}", cols - 4)
        bottom.append((line([(' ', ''), (glyph + ' ', colour), (label, '1;97' if a['on'] else '97')], a['on']), go))
        if a['model'] or a['ctx']:
            tail = f" · {a['ctx']}" if a['model'] and a['ctx'] else a['ctx']
            bottom.append((line([('   ', ''), (fit(a['model'], cols - 4 - len(tail)) + tail, '39')], a['on']), go))

    bottom = bottom[:max(0, lines - 3)]
    top = top[:max(0, lines - len(bottom))]
    body = top + [(line([]), None)] * (lines - len(top) - len(bottom)) + bottom
    return [text for text, _ in body], [action for _, action in body]


def write(text):
    data = text.encode()
    while data:
        data = data[os.write(sys.stdout.fileno(), data):]


def render(view, git, menu):
    info, tops = {}, {}
    for sp in view['spaces']:
        cwd, name = sp['cwd'], sp['name']
        top, branch = repo(cwd)
        folder = 'home' if cwd == os.path.expanduser('~') else os.path.basename(top or cwd)
        shown = sp['shown'] or (folder if cwd else name)
        info[name] = shown, branch, git.cache.get(top, (0, ''))[1]
        tops[name] = top
    body, clicks = rows(view, info, menu, *shutil.get_terminal_size((24, 40)))
    write('\x1b[?2026h\x1b[H' + '\r\n'.join(body) + '\x1b[?2026l')

    return clicks, tops


def act(action: tuple | None) -> None:
    if action is None:
        return
    kind, arg, *rest = action
    if kind == 'menu':
        name, cwd = rest
        run(ZWS, *{'rename': ('rename', name), 'close': ('close', name)}.get(arg, ('worktree', arg, cwd)))
        return
    words = f'{kind} {arg}'
    encoded = base64.b64encode(words.encode()).decode()
    write(f'\x1b]1337;SetUserVar=zdo={encoded}\x07')


def main() -> None:
    fd = sys.stdin.fileno()
    saved = termios.tcgetattr(fd)
    clicks, menu, buffer, view = [], '', b'', None
    git = Git()
    wake_r, wake_w = os.pipe()
    os.set_blocking(wake_w, False)
    old_wake = signal.set_wakeup_fd(wake_w)
    old_signal = signal.signal(signal.SIGWINCH, lambda *_: None)
    try:
        tty.setraw(fd)
        write('\x1b[?25l\x1b[?7l\x1b[?1000h\x1b[?1006h\x1b[2J'
              '\x1b]1337;SetUserVar=zside=cmVhZHk=\x07')

        while True:
            inputs = [fd, wake_r] + ([git.proc.stdout] if git.proc else [])
            ready, _, _ = select.select(inputs, [], [], .1 if git.proc or git.queue else None)
            draw, refresh = False, False
            if wake_r in ready:
                os.read(wake_r, 4096)
                draw = True
            if fd in ready:
                data = os.read(fd, 65536)
                if not data:
                    return
                buffer, mouse, new_view, tick = split_input(buffer + data)
                if new_view is not None:
                    view = new_view
                draw = refresh = new_view is not None or tick
                for button, _, row, event in mouse:
                    button, row = int(button), int(row) - 1
                    if event != b'M' or button not in (0, 2) or not 0 <= row < len(clicks):
                        continue
                    action = clicks[row]
                    if button == 2:
                        menu = action[1] if action and action[0] == 'space' and action[1] != menu else ''
                    else:
                        menu = ''
                        act(action)
                    draw = True
            draw = git.collect(ready, time.monotonic()) or draw
            if view is not None and draw:
                clicks, tops = render(view, git, menu)
                if refresh:
                    git.request(tops.values(), tops.get(view['current'], ''), time.monotonic())
            git.start(time.monotonic())  # Only queued after a frame has been flushed.
    except (OSError, termios.error):
        pass  # A closed pty can fail both reads and terminal restoration.
    finally:
        if git.proc:
            if git.proc.poll() is None:
                git.proc.kill()
            git.proc.stdout.close()
        signal.set_wakeup_fd(old_wake)
        signal.signal(signal.SIGWINCH, old_signal)
        os.close(wake_r)
        os.close(wake_w)
        try:
            write('\x1b[?1000l\x1b[?1006l\x1b[?7h\x1b[?25h')

            termios.tcsetattr(fd, termios.TCSADRAIN, saved)
        except (OSError, termios.error):
            pass


if __name__ == '__main__':
    main()
