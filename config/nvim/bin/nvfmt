#!/usr/bin/env bash
# usage: nvfmt [--staged] [file...]
#
# Formats and lints files with the nvim config's own tables: conform's formatters
# (lua/config/format.lua, what <leader>f runs) and nvim-lint's linters (lua/config/lint.lua).
# Each formatter finds its config from the file's directory (.prettierrc, stylua.toml,
# pyproject.toml) and falls back to its defaults, so this works outside a repo.
#
#   nvfmt file...    those files
#   nvfmt            in a git repo: the files changed since HEAD and the untracked ones
#   nvfmt --staged   the staged files, restaged after formatting (githooks/pre-commit).
#                    A file that also has unstaged changes is left alone and named.
#
# Left alone: markdown (as format-on-save does), a file whose first 5 lines say GENERATED,
# @generated, "generated by" or "do not edit", a path with the git attribute -nvfmt, a
# symlink, and a file type with no formatter.
#
# Exit 0 clean; 1 lint findings (the files are still formatted); 2 usage error, a formatter
# failed, or the commit has to be run again.
set -u

src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
LUA="$(cd -P "$(dirname "$src")" && pwd)/nvfmt.lua"

die() {
  echo "nvfmt: $*" >&2
  exit 2
}
# A hook's GIT_DIR and GIT_INDEX_FILE are relative to the repo top and point at the commit's
# index, so commands that run elsewhere or outlive the hook start without them.
outside_hook() { env -u GIT_DIR -u GIT_INDEX_FILE -u GIT_WORK_TREE "$@"; }

staged=0
case "${1:-}" in
--staged)
  staged=1
  shift
  [ $# -eq 0 ] || die "--staged takes no files"
  ;;
-h | --help)
  sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'
  exit 0
  ;;
-*) die "unknown option $1 (usage: nvfmt [--staged] [file...])" ;;
esac
command -v nvim >/dev/null 2>&1 || die "nvim not found"

files=()
if [ "$staged" = 1 ]; then
  top="$(git rev-parse --show-toplevel)" || exit 2
  cd "$top" || exit 2
  while IFS= read -r -d '' f; do
    if git diff --quiet -- "$f"; then
      files+=("$top/$f")
    else
      echo "nvfmt: left alone, it has unstaged changes: $f" >&2
    fi
  done < <(git diff --cached --name-only -z --diff-filter=ACMR)
elif [ $# -gt 0 ]; then
  for f in "$@"; do
    case "$f" in /*) files+=("$f") ;; *) files+=("$PWD/$f") ;; esac
  done
else
  top="$(git rev-parse --show-toplevel 2>/dev/null)" || die "not in a git repo, so name the files"
  while IFS= read -r -d '' f; do
    files+=("$top/$f")
  done < <(
    cd "$top" || exit
    if git rev-parse -q --verify HEAD >/dev/null; then
      git diff --name-only -z --diff-filter=ACMR HEAD
      git ls-files -z --others --exclude-standard
    else
      git ls-files -z --cached --others --exclude-standard
    fi
  )
fi

keep=()
for f in ${files[@]+"${files[@]}"}; do
  [ -f "$f" ] && [ ! -L "$f" ] || continue
  case "$(outside_hook git -C "$(dirname "$f")" check-attr nvfmt -- "$(basename "$f")" 2>/dev/null)" in
  *": unset") continue ;;
  esac
  keep+=("$f")
done
[ ${#keep[@]} -gt 0 ] || exit 0

list="$(mktemp "${TMPDIR:-/tmp}/nvfmt.XXXXXX")" || exit 2
trap 'rm -f "$list"' EXIT
printf '%s\n' "${keep[@]}" >"$list"
# The second -c only runs when the Lua died before its own exit.
NVFMT_LUA="$LUA" NVFMT_LIST="$list" outside_hook nvim --headless \
  -c 'lua dofile(vim.env.NVFMT_LUA)' -c 'cquit 2' </dev/null
rc=$?

if [ "$staged" = 1 ] && ! git diff --quiet -- "${keep[@]}"; then
  case "${GIT_INDEX_FILE:-}" in
  */next-index-*)
    # `git commit <paths>` commits from a second index and writes the first one afterwards,
    # so a restage here would leave the unformatted file staged.
    die "formatted the files above; \`git commit <paths>\` cannot take a hook's changes, so run the commit again"
    ;;
  esac
  git add -- "${keep[@]}" || exit 2
fi
exit "$rc"
