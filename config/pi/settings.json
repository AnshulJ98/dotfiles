{
  "lastChangelogVersion": "1.4.0",
  "defaultProvider": "anthropic",
  "defaultModel": "claude-opus-5-5",
  "defaultThinkingLevel": "medium",
  "hideThinkingBlock": false,
  "minimalist": {
    "keepActiveThinkingExpanded": true,
    "excludeTools": ["edit", "write"]
  },
  "showCacheMissNotices": true,
  "cacheWarming": "idle",
  "theme": "bearded-hc-midnightvoid",
  "quietStartup": true,
  "editorPaddingX": 2,
  "enabledModels": [
    "anthropic/claude-opus-5-5",
    "anthropic/claude-sonnet-5-5",
    "anthropic/claude-fable-5-1"
  ],
  "compaction": {
    "enabled": true,
    "reserveTokens": 40000,
    "keepRecentTokens": 16000
  },
  "prompts": ["~/Dev/dotfiles/config/pi/prompts"],
  "skills": ["~/.pi/agent/skills-local"],
  "extensions": [
    "~/Dev/dotfiles/config/pi/extensions/mlx-local.ts",
    "~/Dev/dotfiles/config/pi/extensions/compact-cap.ts",
    "~/Dev/dotfiles/config/pi/extensions/prime-reminder.ts",
    "~/Dev/dotfiles/config/pi/extensions/scout.ts",
    "~/Dev/dotfiles/config/pi/extensions/polish-chrome.ts",
    "~/Dev/dotfiles/config/pi/extensions/context-bar.ts",
    "~/Dev/dotfiles/config/pi/extensions/heads-up.ts",
    "~/Dev/dotfiles/config/pi/extensions/background.ts",
    "~/Dev/dotfiles/config/pi/extensions/stream-watchdog.ts",
    "~/Dev/dotfiles/config/pi/extensions/bedrock-reasoning.ts",
    "~/Dev/dotfiles/config/pi/extensions/split-diff.ts",
    "~/Dev/dotfiles/config/pi/extensions/kitty-links.ts",
    "-builtin:mcp",
    "-builtin:codemode",
    "-builtin:tool-search",
    "-builtin:llama.cpp"
  ],
  "enableSkillCommands": true,
  "packages": [
    "npm:pi-rtk-optimizer",
    "npm:pi-web-access",
    "npm:@upstash/context7-pi",
    "npm:pi-ask-user",
    "npm:pi-usage-widget",
    "npm:@gotgenes/pi-anthropic-auth",
    "npm:pi-minimalist@0.3.1",
    { "source": "npm:pi-tidy@0.4.12", "extensions": [] }
  ]
}
