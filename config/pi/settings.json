{
  "lastChangelogVersion": "0.80.10",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.5",
  "defaultThinkingLevel": "xhigh",
  "hideThinkingBlock": false,
  "showCacheMissNotices": true,
  "theme": "bearded-arc",
  "quietStartup": true,
  "editorPaddingX": 2,
  "enabledModels": [
    "github-copilot/claude-haiku-4.5",
    "github-copilot/gpt-5.4-mini",
    "github-copilot/claude-sonnet-4.6",
    "github-copilot/claude-opus-4.6",
    "github-copilot/claude-opus-4.8",
    "github-copilot/gpt-5.4",
    "anthropic/claude-opus-4-8",
    "anthropic/claude-opus-4-6",
    "openai-codex/gpt-5.5",
    "openai-codex/gpt-5.4-mini"
  ],
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 16000
  },
  "prompts": [
    "~/Dev/dotfiles/config/pi/prompts"
  ],
  "skills": [
    "~/Dev/dotfiles/config/pi/skills"
  ],
  "extensions": [
    "~/Dev/dotfiles/config/pi/extensions/mlx-local.ts",
    "~/Dev/dotfiles/config/pi/extensions/compact-cap.ts",
    "~/Dev/dotfiles/config/pi/extensions/prime-reminder.ts"
  ],
  "subagents": {
    "disableBuiltins": true,
    "parallel": {
      "concurrency": 2
    }
  },
  "enableSkillCommands": true,
  "packages": [
    {
      "source": "npm:@spences10/pi-themes",
      "extensions": []
    },
    {
      "source": "npm:pi-theme-synthwave-84",
      "extensions": []
    },
    {
      "source": "npm:@codella/pi-theme-cyberpunk",
      "extensions": []
    },
    {
      "source": "npm:@codella/pi-theme-candy",
      "extensions": []
    },
    "npm:pi-rtk-optimizer",
    "npm:pi-fetch",
    "npm:@upstash/context7-pi",
    "npm:pi-ask-user",
    "npm:pi-subagents",
    "npm:@taterdoge/pi-ayu",
    "npm:pi-usage-widget",
    "npm:pi-context-prune"
  ]
}