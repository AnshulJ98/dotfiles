{
  "lastChangelogVersion": "0.84.3",
  "defaultProvider": "anthropic",
  "defaultModel": "claude-opus-4-8",
  "defaultThinkingLevel": "low",
  "hideThinkingBlock": false,
  "showCacheMissNotices": true,
  "theme": "bearded-arc",
  "quietStartup": true,
  "editorPaddingX": 2,
  "enabledModels": [
    "anthropic/claude-opus-5",
    "anthropic/claude-sonnet-5",
    "anthropic/claude-fable-5",
    "anthropic/claude-opus-4-8",
    "anthropic/claude-opus-4-6",
    "openai-codex/gpt-5.5",
    "openai-codex/gpt-5.4-mini",
    "opencode-go/kimi-k2.7-code",
    "opencode-go/kimi-k3",
    "opencode-go/glm-5.2",
    "opencode-go/qwen3.7-max",
    "opencode-go/deepseek-v4-pro",
    "opencode-go/deepseek-v4-flash",
    "opencode-go/minimax-m3",
    "opencode-go/grok-4.5"
  ],
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 16000
  },
  "prompts": [
    "~/Dev/dotfiles/config/pi/prompts"
  ],
  "skills": [
    "~/.pi/agent/skills-local"
  ],
  "extensions": [
    "~/Dev/dotfiles/config/pi/extensions/mlx-local.ts",
    "~/Dev/dotfiles/config/pi/extensions/compact-cap.ts",
    "~/Dev/dotfiles/config/pi/extensions/prime-reminder.ts"
  ],
  "subagents": {
    "disableBuiltins": true
  },
  "enableSkillCommands": true,
  "packages": [
