{
  "lastChangelogVersion": "0.85.1",
  "defaultProvider": "anthropic",
  "defaultModel": "claude-fable-5-1",
  "defaultThinkingLevel": "low",
  "hideThinkingBlock": false,
  "showCacheMissNotices": true,
  "theme": "bearded-hc-midnightvoid",
  "quietStartup": true,
  "editorPaddingX": 2,
  "enabledModels": [
    "anthropic/claude-opus-5",
    "anthropic/claude-sonnet-5",
    "anthropic/claude-fable-5-1",
    "anthropic/claude-opus-4-8",
    "anthropic/claude-opus-4-6",
    "openai-codex/gpt-5.5",
    "opencode-go/kimi-k3",
    "opencode-go/glm-5.3",
    "opencode-go/grok-4.6"
  ],
  "compaction": {
    "enabled": true,
    "reserveTokens": 40000,
    "keepRecentTokens": 16000
  },
  "prompts": [
    "~/Dev/dotfiles/config/pi/prompts"
  ],
  "skills": [
    "~/.pi/agent/skills-local"
  ],
  "extensions": [
    "~/Dev/dotfiles/config/pi/extensions/mlx-local.ts",
    "~/Dev/dotfiles/config/pi/extensions/compact-cap.ts",
    "~/Dev/dotfiles/config/pi/extensions/prime-reminder.ts",
    "~/Dev/dotfiles/config/pi/extensions/headless-close.ts"
  ],
  "enableSkillCommands": true,
  "packages": [
    "npm:pi-rtk-optimizer",
    "npm:pi-web-access",
    "npm:@upstash/context7-pi",
    "npm:pi-ask-user",
    "npm:pi-usage-widget",
    "npm:@gotgenes/pi-anthropic-auth"
  ]
}
