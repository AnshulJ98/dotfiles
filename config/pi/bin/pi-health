#!/usr/bin/env node
// What every pi process on this machine is doing, and whether any has stopped moving.
// usage: pi-health [--limit SECS] [--watch [SECS]] [--json]
// --json (without --watch) prints one JSON line of problems, with the same exit codes.
//
// One line per live session, scout and worker (how long in its state, and the open tool calls),
// its bg_run jobs, and each auto run in every repo a pi process has been seen in (<logs>/repos)
// or this shell is in. A line starting with
// "!" is a problem:
//   - a busy process with no tool or agent event for --limit seconds (default 1200, or
//     PI_HEALTH_LIMIT): past every bound the harness puts on one call, so one of them failed
//   - a main session that died without shutting down (plain mode reports it once and removes
//     its file; --json leaves it for other sessions to see, ignoring files from before this boot)
//   - an auto run with open slices that nothing live is carrying
// Exit 1 when there is a problem, else 0. --watch reprints every SECS seconds (default 30) and
// rings the terminal bell on a new problem.
//
// Reads <logs>/live/*.json (lib/live.ts; extensions/bash-changes.ts writes them). A session not
// reloaded since that extension landed has no file and is not listed.
const { execFileSync } = require("node:child_process");
const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");

const HOME = os.homedir();
const MAX_WHAT = 100;
const tilde = (p) => (p === HOME || p.startsWith(HOME + "/") ? "~" + p.slice(HOME.length) : p);
const cut = (text) => (text.length > MAX_WHAT ? text.slice(0, MAX_WHAT) + "\u2026" : text);
const isRunning = (pid) => {
	try {
		process.kill(pid, 0);
		return true;
	} catch (err) {
		return err.code === "EPERM";
	}
};
const git = (cwd, ...args) => {
	try {
		return execFileSync("git", ["-C", cwd, ...args], { encoding: "utf8", stdio: ["ignore", "pipe", "ignore"], timeout: 2000 }).trim();
	} catch {
		return undefined;
	}
};
const commonDir = (cwd) => git(cwd, "rev-parse", "--path-format=absolute", "--git-common-dir");

async function main() {
	const { age, flagFor, knownRepos, readLive, runState, sweep } = await import(path.join(__dirname, "..", "lib", "live.ts"));
	const args = process.argv.slice(2);
	if (args.includes("-h") || args.includes("--help")) {
		const header = fs.readFileSync(__filename, "utf8").split("\n").slice(1);
		console.log(header.slice(0, header.findIndex((line) => !line.startsWith("//"))).map((line) => line.replace(/^\/\/ ?/, "")).join("\n"));
		return 0;
	}
	const number = (flag, fallback) => {
		const value = Number(args[args.indexOf(flag) + 1]);
		return args.includes(flag) && value > 0 ? value : fallback;
	};
	const limitMs = number("--limit", Number(process.env.PI_HEALTH_LIMIT) || 1200) * 1000;
	const json = args.includes("--json") && !args.includes("--watch");
	const head = (p) => `${p.role.padEnd(6)} ${p.session.slice(-6)}  ${tilde(p.cwd)}`;
	// A dead main session's file is removed when it is found, so it is kept here while --watch runs
	const gone = [];

	const report = () => {
		const now = Date.now();
		const bootMs = now - os.uptime() * 1000;
		const dead = sweep(isRunning, bootMs, undefined, !json);
		gone.push(...dead.filter((p) => !json || p.active >= bootMs));
		const live = readLive().filter((p) => !json || !dead.some((d) => d.pid === p.pid));
		const lines = [];
		const problems = [];
		const add = (flag, key, text, source) => {
			lines.push(flag ? `! ${text}  \u00b7 ${flag}` : `  ${text}`);
			if (flag) problems.push({ key, who: typeof source === "string" ? source : `${source.role} ${source.session.slice(-6)} ${tilde(source.cwd)}`, flag, session: typeof source === "string" ? "" : source.session });
		};
		for (const p of gone) {
			const flag = flagFor(p, false, now, limitMs);
			if (flag) add(flag, `gone ${p.pid}`, head(p), p);
		}
		for (const p of live) {
			const childActive = live.some((child) => child.role !== "main" && child.parent === p.session && now - child.active <= limitMs);
			const doing = p.state === "tool" ? p.what : p.state === "model" ? "waiting on the model" : "idle";
			add(flagFor(p, true, now, limitMs, childActive), `quiet ${p.pid}`, `${head(p)}  ${age(now - p.since)}  ${cut(doing)}`, p);
			for (const job of p.jobs ?? []) {
				let quiet = "?";
				try {
					quiet = age(now - fs.statSync(job.log).mtimeMs);
				} catch {
					// The log is gone; the job line still shows.
				}
				lines.push(`      ${job.id}  running ${age(now - job.started)}, last output ${quiet} ago  ${cut(job.command)}`);
			}
		}
		// Auto runs: every worktree with an AUTO.md at its root, in each repo a pi process (or this shell) has been seen in
		const seen = [...live, ...gone].map((p) => commonDir(p.cwd)).filter(Boolean);
		const sessions = live.filter((p) => p.role === "main").map((p) => p.session);
		const children = live.filter((p) => p.role !== "main").map((p) => p.cwd);
		for (const common of new Set([...knownRepos(seen), commonDir(process.cwd())].filter(Boolean))) {
			const trees = (git(common, "worktree", "list", "--porcelain") ?? "").split("\n\n").map((block) => ({
				root: /^worktree (.*)$/m.exec(block)?.[1] ?? "",
				branch: /^branch refs\/heads\/(.*)$/m.exec(block)?.[1] ?? "",
			}));
			const runs = trees.filter((tree) => tree.root && fs.existsSync(path.join(tree.root, "AUTO.md")));
			for (const { root, branch } of runs) {
				// The review runs in the run's own worktree and a worker in a slice's. auto-slice records each slice
				// it starts under pi-auto/<effort>/; with one run in the repo every slice is that run's.
				const started = (slice) => fs.existsSync(path.join(common, "pi-auto", branch.replace(/^auto\//, ""), slice.replace(/^slice\//, "") + ".new"));
				const carried = children.includes(root) || trees.some((tree) => tree.branch.startsWith("slice/") && children.includes(tree.root) && (runs.length === 1 || started(tree.branch)));
				let autoMd;
				try {
					autoMd = fs.readFileSync(path.join(root, "AUTO.md"), "utf8");
				} catch {
					continue;
				}
				const run = runState(autoMd, sessions, carried);
				const state = run.stopped ? "stopped" : run.open ? `${run.open} open, next: ${run.next}` : "every slice ticked";
				add(run.flag, `run ${root}`, `auto   ${tilde(root)}  ${state}`, `auto ${tilde(root)}`);
			}
		}
		if (!lines.length) lines.push("  no pi process has a live-state file");
		return { lines, problems };
	};

	const watch = args.includes("--watch") ? number("--watch", 30) : 0;
	if (!watch) {
		const { lines, problems } = report();
		console.log(args.includes("--json") ? JSON.stringify({ problems }) : lines.join("\n"));
		return problems.length ? 1 : 0;
	}
	let seen = new Set();
	const tick = () => {
		const { lines, problems } = report();
		const bell = problems.some(({ key }) => !seen.has(key)) ? "\x07" : "";
		seen = new Set(problems.map(({ key }) => key));
		process.stdout.write(`\x1b[2J\x1b[H${bell}pi-health ${new Date().toTimeString().slice(0, 8)}, quiet limit ${age(limitMs)}\n${lines.join("\n")}\n`);
	};
	tick();
	setInterval(tick, watch * 1000);
	return undefined;
}

main().then(
	(code) => {
		if (code !== undefined) process.exitCode = code;
	},
	(err) => {
		console.error(`pi-health: ${err.message}`);
		process.exitCode = 2;
	},
);
