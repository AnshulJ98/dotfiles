#!/usr/bin/env bash
# scout — spawn a minimal, isolated child pi to do read-only recon and
# return a short digest. Replaces the pi-subagents package: zero resident
# tool schema in the parent, ~3.5k tokens in the child, one process.
#
# Usage:
#   scout [--brief FILE] [--fork] [--ctx] [--rw] [--model PROVIDER/ID]
#         [--thinking LEVEL] [--timeout SECONDS] "task"
#   scout --rw --spec - ["task"] <<'EOF' ... EOF
#   scout --review BASE ["focus"]
#
#   --brief FILE   Inject FILE as context (the parent writes what the scout
#                  needs to know; this is the normal way to pass context).
#   --spec -       Worker mode with the spec read from stdin, so no spec file
#                  touches the repo. Stored under the run's session dir.
#                  Implies --rw; the task defaults to "Implement the spec.".
#                  Refused (exit 2) when the body has no numbered step or no
#                  check: line: a worker gets a plan, not a title.
#   --review BASE  The one review of a run: prompts/review.md over
#                  BASE...HEAD, read-only, with review.prompt.md, AGENTS.md
#                  (--ctx) and a root AUTO.md as the brief. Needs a clean
#                  tree. On rc 0 it writes <git-common-dir>/pi-review/<HEAD
#                  sha>; config/git/bin/auto-guard refuses to merge an auto/*
#                  branch whose tip has no such record. Thinking high, 900s.
#                  A second and third review of the same base read only the
#                  diff since the round before, with its findings attached;
#                  a fourth is refused (exit 2).
#   --fork         Child starts from a COPY of the parent session. Re-bills
#                  the whole parent context; opt in only when the child must
#                  see the conversation verbatim. Never the default.
#   --ctx          Keep AGENTS.md/CLAUDE.md discovery in the child (default
#                  off; the brief is the intended channel).
#   --rw           Worker mode: edit/write allowed, worker.prompt.md replaces
#                  the scout prompt, and extensions/worker-sensors.ts loads
#                  with PI_WORKER_SPEC set to the brief. Requires --brief
#                  (or --spec -) whose frontmatter has files-allowed; the
#                  sensors enforce it. The WORKER-SENSORS verdict is the first
#                  line of the digest (pi -p sends extension stdout to stderr,
#                  so scout reads it from PI_WORKER_REPORT instead).
#   --model        Default MODEL below (WORKER_MODEL with --rw). On the work
#                  laptop, edit them by hand. Hardcoded on purpose: a
#                  per-machine switch is config for one line.
#   --thinking     low|medium|high|xhigh. Default low; high with --rw.
#                  max is refused: it drifts out of scope.
#   --timeout      Default 300; 900 with --rw. Exit 124 on expiry; with --rw
#                  scout prints the CANNOT-RUN verdict the sensors never got to.
#
# Git guard: bin/guard/git is first on the child's PATH (see its header);
# PI_SCOUT_MODE=read|rw tells it which rules apply. A tripwire, not a sandbox.
#
# Fan-out: at most two scouts live at once, and one open worker per repo
# (.running/<pid>.meta, dead pids ignored). A third is refused with exit 75.
#
# Bash: the child loads extensions/background.ts for its bash tool only: the
# 2-minute default and 10-minute cap, the idle watchdog and $PI_HEARTBEAT.
# bg_run stays off: pi -p exits when the turn ends, which kills the job.
# extensions/bash-changes.ts writes each of the child's bash calls to the
# bash log (~/.pi/agent/logs/bash.log), beside the main session's.
#
# Stall guard: the child loads extensions/stream-watchdog.ts (aborts a silent
# model stream, resumes once). As an outer layer, scout kills a child whose
# session file has not changed for SCOUT_STALE_SECS (600; 900 with --rw or
# xhigh) while no tool call is running, and exits 124.
#
# Herdr: inside a herdr pane (HERDR_PANE_ID set, SCOUT_HERDR not 0) the child
# is an interactive pi in a new herdr tab, so it can be watched and steered.
# extensions/scout-pane.ts writes the digest and exits when the run settles, as
# pi -p would. The tab closes on rc 0 and stays open otherwise. The child's rc
# comes from pane.rc: the extension writes 1 on an error or abort, else it is
# pi's or timeout's. pane.sh holds the environment, so it is 0600 and deleted on
# exit; the pane's process group dies when scout does. If herdr fails, scout
# falls back to pi -p.
#
# Exit codes: 0 ok, 2 usage or recursion refused, 75 fan-out refused,
# 124 timeout or stall, 143 terminated, else pi's. With --rw, verdict.json is written on all of them.
# A SIGKILL skips everything; extensions/scout.ts finishes that run instead.
set -euo pipefail

# Empty arrays (EXT, WORKER, BRIEF) are unbound under set -u before bash 4.4;
# /bin/bash on macOS is 3.2. Homebrew bash (5.x) is the one on PATH at home and at work.
if [ "${BASH_VERSINFO[0]}" -lt 4 ] || { [ "${BASH_VERSINFO[0]}" -eq 4 ] && [ "${BASH_VERSINFO[1]}" -lt 4 ]; }; then
  echo "scout: needs bash 4.4+, running under $BASH_VERSION (brew install bash)" >&2
  exit 2
fi

usage() { sed -n '2,/^set -euo/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; }

if [ "${PI_SCOUT_DEPTH:-0}" != "0" ]; then
  echo "scout: refusing to nest — already inside a scout (PI_SCOUT_DEPTH=$PI_SCOUT_DEPTH)" >&2
  exit 2
fi

DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
PROMPT="$DIR/scout.prompt.md"
SENSORS="$DIR/../extensions/worker-sensors.ts"
UNCONFIRMED="Mark anything you couldn't confirm, and say where you looked."
# Internal: the package's source entry, loaded by path (checked with
# @gotgenes/pi-anthropic-auth 3.4.4; verify.sh [tools] fails when it moves).
SHIM="$HOME/.pi/agent/npm/node_modules/@gotgenes/pi-anthropic-auth/src/index.ts"
# Under the sessions tree so pi-usage-widget (recursive walk) counts scout
# spend in today/all-time; /resume lists only sessions/<cwd>/, so no leak.
# One subdirectory per scout so the extension can attribute cost per run.
SCOUT_ROOT="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}/sessions/scout"
SESSIONS="$SCOUT_ROOT/$$"
RUNNING="$SCOUT_ROOT/.running"
DONE="$SCOUT_ROOT/.done"
MODEL="anthropic/claude-sonnet-5-5"        # work: amazon-bedrock/us.openai.gpt-5.6-luna (the bare openai.* id fails)
WORKER_MODEL="anthropic/claude-sonnet-5-5" # --rw; tested too: github-copilot/kimi-k3
MODEL_SET=0
THINKING=""
TIMEOUT=""
RW=0
TOOLS="read,grep,find,ls,bash"
CTX=(-nc)
BRIEF=()
FORK=()
REVIEW_BASE=""

while [ $# -gt 0 ]; do
  case "$1" in
  --brief)
    [ -r "${2:-}" ] || {
      echo "scout: --brief needs a readable file" >&2
      exit 2
    }
    BRIEF_FILE="$2"
    BRIEF=("@$2")
    shift 2
    ;;
  --spec)
    [ "${2:-}" = "-" ] || {
      echo "scout: --spec takes - (the spec on stdin)" >&2
      exit 2
    }
    # Held outside the sessions tree until it validates, so a refused spec leaves no run folder
    SPEC_TMP="$(mktemp "${TMPDIR:-/tmp}/scout-spec.XXXXXX")"
    trap 'rm -f "$SPEC_TMP"' EXIT
    cat >"$SPEC_TMP"
    BRIEF_FILE="$SPEC_TMP"
    BRIEF=("@$BRIEF_FILE")
    RW=1
    shift 2
    ;;
  --fork)
    FORK=(fork)
    shift
    ;;
  --ctx)
    CTX=()
    shift
    ;;
  --rw)
    RW=1
    shift
    ;;
  --review)
    REVIEW_BASE="${2:?scout: --review needs a base ref}"
    CTX=()
    shift 2
    ;;
  --model)
    MODEL="${2:?scout: --model needs a value}"
    MODEL_SET=1
    shift 2
    ;;
  --thinking)
    case "${2:-}" in
    low | medium | high | xhigh) THINKING="$2" ;;
    *)
      echo "scout: --thinking must be low|medium|high|xhigh, got '${2:-}'" >&2
      exit 2
      ;;
    esac
    shift 2
    ;;
  --timeout)
    TIMEOUT="${2:?scout: --timeout needs a value}"
    shift 2
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  --)
    shift
    break
    ;;
  -*)
    echo "scout: unknown flag $1" >&2
    usage >&2
    exit 2
    ;;
  *) break ;;
  esac
done
if [ -n "$REVIEW_BASE" ]; then
  [ "$RW" = 0 ] || {
    echo "scout: --review is read-only; drop --rw and --spec" >&2
    exit 2
  }
  REVIEW_MD="$DIR/../prompts/review.md"
  [ -r "$REVIEW_MD" ] || {
    echo "scout: review prompt missing: $REVIEW_MD" >&2
    exit 2
  }
  REVIEW_TIP="$(git rev-parse --verify -q HEAD 2>/dev/null)" && git rev-parse --verify -q "$REVIEW_BASE^{commit}" >/dev/null 2>&1 || {
    echo "scout: --review needs a git repo and a base that resolves, got '$REVIEW_BASE'" >&2
    exit 2
  }
  # The record names a commit, so what is reviewed has to be committed
  [ -z "$(git status --porcelain)" ] || {
    echo "scout: --review needs a clean tree; commit first, the record is for HEAD" >&2
    exit 2
  }
  # Rounds. A record with this base for a commit between it and HEAD is an earlier round of this review.
  # Rounds 2 and 3 read only what changed since the round before, with its findings attached; a fourth
  # is refused, so a review that does not converge stops instead of looping.
  REVIEW_DIR="$(git rev-parse --path-format=absolute --git-common-dir)/pi-review"
  REVIEW_BASE_SHA="$(git rev-parse "$REVIEW_BASE^{commit}")"
  REVIEW_ROUND=1
  REVIEW_PREV=""
  for rec in "$REVIEW_DIR"/*; do
    sha="${rec##*/}"
    [ -f "$rec" ] && [ "$sha" != "$REVIEW_TIP" ] && grep -qx "base_sha=$REVIEW_BASE_SHA" "$rec" &&
      git merge-base --is-ancestor "$sha" HEAD 2>/dev/null || continue
    n="$(sed -n 's/^round=//p' "$rec")"
    [ "${n:-1}" -lt "$REVIEW_ROUND" ] || {
      REVIEW_ROUND=$((${n:-1} + 1))
      REVIEW_PREV="$sha"
    }
  done
  [ "$REVIEW_ROUND" -le 3 ] || {
    echo "scout: three review rounds are done on this range (the last at ${REVIEW_PREV:0:9}); a fourth is the user's call. Stop and report the open findings. Starting over means deleting the records in $REVIEW_DIR" >&2
    exit 2
  }
  REVIEW_TARGET="\`git diff $REVIEW_BASE...HEAD\` and \`git log --first-parent $REVIEW_BASE..HEAD\`, every slice of the run at once"
  REVIEW_TOP="$(git rev-parse --show-toplevel)"
  if [ -z "${BRIEF_FILE:-}" ] && [ -f "$REVIEW_TOP/AUTO.md" ]; then
    BRIEF_FILE="$REVIEW_TOP/AUTO.md"
    BRIEF=("@$BRIEF_FILE")
    REVIEW_TARGET="$REVIEW_TARGET, against the spec in the attached AUTO.md"
  fi
  if [ "$REVIEW_ROUND" -gt 1 ]; then
    REVIEW_TARGET="\`git diff $REVIEW_PREV..HEAD\`, the fixes made since round $((REVIEW_ROUND - 1)) of the review of \`$REVIEW_BASE..HEAD\`${BRIEF_FILE:+ (its spec is in the attached AUTO.md)}. This is round $REVIEW_ROUND of 3: judge whether this diff resolves the last round's findings and what it breaks; anything outside this diff is out of scope unless the diff caused it"
    if [ -r "$REVIEW_DIR/$REVIEW_PREV.findings" ]; then
      BRIEF+=("@$REVIEW_DIR/$REVIEW_PREV.findings")
      REVIEW_TARGET="$REVIEW_TARGET. The last round's findings are attached"
    fi
  fi
  REVIEW_BODY="$(awk 'n >= 2; /^---[[:space:]]*$/ { n++ }' "$REVIEW_MD")"
  # Split on the literal $@ instead of ${body/..}: bash 5.2 expands & in a replacement
  set -- "${REVIEW_BODY%%\$@*}$REVIEW_TARGET. For each bug fix in the range, check by reading that its new test fails without the fix. $*${REVIEW_BODY#*\$@}"
  PROMPT="$DIR/review.prompt.md"
fi
if [ $# -lt 1 ]; then
  if [ "$RW" = 1 ] && [ -n "${BRIEF_FILE:-}" ]; then
    set -- "Implement the spec."
  else
    usage >&2
    exit 2
  fi
fi
TASK="$*

$UNCONFIRMED"

# Every git the child runs goes through bin/guard/git (first on PATH): it
# refuses history, stash, remote and tree-switching commands on this repo, and
# in read mode commit and add. PI_SCOUT_REAL_GIT is the git it hands the rest to.
[ -x "$DIR/guard/git" ] || {
  echo "scout: git guard missing or not executable: $DIR/guard/git" >&2
  exit 2
}
# The guard may already be on PATH (tests the sensors run spawn scout); never hand it itself
PI_SCOUT_REAL_GIT="" PI_SCOUT_GIT_DIR=""
while IFS= read -r g; do
  [ "$g" -ef "$DIR/guard/git" ] || { PI_SCOUT_REAL_GIT="$g"; break; }
done < <(type -ap git)
[ -n "$PI_SCOUT_REAL_GIT" ] &&
  PI_SCOUT_GIT_DIR="$("$PI_SCOUT_REAL_GIT" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
if [ "$RW" = 1 ]; then PI_SCOUT_MODE=rw; else PI_SCOUT_MODE=read; fi
export PI_SCOUT_REAL_GIT PI_SCOUT_GIT_DIR PI_SCOUT_MODE
export PATH="$DIR/guard:$PATH"

# Usage errors come before the fan-out cap: verify.sh probes them (`scout --rw x`
# must exit 2) and runs inside workers, where this repo's worker is the open one.
if [ "$RW" = 1 ] && [ -z "${BRIEF_FILE:-}" ]; then
  echo "scout: --rw needs --brief FILE or --spec - (a spec with files-allowed and tests)" >&2
  exit 2
fi

# Fan-out cap, checked before anything lands in the sessions tree. A meta whose
# pid and pane (herdr child) are both dead is a SIGKILLed run the extension has
# not swept yet; it does not count.
meta_field() { sed -n "s/^$2=//p" "$1" | head -n 1; }
LIVE=0 OPEN_WORKER=""
for m in "$RUNNING"/*.meta; do
  [ -f "$m" ] || continue
  m_pane="$(meta_field "$m" pane)"
  kill -0 "$(meta_field "$m" pid)" 2>/dev/null || { [ -n "$m_pane" ] && kill -0 "$m_pane" 2>/dev/null; } || continue
  LIVE=$((LIVE + 1))
  [ "$(meta_field "$m" mode)" = rw ] && [ -n "$PI_SCOUT_GIT_DIR" ] &&
    [ "$(meta_field "$m" repo)" = "$PI_SCOUT_GIT_DIR" ] && OPEN_WORKER="$(meta_field "$m" pid)"
done
if [ "$LIVE" -ge 2 ]; then
  echo "scout: refusing — $LIVE scouts are already live (cap 2); wait for one to finish" >&2
  exit 75
fi
if [ "$RW" = 1 ] && [ -n "$OPEN_WORKER" ]; then
  echo "scout: refusing — worker $OPEN_WORKER is open on this repo; merge or reject it first" >&2
  exit 75
fi
# Claim the slot now, so a scout started during the spec parse below sees this one as live. The
# full meta overwrites it before pi starts; until then any exit removes it (and a spec still held
# in its temp file, which the trap above this point covered).
mkdir -p "$RUNNING"
META="$RUNNING/$$.meta"
printf 'pid=%s\nstarted=%s\nmode=%s\nrepo=%s\n' "$$" "$(($(date +%s) * 1000))" "$PI_SCOUT_MODE" "$PI_SCOUT_GIT_DIR" >"$META"
trap 'rm -f "$META" "${SPEC_TMP:-}"' EXIT

WORKER=()
if [ "$RW" = 1 ]; then
  [ "$MODEL_SET" = 1 ] || MODEL="$WORKER_MODEL"
  [ -r "$SENSORS" ] || {
    echo "scout: sensors missing: $SENSORS" >&2
    exit 2
  }
  # Same parser the sensors use, so a bad spec fails here, not after a wasted run.
  # --no-warnings: stderr is read as the spec error, and a package.json without
  # "type" above this file (~/package.json on the work laptop) makes node warn.
  SPEC_ERROR="$(node --no-warnings --input-type=module -e '
    import { readFileSync } from "node:fs";
    const { parseSpec } = await import(process.argv[1]);
    const parsed = parseSpec(readFileSync(process.argv[2], "utf8"));
    if (typeof parsed === "string") console.log(parsed);' "$SENSORS" "$BRIEF_FILE" 2>&1)" || true
  [ -z "$SPEC_ERROR" ] || {
    [ -n "${SPEC_TMP:-}" ] && BRIEF_FILE="spec on stdin"
    echo "scout: $BRIEF_FILE: $SPEC_ERROR" >&2
    exit 2
  }
  # A spec is a plan, not a title: /plan numbers its steps and gives each a check.
  SPEC_BODY="$(awk 'n >= 2; /^---[[:space:]]*$/ { n++ }' "$BRIEF_FILE")"
  if ! grep -Eq '^[[:space:]]*[0-9]+[.)][[:space:]]' <<<"$SPEC_BODY" || ! grep -q 'check:' <<<"$SPEC_BODY"; then
    [ -n "${SPEC_TMP:-}" ] && BRIEF_FILE="spec on stdin"
    echo "scout: $BRIEF_FILE: no plan in the spec; it needs numbered steps, each with a check: line (run /plan on the slice first)" >&2
    exit 2
  fi
  if [ -n "${SPEC_TMP:-}" ]; then
    mkdir -p "$SESSIONS"
    mv "$SPEC_TMP" "$SESSIONS/spec.md"
    BRIEF_FILE="$SESSIONS/spec.md"
    BRIEF=("@$BRIEF_FILE")
  fi
  # Workers call their tools through codemode scripts, as the main session does
  # (settings.json codemode.mode). -ne drops the built-in extensions, so name it.
  TOOLS="$TOOLS,edit,write,codemode"
  PROMPT="$DIR/worker.prompt.md"
  WORKER=(-e "$SENSORS" -e builtin:codemode)
  export PI_WORKER_SPEC="$(cd "$(dirname "$BRIEF_FILE")" && pwd)/$(basename "$BRIEF_FILE")"
  export PI_WORKER_REPORT="$SESSIONS/verdict.json"
  : "${THINKING:=high}" "${TIMEOUT:=900}"
fi
[ -z "$REVIEW_BASE" ] || : "${THINKING:=high}" "${TIMEOUT:=900}"
: "${THINKING:=low}" "${TIMEOUT:=300}"

[ -r "$PROMPT" ] || {
  echo "scout: prompt file missing: $PROMPT" >&2
  exit 2
}

# The OAuth compatibility shim is installed on some machines only; load it
# when present, otherwise pi's native auth (API key or auth.json) is used.
EXT=()
[ -f "$SHIM" ] && EXT=(-e "$SHIM")
for ext in stream-watchdog bedrock-reasoning background bash-changes; do
  [ -f "$DIR/../extensions/$ext.ts" ] && EXT+=(-e "$DIR/../extensions/$ext.ts")
done
if [ "$RW" = 1 ] || [ "$THINKING" = xhigh ]; then STALE_SECS="${SCOUT_STALE_SECS:-900}"; else STALE_SECS="${SCOUT_STALE_SECS:-600}"; fi

SESSION=()
if [ ${#FORK[@]} -gt 0 ]; then
  [ -r "${PI_SESSION_FILE:-}" ] || {
    echo "scout: --fork needs PI_SESSION_FILE (run from inside a pi session)" >&2
    exit 2
  }
  mkdir -p "$SESSIONS"
  COPY="$SESSIONS/fork.jsonl"
  cp "$PI_SESSION_FILE" "$COPY"
  SESSION=(--session "$COPY")
else
  SESSION=(--session-dir "$SESSIONS")
fi

# Handoff to the scout extension (extensions/scout.ts). While running:
# .running/<pid>.meta (model, effort, start, parent session, task, mode, repo)
# drives the footer status and the fan-out cap above. On exit the digest and meta move to .done/<pid>.*, and the
# extension turns them into a chat entry for the parent session. The EXIT
# trap covers normal exit, timeout (124) and SIGINT/SIGTERM; only SIGKILL
# skips it, which the extension detects by a dead pid.
mkdir -p "$SESSIONS" "$DONE"
OUT="$RUNNING/$$.out"
FIRST_LINE="${TASK%%$'\n'*}"
printf 'pid=%s\nmodel=%s\nthinking=%s\ntimeout=%s\nstarted=%s\nsession=%s\ntask=%s\nmode=%s\nrepo=%s\n' \
  "$$" "$MODEL" "$THINKING" "$TIMEOUT" "$(($(date +%s) * 1000))" "${PI_SESSION_FILE:-}" "${FIRST_LINE:0:80}" \
  "$PI_SCOUT_MODE" "$PI_SCOUT_GIT_DIR" >"$META"
finish() {
  local rc=$?
  mv -f "$OUT" "$DONE/$$.out" 2>/dev/null || : >"$DONE/$$.out"
  {
    cat "$META"
    printf 'rc=%s\nfinished=%s\n' "$rc" "$(($(date +%s) * 1000))"
  } >"$DONE/$$.meta.tmp"
  mv -f "$DONE/$$.meta.tmp" "$DONE/$$.meta"
  rm -f "$META" "$SESSIONS/pane.sh"
}
trap finish EXIT

# stderr is kept so a failed run leaves a reason in the digest instead of
# an empty one. In -p mode pi also sends extension stdout there, so the
# sensors' verdict line lands in this file; the digest gets it from the
# JSON report instead.
ERR="$SESSIONS/stderr.log"
STALLED="$SESSIONS/stalled"
# The run folder is keyed by pid; after a pid wraps, a finished run's verdict and
# stall marker would pass as this run's.
rm -f "$STALLED" "$SESSIONS/verdict.json" "$SESSIONS/pane.pid" "$SESSIONS/pane.rc"

# Outer stall guard: the newest session file is the child's heartbeat. A
# trailing assistant tool call means a tool is running, which may be silent.
watch_stall() {
  local child=$1 start file last age
  start=$(date +%s)
  while sleep "${SCOUT_POLL_SECS:-15}" && kill -0 -- "$child" 2>/dev/null; do
    file=$(ls -t "$SESSIONS"/*.jsonl 2>/dev/null | head -n 1)
    last=$start
    if [ -n "$file" ]; then
      tail -n 1 "$file" | grep -q '"role":"assistant".*"type":"toolCall"' && continue
      last=$(date -r "$file" +%s)
      [ "$last" -gt "$start" ] || last=$start
    fi
    age=$(($(date +%s) - last))
    if [ "$age" -ge "$STALE_SECS" ]; then
      echo "$age" >"$STALLED"
      kill -TERM -- "$child" 2>/dev/null # timeout passes it on to pi
      sleep 10
      pkill -KILL -P "$child" 2>/dev/null
      kill -KILL -- "$child" 2>/dev/null
      return
    fi
  done
}

# The verdict, digest and stderr summary for every exit except SIGKILL. With
# --rw, verdict.json is written here when the sensors did not get to it.
conclude() {
  local rc=$1 reason=""
  [ -n "${MONITOR:-}" ] && kill "$MONITOR" 2>/dev/null
  [ -s "$ERR" ] && grep -v '^WORKER-SENSORS:' "$ERR" >&2
  if [ -s "$STALLED" ]; then
    reason="model stream stalled (no session activity for $(cat "$STALLED")s)"
    echo "scout: $reason" >&2
  elif [ "$rc" -eq 124 ]; then
    reason="scout timed out after ${TIMEOUT}s; settle checks never ran"
    echo "scout: timed out after ${TIMEOUT}s" >&2
  elif [ "$rc" -ne 0 ] && [ ! -s "$OUT" ]; then
    { echo "scout: pi exited $rc with no digest. Last stderr lines:"; tail -n 20 "$ERR"; } >>"$OUT"
  fi
  if [ "$RW" = 1 ]; then
    [ -n "$reason" ] || [ -s "$PI_WORKER_REPORT" ] || reason="no verdict written (pi exited $rc)"
    [ -z "$reason" ] || node -e '
      const report = { verdict: "CANNOT-RUN", reasons: [process.argv[2]], retriesUsed: 0 };
      require("node:fs").writeFileSync(process.argv[1], JSON.stringify(report) + "\n");' "$PI_WORKER_REPORT" "$reason"
    VERDICT="$(node -e '
      const r = JSON.parse(require("node:fs").readFileSync(process.argv[1], "utf8"));
      console.log(`WORKER-SENSORS: ${r.verdict}${r.reasons.length ? " " + r.reasons.join("; ") : ""}`);' "$PI_WORKER_REPORT")"
    # The sensors' own verdict line can land in the digest too (a non -p pi, or
    # the model quoting it); the one from the report is the only one kept.
    { echo "$VERDICT"; echo; grep -v '^WORKER-SENSORS:' "$OUT" || true; } >"$OUT.tmp" && mv -f "$OUT.tmp" "$OUT"
  fi
  if [ -f "$OUT" ]; then cat "$OUT"; fi
  # Where the run's files are, what it cost, and whether a worker left something under Blocked on me: a PASS
  # with a refused step is not a finished slice. On stderr, so stdout stays the digest; bin/auto-slice reads it.
  node -e '
    const fs = require("node:fs");
    const [dir, out, rw] = process.argv.slice(1);
    let cost = 0;
    for (const name of fs.existsSync(dir) ? fs.readdirSync(dir) : []) {
      if (!name.endsWith(".jsonl")) continue;
      for (const line of fs.readFileSync(dir + "/" + name, "utf8").split("\n")) {
        try { cost += JSON.parse(line).message?.usage?.cost?.total ?? 0; } catch {}
      }
    }
    const lines = (fs.existsSync(out) ? fs.readFileSync(out, "utf8") : "").split("\n");
    const at = lines.findIndex((line) => /^\W*Blocked on me\b/i.test(line));
    let body = at < 0 ? "" : lines[at].replace(/^\W*Blocked on me\W*/i, "");
    for (let i = at + 1; at >= 0 && i < lines.length && !/^\W*\*\*[A-Z]|^#+ /.test(lines[i]); i++) body += " " + lines[i];
    const blocked = !/^[\s*.:-]*($|nothing\b|none\b|n\/a)/i.test(body);
    console.error("scout: dir=" + dir + " cost=$" + cost.toFixed(3) + (rw === "1" ? " blocked-on-me=" + (blocked ? "yes" : "no") : ""));
  ' "$SESSIONS" "$OUT" "$RW" || true
}

on_signal() {
  trap - TERM INT HUP
  kill -TERM -- "$TARGET" 2>/dev/null
  wait "$CHILD" 2>/dev/null # returns at once for a pane child, which is not ours
  conclude 143 || true
  exit 143
}

PI_OPTS=(-ne "${EXT[@]}" "${WORKER[@]}" "${CTX[@]}" -ns -np -t "$TOOLS" "${SESSION[@]}"
  --model "$MODEL" --thinking "$THINKING" --system-prompt "$(cat "$PROMPT")")
if [ "$RW" = 1 ]; then KIND=worker; else KIND=scout; fi
PANE="" TAB=""

# Sets PANE, TAB and CHILD (the pane job's pid, which leads its process group:
# bash, timeout and pi). The tab goes in the caller's workspace when the caller's
# pane sits in this worktree; otherwise in the workspace herdr has open for the
# worktree, else the caller's. (worktree list names one workspace per worktree,
# so with two workspaces on one repo it would send every tab to the first.)
herdr_launch() {
  [ -n "${HERDR_PANE_ID:-}" ] && [ "${SCOUT_HERDR:-1}" != 0 ] && command -v herdr >/dev/null || return 1
  local ws="" top caller json n script="$SESSIONS/pane.sh" trust
  top="$("$PI_SCOUT_REAL_GIT" rev-parse --show-toplevel 2>/dev/null)" || top=""
  if [ -n "$top" ]; then
    caller="$(herdr pane list 2>/dev/null | node -e '
      let s = "";
      process.stdin.on("data", (d) => (s += d)).on("end", () => {
        const p = JSON.parse(s || "{}").result?.panes?.find((p) => p.pane_id === process.argv[1]);
        if (p?.cwd) console.log(p.cwd);
      });' "$HERDR_PANE_ID" 2>/dev/null)" || caller=""
    if [ -n "$caller" ] && [ "$("$PI_SCOUT_REAL_GIT" -C "$caller" rev-parse --show-toplevel 2>/dev/null)" = "$top" ]; then
      ws="$HERDR_WORKSPACE_ID"
    fi
  fi
  [ -n "$ws" ] || [ -z "$top" ] ||
    ws="$(herdr worktree list --cwd "$top" 2>/dev/null | node -e '
      let s = "";
      process.stdin.on("data", (d) => (s += d)).on("end", () => {
        const w = JSON.parse(s || "{}").result?.worktrees?.find((w) => w.path === process.argv[1]);
        if (w?.open_workspace_id) console.log(w.open_workspace_id);
      });' "$top" 2>/dev/null)"
  json="$(herdr tab create --workspace "${ws:-$HERDR_WORKSPACE_ID}" --cwd "$PWD" --label "$KIND $$" --no-focus)" || return 1
  read -r TAB PANE < <(node -e 'const r = JSON.parse(process.argv[1]).result; console.log(r.tab.tab_id, r.root_pane.pane_id)' "$json") || return 1
  # A TUI pi blocks on its trust prompt in a folder it was not told to trust; -p
  # proceeds untrusted. Decide it the way -p does: not under a trusted path -> -na.
  trust="$(node -e '
    try {
      const t = JSON.parse(require("node:fs").readFileSync(process.argv[2], "utf8"));
      const cwd = process.argv[1];
      if (Object.entries(t).some(([k, v]) => v === true && (cwd === k || cwd.startsWith(k + "/")))) process.exit(0);
    } catch {}
    console.log("-na")' "$PWD" "${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}/trust.json" 2>/dev/null)" || trust="-na"
  # The pane's shell is the user's own: hand pi this scout's environment, minus
  # the herdr and terminal identity, which must stay the new pane's. The script
  # holds tokens, so it is 0600; the pane's herdr socket is dropped so the child
  # cannot drive the session.
  (umask 077
  {
    printf 'unset HERDR_SOCKET_PATH HERDR_ENV\n'
    printf 'echo $$ >%q\n' "$SESSIONS/pane.pid"
    # The pane group dies with scout, SIGKILL included, which skips scout's trap.
    printf '( while kill -0 %s 2>/dev/null && kill -0 $$ 2>/dev/null; do sleep 2; done\n' "$$"
    printf '  kill -0 %s 2>/dev/null || { kill -TERM -- -$$ 2>/dev/null || pkill -TERM -P $$ 2>/dev/null; } ) &\n' "$$"
    for n in $(compgen -e); do
      case "$n" in HERDR_* | TERM | TERM_PROGRAM* | COLORTERM | KITTY_* | PWD | OLDPWD | SHLVL | SHELLOPTS | BASHOPTS | _) continue ;; esac
      printf 'export %s=%q\n' "$n" "${!n}"
    done
    printf 'export PI_SCOUT_DEPTH=1 SCOUT_DIGEST=%q SCOUT_PANE_RC=%q\ncd %q || exit 2\n' "$OUT" "$SESSIONS/pane.rc" "$PWD"
    printf 'timeout --foreground %q pi' "$TIMEOUT"
    printf ' %q' "${PI_OPTS[@]}" ${trust:+"$trust"} -e "$DIR/../extensions/scout-pane.ts" "${BRIEF[@]}" "$TASK"
    printf ' 2>%q\nrc=$?; [ -s %q ] || echo $rc >%q\n' "$ERR" "$SESSIONS/pane.rc" "$SESSIONS/pane.rc"
  } >"$script")
  herdr pane run "$PANE" "bash $(printf %q "$script")" >/dev/null || {
    herdr tab close "$TAB" >/dev/null 2>&1
    return 1
  }
  for n in $(seq 30); do [ -s "$SESSIONS/pane.pid" ] && break; sleep 1; done
  CHILD="$(cat "$SESSIONS/pane.pid" 2>/dev/null)"
  [ -n "$CHILD" ] || {
    herdr tab close "$TAB" >/dev/null 2>&1
    return 1
  }
}

set +e
if herdr_launch; then
  TARGET="-$CHILD"
  printf 'pane=%s\n' "$CHILD" >>"$META"
else
  PANE=""
  # pi writes to a file, not through tee: a reader that quits early (| head) used
  # to break the pipe and kill the worker with EPIPE mid-run.
  # --foreground keeps pi in scout's process group: when the parent's bash tool
  # kills that group, pi dies with it instead of running on, unseen, until its
  # own timeout.
  PI_SCOUT_DEPTH=1 timeout --foreground "$TIMEOUT" pi -p "${PI_OPTS[@]}" \
    "${BRIEF[@]}" "$TASK" 2>"$ERR" >"$OUT" </dev/null &
  CHILD=$!
  TARGET=$CHILD
fi
# Detached from stdout: its pending sleep must not hold the caller's pipe open
watch_stall "$TARGET" >/dev/null 2>&1 &
MONITOR=$!
# Set after the launch so the child keeps the default SIGPIPE; scout's own
# late writes to a closed reader then fail instead of skipping the EXIT trap.
trap '' PIPE
trap on_signal TERM INT HUP
if [ -n "$PANE" ]; then
  NAMED=""
  while [ ! -s "$SESSIONS/pane.rc" ] && kill -0 "$CHILD" 2>/dev/null; do
    if [ -z "$NAMED" ] && herdr agent rename "$PANE" "$KIND-$$" >/dev/null 2>&1; then NAMED=1; fi
    sleep 1
  done
  rc="$(cat "$SESSIONS/pane.rc" 2>/dev/null)" || rc=143 # the pane job died before writing it
  [ "$rc" = 0 ] && herdr tab close "$TAB" >/dev/null 2>&1
else
  wait "$CHILD"
  rc=$?
fi
[ -s "$STALLED" ] && rc=124
conclude "$rc"
if [ -n "$REVIEW_BASE" ] && [ "$rc" = 0 ] && [ -s "$OUT" ]; then
  if [ "$("$PI_SCOUT_REAL_GIT" rev-parse HEAD 2>/dev/null)" = "$REVIEW_TIP" ]; then
    mkdir -p "$REVIEW_DIR"
    printf 'base=%s\nbase_sha=%s\nround=%s\nreviewed=%s\nrun=%s\n' "$REVIEW_BASE" "$REVIEW_BASE_SHA" "$REVIEW_ROUND" "$(date -u +%FT%TZ)" "$SESSIONS" >"$REVIEW_DIR/$REVIEW_TIP"
    cp "$OUT" "$REVIEW_DIR/$REVIEW_TIP.findings"
    echo "scout: review round $REVIEW_ROUND recorded for ${REVIEW_TIP:0:9}" >&2
  else
    echo "scout: HEAD moved during the review; nothing recorded" >&2
  fi
fi
exit $rc
