@@ -0,0 +1,49 @@
+// Run: node --test 'config/pi/tests/*.test.ts'
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import compactCap from "../extensions/compact-cap.ts";
+
+type Handler = (event: unknown, ctx: unknown) => Promise<void>;
+
+/** Loads compact-cap against a fake pi; settle(tokens) fires agent_settled at that usage and returns the notices. */
+function load(): { settle(tokens: number | null): string[]; compacted: () => number } {
+	const handlers = new Map<string, Handler>();
+	let compactions = 0;
+	const pi = {
+		on: (name: string, handler: Handler) => handlers.set(name, handler),
+		registerCommand: () => undefined,
+	};
+	compactCap(pi as never);
+	return {
+		settle(tokens) {
+			const notices: string[] = [];
+			const ctx = {
+				getContextUsage: () => ({ tokens }),
+				compact: () => (compactions += 1),
+				ui: { notify: (message: string) => notices.push(message) },
+			};
+			void handlers.get("agent_settled")?.({}, ctx);
+			return notices;
+		},
+		compacted: () => compactions,
+	};
+}
+
+test("past the cap: one /handoff notice per crossing, no compaction", () => {
+	const cap = load();
+	assert.deepEqual(cap.settle(100_000), []);
+	const first = cap.settle(220_000);
+	assert.equal(first.length, 1);
+	assert.match(first[0], /220,000 tokens, past the 210,000 cap\. Run \/handoff and start a fresh session\./);
+	assert.deepEqual(cap.settle(230_000), [], "no repeat while still over");
+	assert.deepEqual(cap.settle(null), [], "null usage right after a compaction is ignored");
+	assert.deepEqual(cap.settle(50_000), []);
+	assert.equal(cap.settle(215_000).length, 1, "re-armed after dropping below");
+	assert.equal(cap.compacted(), 0);
+});
+
+test("compact-cap no longer listens on turn_end, so a running task is never interrupted", () => {
+	const names: string[] = [];
+	compactCap({ on: (name: string) => names.push(name), registerCommand: () => undefined } as never);
+	assert.deepEqual(names, ["agent_settled"]);
+});
