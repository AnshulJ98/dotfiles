+/**
+ * slice-check CLI, run through bin/slice-check. Gathers the facts from git and the test command, then
+ * prints `SLICE-CHECK: PASS` or `SLICE-CHECK: FAIL <reasons>` as the last line.
+ * Exit 0 pass, 1 fail, 2 usage or not a git repo.
+ */
+import { execFileSync, spawnSync } from "node:child_process";
+import { existsSync, readFileSync } from "node:fs";
+import { resolve } from "node:path";
+import { parseArgs } from "node:util";
+import { sliceFailures, TEST_FILE, type TestFileChange } from "./slice-check.ts";
+
+const USAGE = `usage: slice-check [--base REF] [--files GLOB,GLOB...] -- 'CHECK && CHECK ...'
+  --base   ref the slice started from (default HEAD); the working tree is compared with it
+  --files  the card's files; a changed file outside them fails
+  CHECK    the done-when checks, joined into one line and run by sh -c; a non-zero exit fails`;
+
+function git(root: string, args: string[]): string {
+  return execFileSync("git", args, { cwd: root, encoding: "utf8", stdio: ["ignore", "pipe", "pipe"] });
+}
+
+function atBase(root: string, base: string, file: string): string | undefined {
+  try {
+    return git(root, ["show", `${base}:${file}`]);
+  } catch {
+    return undefined; // not in the base: a new file
+  }
+}
+
+function main(argv: string[]): number {
+  const split = argv.indexOf("--");
+  const command = split === -1 ? [] : argv.slice(split + 1);
+  let values: { base?: string; files?: string; help?: boolean };
+  try {
+    ({ values } = parseArgs({
+      args: split === -1 ? argv : argv.slice(0, split),
+      options: { base: { type: "string" }, files: { type: "string" }, help: { type: "boolean", short: "h" } },
+    }));
+  } catch (error) {
+    console.error(`slice-check: ${error instanceof Error ? error.message : String(error)}\n${USAGE}`);
+    return 2;
+  }
+  if (values.help) {
+    console.log(USAGE);
+    return 0;
+  }
+  if (command.length === 0) {
+    console.error(`slice-check: no command after --\n${USAGE}`);
+    return 2;
+  }
+  let root: string;
+  try {
+    root = git(process.cwd(), ["rev-parse", "--show-toplevel"]).trim();
+  } catch {
+    console.error("slice-check: not inside a git work tree");
+    return 2;
+  }
+  const base = values.base ?? "HEAD";
+  try {
+    git(root, ["rev-parse", "--verify", "--quiet", `${base}^{commit}`]);
+  } catch {
+    console.error(`slice-check: --base ${base} is not a commit`);
+    return 2;
+  }
+
+  // One shell line, so a card's checks joined with && run as written.
+  const run = spawnSync("sh", ["-c", command.join(" ")], { stdio: "inherit" });
+  const exitCode = run.error ? 127 : run.status;
+
+  const tracked = git(root, ["diff", "--name-only", "--no-renames", base]).split("\n").filter(Boolean);
+  const untracked = git(root, ["ls-files", "--others", "--exclude-standard"]).split("\n").filter(Boolean);
+  const changed = [...new Set([...tracked, ...untracked])].sort();
+  const testFiles: TestFileChange[] = changed
+    .filter((file) => TEST_FILE.test(file))
+    .map((file) => {
+      const path = resolve(root, file);
+      return { file, before: atBase(root, base, file), after: existsSync(path) ? readFileSync(path, "utf8") : undefined };
+    });
+  const allowed = values.files?.split(",").map((glob) => glob.trim()).filter(Boolean);
+
+  const reasons = sliceFailures({ changed, allowed, testFiles, command: command.join(" "), exitCode });
+  console.log(reasons.length ? `SLICE-CHECK: FAIL ${reasons.join("; ")}` : `SLICE-CHECK: PASS (${changed.length} files changed since ${base})`);
+  return reasons.length ? 1 : 0;
+}
+
+process.exitCode = main(process.argv.slice(2));
