new file mode 100644
index 0000000..7984de7
--- /dev/null
+++ b/config/pi/tests/slice-check.test.ts
@@ -0,0 +1,98 @@
+// Run: node --test 'config/pi/tests/*.test.ts'
+import assert from "node:assert/strict";
+import { execFileSync, spawnSync } from "node:child_process";
+import { mkdtempSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { dirname, join, resolve } from "node:path";
+import { test } from "node:test";
+import { fileURLToPath } from "node:url";
+import { isAllowed, sliceFailures, testWeakening } from "../lib/slice-check.ts";
+
+const SLICE_CHECK = resolve(dirname(fileURLToPath(import.meta.url)), "../bin/slice-check");
+
+const ALLOWED: Array<[string, string[], boolean]> = [
+	["src/a.ts", ["src/**"], true],
+	["src/deep/b.ts", ["src/**"], true],
+	["test/a.ts", ["src/**"], false],
+	["README.md", ["README.md"], true],
+	["./README.md", ["README.md"], true],
+	["../outside.ts", ["**"], false],
+	["/etc/passwd", ["**"], false],
+	["", ["**"], false],
+];
+for (const [path, globs, want] of ALLOWED) {
+	test(`isAllowed: '${path}' in ${globs.join(",")}`, () => assert.equal(isAllowed(path, globs), want));
+}
+
+const WEAKENED: Array<[string, string | undefined, string | undefined, boolean]> = [
+	["test added", "test('a', () => {})", "test('a', () => {})\ntest('b', () => {})", false],
+	["test removed", "test('a', () => {})\ntest('b', () => {})", "test('a', () => {})", true],
+	["assertion removed", "test('a', () => { assert.ok(x); assert.ok(y) })", "test('a', () => { assert.ok(x) })", true],
+	["skip added", "test('a', () => {})", "test.skip('a', () => {})", true],
+	["only added", "it('a', () => {})", "it.only('a', () => {})", true],
+	["new test file", undefined, "test('a', () => {})", false],
+	["new test file with a skip marker", undefined, "test.skip('a', () => {})", false],
+	["test file deleted", "test('a', () => {})", undefined, true],
+	["python test removed", "def test_a():\n    assert x\ndef test_b():\n    assert y", "def test_a():\n    assert x", true],
+	["pytest skip added", "def test_a():\n    assert x", "@pytest.mark.skip\ndef test_a():\n    assert x", true],
+];
+for (const [name, before, after, weakened] of WEAKENED) {
+	test(`testWeakening: ${name}`, () => assert.equal(testWeakening(before, after) !== undefined, weakened));
+}
+
+test("sliceFailures: a red command, a file outside the card and a weakened test each give a reason", () => {
+	const reasons = sliceFailures({
+		changed: ["src/a.ts", "src/a.test.ts", "README.md"],
+		allowed: ["src/**"],
+		testFiles: [{ file: "src/a.test.ts", before: "test('a', () => {})\ntest('b', () => {})", after: "test('a', () => {})" }],
+		command: "npm test",
+		exitCode: 1,
+	});
+	assert.deepEqual(reasons, [
+		"`npm test` exited 1",
+		"files outside the card: README.md",
+		"src/a.test.ts: test cases or assertions dropped from 2 to 1",
+	]);
+});
+
+test("sliceFailures: no --files skips the scope check", () => {
+	assert.deepEqual(sliceFailures({ changed: ["anything.md"], allowed: undefined, testFiles: [], command: "true", exitCode: 0 }), []);
+});
+
+function repo(): string {
+	const dir = mkdtempSync(join(tmpdir(), "slice-check-"));
+	const git = (...args: string[]) => execFileSync("git", ["-c", "user.name=t", "-c", "user.email=t@t", ...args], { cwd: dir, stdio: "ignore" });
+	git("init", "-q");
+	writeFileSync(join(dir, "a.test.ts"), "test('a', () => {})\ntest('b', () => {})\n");
+	writeFileSync(join(dir, "a.ts"), "export const a = 1;\n");
+	git("add", ".");
+	git("commit", "-qm", "base");
+	return dir;
+}
+
+function run(dir: string, args: string[]): { code: number | null; last: string } {
+	const r = spawnSync(SLICE_CHECK, args, { cwd: dir, encoding: "utf8" });
+	return { code: r.status, last: r.stdout.trim().split("\n").at(-1) ?? "" };
+}
+
+test("slice-check CLI: an in-card change with green tests passes", () => {
+	const dir = repo();
+	writeFileSync(join(dir, "a.ts"), "export const a = 2;\n");
+	assert.deepEqual(run(dir, ["--files", "a.ts,a.test.ts", "--", "true"]), { code: 0, last: "SLICE-CHECK: PASS (1 files changed since HEAD)" });
+});
+
+test("slice-check CLI: a new file outside the card and a dropped test fail", () => {
+	const dir = repo();
+	writeFileSync(join(dir, "b.ts"), "x\n");
+	writeFileSync(join(dir, "a.test.ts"), "test('a', () => {})\n");
+	const r = run(dir, ["--files", "a.ts,a.test.ts", "--", "true"]);
+	assert.equal(r.code, 1);
+	assert.equal(r.last, "SLICE-CHECK: FAIL files outside the card: b.ts; a.test.ts: test cases or assertions dropped from 2 to 1");
+});
+
+test("slice-check CLI: a red command fails; no command is a usage error", () => {
+	const dir = repo();
+	assert.equal(run(dir, ["--", "false"]).code, 1);
+	assert.equal(run(dir, []).code, 2);
