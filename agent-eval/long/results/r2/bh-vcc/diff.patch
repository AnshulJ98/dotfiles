diff --git a/config/pi/tests/slice-check.test.ts b/config/pi/tests/slice-check.test.ts
new file mode 100644
index 0000000..7af0ee4
--- /dev/null
+++ b/config/pi/tests/slice-check.test.ts
@@ -0,0 +1,171 @@
+// Run: node --test config/pi/tests/
+import assert from "node:assert/strict";
+import { spawnSync } from "node:child_process";
+import { mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { test } from "node:test";
+import { isAllowed, isTestFile, parseCard, sliceFailures, testWeakening } from "../lib/slice-check.ts";
+
+const CARD = `outcome: callers get [] for an empty cart
+done-when:
+  - npm test -- cart
+  - npx tsc --noEmit
+interface: unchanged
+mechanism: cart.total returns [] early
+files: [src/cart.ts, tests/{cart,util}.test.ts]
+out: pricing`;
+
+test("parseCard reads block and flow lists and ignores the fields for people", () => {
+	assert.deepEqual(parseCard(CARD), {
+		doneWhen: ["npm test -- cart", "npx tsc --noEmit"],
+		files: ["src/cart.ts", "tests/{cart,util}.test.ts"],
+	});
+	assert.deepEqual(parseCard("```\ndone-when: make check\nfiles: src/**\n```"), { doneWhen: ["make check"], files: ["src/**"] });
+});
+
+test("parseCard keeps commas inside quotes and accepts unindented list items", () => {
+	const rows: Array<[string, string[]]> = [
+		[`done-when: ["jq '.a, .b' x.json", 'node -e "f(1, 2)"']\nfiles: [x]`, ["jq '.a, .b' x.json", 'node -e "f(1, 2)"']],
+		["done-when: [\"a, b\", c]\nfiles: [x]", ["a, b", "c"]],
+		["done-when:\n- make a\n- make b\nfiles: [x]", ["make a", "make b"]],
+	];
+	for (const [text, doneWhen] of rows) assert.deepEqual(parseCard(text), { doneWhen, files: ["x"] }, text);
+});
+
+test("parseCard rejects a card it cannot enforce", () => {
+	const rows: Array<[string, RegExp]> = [
+		["files: [a.ts]", /needs done-when/],
+		["done-when: make\nfiles:", /needs files/],
+		["done-when: [a, b, c, d, e, f]\nfiles: [x]", /6 done-when checks/],
+	];
+	for (const [text, error] of rows) {
+		const got = parseCard(text);
+		assert.equal(typeof got, "string", text);
+		assert.match(got as string, error);
+	}
+});
+
+test("isAllowed matches globs and refuses paths that leave the repo", () => {
+	const rows: Array<[string, boolean]> = [
+		["src/cart.ts", true],
+		["src/deep/x.ts", true],
+		["src/../secrets", false],
+		["../outside.ts", false],
+		["/abs/src/cart.ts", false],
+		["", false],
+		["src/.env", false], // ** skips dotfiles
+	];
+	for (const [path, want] of rows) assert.equal(isAllowed(path, ["src/**"]), want, path);
+});
+
+test("isTestFile knows TypeScript and Python test names", () => {
+	const rows: Array<[string, boolean]> = [
+		["a/cart.test.ts", true],
+		["a/cart.spec.mjs", true],
+		["a/__tests__/cart.ts", true],
+		["tests/test_cart.py", true],
+		["cart_test.py", true],
+		["src/cart.ts", false],
+		["src/testing.py", false],
+	];
+	for (const [path, want] of rows) assert.equal(isTestFile(path), want, path);
+});
+
+test("testWeakening flags dropped cases and new skips, not added tests", () => {
+	const two = 'test("a", () => {});\ntest("b", () => {});';
+	const rows: Array<[string | undefined, string | undefined, RegExp | undefined]> = [
+		[two, 'test("a", () => {});', /dropped from 2 to 1/],
+		[two, undefined, /dropped from 2 to 0/],
+		[two, 'test.skip("a", () => {});\ntest("b", () => {});', /skip\/only/],
+		["def test_a():\n    assert f() == 1", "def test_a():\n    pass", /dropped from 2 to 1/],
+		["def test_a():\n    assert f()", "@pytest.mark.skip\ndef test_a():\n    assert f()", /skip\/only/],
+		[two, two + '\ntest("c", () => {});', undefined],
+		[undefined, two, undefined],
+	];
+	for (const [before, after, want] of rows) {
+		const got = testWeakening(before, after);
+		if (want) assert.match(got ?? "", want);
+		else assert.equal(got, undefined);
+	}
+});
+
+test("sliceFailures names every reason, and nothing when the slice is done", () => {
+	const card = { doneWhen: ["make"], files: ["src/**"] };
+	assert.deepEqual(sliceFailures({ card, runs: [{ command: "make", exitCode: 0, timedOut: false }], changed: ["src/a.ts"], testChanges: [] }), []);
+	assert.deepEqual(
+		sliceFailures({
+			card,
+			runs: [
+				{ command: "make", exitCode: 2, timedOut: false },
+				{ command: "slow", exitCode: null, timedOut: true },
+			],
+			changed: ["src/a.ts", "package.json"],
+			testChanges: [{ path: "src/a.test.ts", before: "test(1);test(2);", after: "test(1);" }],
+		}),
+		[
+			"done-when \`make\` exited 2",
+			"done-when \`slow\` timed out",
+			"changed outside the card's files: package.json",
+			"src/a.test.ts: test cases or assertions dropped from 2 to 1",
+		],
+	);
+	// --staged has no card, so the file list is not judged
+	assert.deepEqual(sliceFailures({ card: undefined, runs: [], changed: ["anything"], testChanges: [] }), []);
+});
+
+const BIN = join(import.meta.dirname, "../bin/slice-check.ts");
+
+function repo(): string {
+	const dir = mkdtempSync(join(tmpdir(), "slice-check-"));
+	const git = (...args: string[]) => spawnSync("git", args, { cwd: dir, encoding: "utf8" });
+	git("init", "-q");
+	git("config", "user.email", "t@t");
+	git("config", "user.name", "t");
+	writeFileSync(join(dir, "a.ts"), "export const a = 1;\n");
+	writeFileSync(join(dir, "a.test.ts"), 'test("a", () => {});\ntest("b", () => {});\n');
+	git("add", ".");
+	git("commit", "-qm", "base");
+	return dir;
+}
+
+function run(dir: string, card: string | undefined, ...args: string[]) {
+	return spawnSync("node", ["--no-warnings", BIN, ...args], { cwd: dir, input: card ?? "", encoding: "utf8" });
+}
+
+test("slice-check CLI passes a slice inside its card and fails one outside it", () => {
+	const dir = repo();
+	try {
+		writeFileSync(join(dir, "a.ts"), "export const a = 2;\n");
+		const pass = run(dir, "done-when: [test -f a.ts]\nfiles: [a.ts, a.test.ts]");
+		assert.equal(pass.status, 0, pass.stdout + pass.stderr);
+		assert.match(pass.stdout, /SLICE-CHECK: PASS \(1 files changed, 1 done-when checks\)/);
+
+		writeFileSync(join(dir, "b.ts"), "new\n");
+		writeFileSync(join(dir, "a.test.ts"), 'test("a", () => {});\n');
+		const bad = run(dir, "done-when: [false]\nfiles: [a.ts, a.test.ts]");
+		assert.equal(bad.status, 1);
+		assert.match(bad.stdout, /done-when `false` exited 1/);
+		assert.match(bad.stdout, /outside the card's files: b\.ts/);
+		assert.match(bad.stdout, /a\.test\.ts: test cases or assertions dropped from 2 to 1/);
+
+		assert.equal(run(dir, "files: [a.ts]").status, 2);
+		assert.equal(run(dir, "done-when: [true]\nfiles: [a.ts]", "--base", "nope").status, 2);
+	} finally {
+		rmSync(dir, { recursive: true, force: true });
+	}
+});
+
+test("slice-check --staged judges only staged test files against HEAD", () => {
+	const dir = repo();
+	try {
+		writeFileSync(join(dir, "a.test.ts"), 'test.only("a", () => {});\ntest("b", () => {});\n');
+		assert.equal(run(dir, undefined, "--staged").status, 0, "unstaged change is not judged");
+		spawnSync("git", ["add", "a.test.ts"], { cwd: dir });
+		const staged = run(dir, undefined, "--staged");
+		assert.equal(staged.status, 1);
+		assert.match(staged.stdout, /a\.test\.ts: new skip\/only\/todo markers/);
+	} finally {
+		rmSync(dir, { recursive: true, force: true });
+	}
+});
