-  try {
-    ({ stdout } = await execFileAsync("node", [MAP_MJS, snap.root, "--diff", snap.base, "--json"], {
-      cwd: snap.root,
-      timeout: MAP_TIMEOUT_MS,
-      maxBuffer: 1 << 28,
