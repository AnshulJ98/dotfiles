+// usage: node ~/.pi/agent/bin/slice-check.ts [--base REF] < card
+//        node ~/.pi/agent/bin/slice-check.ts --staged
+//
+// With a card on stdin (the /plan card; see lib/slice-check.ts for the fields it reads), from the repo root:
+//   1. every done-when command exits 0 (bash -c, 5 minutes each);
+//   2. every file changed since REF (default HEAD; tracked changes plus untracked files) matches the card's files;
+//   3. no changed test file has fewer cases or assertions than at REF, or new skip/only markers.
+// --staged needs no card and runs only check 3, on the index against HEAD: a pre-commit hook can call it.
+//
+// Untracked files that were already there before the slice count as changed; stash or commit them first.
+// Exit 0 done, 1 not done (each reason printed), 2 usage or card error.
+import { spawnSync } from "node:child_process";
+import { readFileSync } from "node:fs";
+import { parseArgs } from "node:util";
+import { type Card, type CheckRun, isTestFile, parseCard, sliceFailures, type TestFileChange } from "../lib/slice-check.ts";
+
+const RUN_TIMEOUT_MS = 300_000;
+
+function git(root: string, args: string[]): { ok: boolean; out: string } {
+	const r = spawnSync("git", args, { cwd: root, encoding: "utf8", maxBuffer: 1 << 28 });
+	return { ok: r.status === 0, out: r.stdout ?? "" };
+}
+
+function fail(message: string): never {
+	process.stderr.write(`slice-check: ${message}\n`);
+	process.exit(2);
+}
+
+const { values } = parseArgs({ options: { base: { type: "string", default: "HEAD" }, staged: { type: "boolean", default: false } } });
+const top = spawnSync("git", ["rev-parse", "--show-toplevel"], { encoding: "utf8" });
+if (top.status !== 0) fail("not inside a git repo");
+const root = top.stdout.trim();
+const base = values.base;
+if (!git(root, ["rev-parse", "--verify", "--quiet", `${base}^{commit}`]).ok) fail(`no such commit: ${base}`);
+
+let card: Card | undefined;
+const runs: CheckRun[] = [];
+let changed: string[];
+let testChanges: TestFileChange[];
+const show = (spec: string): string | undefined => {
+	const r = git(root, ["show", spec]);
+	return r.ok ? r.out : undefined;
+};
+const lines = (text: string): string[] => text.split("\n").filter(Boolean);
+
+if (values.staged) {
+	changed = lines(git(root, ["diff", "--cached", "--name-only", "--no-renames", "HEAD"]).out);
+	testChanges = changed.filter(isTestFile).map((path) => ({ path, before: show(`HEAD:${path}`), after: show(`:${path}`) }));
+} else {
+	if (process.stdin.isTTY) fail("pipe the card on stdin, or pass --staged");
+	const parsed = parseCard(readFileSync(0, "utf8"));
+	if (typeof parsed === "string") fail(parsed);
+	card = parsed;
+	for (const command of card.doneWhen) {
+		process.stdout.write(`$ ${command}\n`);
+		const r = spawnSync("bash", ["-c", command], { cwd: root, stdio: ["ignore", "inherit", "inherit"], timeout: RUN_TIMEOUT_MS, killSignal: "SIGKILL" });
+		runs.push({ command, exitCode: r.status, timedOut: r.error !== undefined && "code" in r.error && r.error.code === "ETIMEDOUT" });
+	}
+	changed = [
+		...lines(git(root, ["diff", "--name-only", "--no-renames", base]).out),
+		...lines(git(root, ["ls-files", "--others", "--exclude-standard"]).out),
+	];
+	testChanges = changed.filter(isTestFile).map((path) => {
+		let after: string | undefined;
+		try {
+			after = readFileSync(`${root}/${path}`, "utf8");
+		} catch {
+			after = undefined; // deleted in the working tree
+		}
+		return { path, before: show(`${base}:${path}`), after };
+	});
+}
+
+const reasons = sliceFailures({ card, runs, changed, testChanges });
+if (reasons.length === 0) {
+	process.stdout.write(`SLICE-CHECK: PASS (${changed.length} files changed${card ? `, ${runs.length} done-when checks` : ""})\n`);
+	process.exit(0);
+}
+process.stdout.write(`SLICE-CHECK: FAIL\n- ${reasons.join("\n- ")}\n`);
+process.exit(1);
