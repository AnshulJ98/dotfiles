@@ -0,0 +1,101 @@
+/**
+ * slice-check: judge the working tree against a /plan slice card.
+ *
+ * usage: slice-check [--base <rev>] < card.md
+ *
+ * Reruns every done-when command from the repo root, diffs the tree (tracked
+ * changes plus untracked files) against --base (default HEAD), and fails on a
+ * file outside the card's `files`, a test file with fewer cases or assertions
+ * than at the base, or new skip/only markers. Prints one verdict line first:
+ * `SLICE-CHECK: PASS|FAIL|CANNOT-RUN <reasons>`, then the tail of each failing
+ * command. Exit 0 pass, 1 fail, 2 usage error, 3 cannot run (exit 126/127/77,
+ * a timeout, a refused connection). The pure logic is lib/slice-check.ts.
+ *
+ * Known gap: an untracked file that existed before the slice counts as new, so
+ * /plan's "go" requires a clean tree at the start.
+ */
+import { execFileSync, spawnSync } from "node:child_process";
+import { readFileSync } from "node:fs";
+import { resolve } from "node:path";
+import { parseArgs } from "node:util";
+import { type CommandResult, type FileChange, judge, parseCard } from "./slice-check.ts";
+
+const TIMEOUT_MS = 600_000;
+const TAIL_LINES = 30;
+
+function git(root: string, args: string[]): string {
+	return execFileSync("git", args, { cwd: root, encoding: "utf8", stdio: ["ignore", "pipe", "pipe"], maxBuffer: 1 << 28 });
+}
+
+function showAt(root: string, rev: string, path: string): string | undefined {
+	try {
+		return git(root, ["show", `${rev}:${path}`]);
+	} catch {
+		return undefined;
+	}
+}
+
+function readNow(root: string, path: string): string | undefined {
+	try {
+		return readFileSync(resolve(root, path), "utf8");
+	} catch {
+		return undefined;
+	}
+}
+
+function changes(root: string, base: string): FileChange[] {
+	const tracked = git(root, ["diff", "--no-renames", "--name-only", "-z", base]).split("\0").filter(Boolean);
+	const untracked = git(root, ["ls-files", "--others", "--exclude-standard", "-z"]).split("\0").filter(Boolean);
+	return [...new Set([...tracked, ...untracked])].sort().map((path) => ({ path, before: showAt(root, base, path), after: readNow(root, path) }));
+}
+
+function run(root: string, command: string): CommandResult {
+	const r = spawnSync("bash", ["-c", command], { cwd: root, encoding: "utf8", timeout: TIMEOUT_MS, maxBuffer: 1 << 26 });
+	const timedOut = r.error !== undefined && (r.error as NodeJS.ErrnoException).code === "ETIMEDOUT";
+	return { command, code: r.status, timedOut, output: `${r.stdout ?? ""}${r.stderr ?? ""}` };
+}
+
+function tail(text: string): string {
+	return text.trimEnd().split("\n").slice(-TAIL_LINES).join("\n");
+}
+
+function main(): number {
+	let base = "HEAD";
+	try {
+		const { values } = parseArgs({ options: { base: { type: "string" }, help: { type: "boolean", short: "h" } } });
+		if (values.help) {
+			console.log("usage: slice-check [--base <rev>] < card.md");
+			return 0;
+		}
+		base = values.base ?? base;
+	} catch (error) {
+		console.error(`slice-check: ${error instanceof Error ? error.message : String(error)}`);
+		return 2;
+	}
+	let card: ReturnType<typeof parseCard>;
+	try {
+		card = parseCard(readFileSync(0, "utf8"));
+	} catch {
+		console.error("slice-check: no card on stdin");
+		return 2;
+	}
+	if (typeof card === "string") {
+		console.error(`slice-check: ${card}`);
+		return 2;
+	}
+	let root: string;
+	try {
+		root = git(process.cwd(), ["rev-parse", "--show-toplevel"]).trim();
+		git(root, ["rev-parse", "--verify", "--quiet", `${base}^{commit}`]);
+	} catch {
+		console.error(`slice-check: not in a git repo, or --base ${base} is not a commit`);
+		return 2;
+	}
+	const results = card.doneWhen.map((c) => run(root, c));
+	const { verdict, reasons } = judge(card, results, changes(root, base));
+	console.log(`SLICE-CHECK: ${verdict}${reasons.length ? ` ${reasons.join("; ")}` : ""}`);
+	for (const r of results.filter((x) => x.code !== 0 || x.timedOut)) console.log(`\n--- ${r.command}\n${tail(r.output)}`);
+	return verdict === "PASS" ? 0 : verdict === "FAIL" ? 1 : 3;
+}
+
+process.exitCode = main();
