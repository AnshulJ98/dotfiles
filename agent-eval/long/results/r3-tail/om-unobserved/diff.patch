index 0000000..d4e1ebf
--- /dev/null
+++ b/config/pi/lib/slice-check.ts
@@ -0,0 +1,152 @@
+/**
+ * Pure checks behind bin/slice-check: parse a /plan slice card and judge a
+ * finished slice against it. No I/O here; lib/slice-check-cli.ts runs git and
+ * the done-when commands and feeds the results in.
+ */
+import { isAbsolute, matchesGlob, normalize } from "node:path";
+
+export interface Card {
+	outcome: string;
+	doneWhen: string[];
+	files: string[];
+}
+
+export type Verdict = "PASS" | "FAIL" | "CANNOT-RUN";
+
+export interface CommandResult {
+	command: string;
+	code: number | null;
+	timedOut: boolean;
+	output: string;
+}
+
+export interface FileChange {
+	path: string;
+	/** Content at the base; undefined when the file is new. */
+	before: string | undefined;
+	/** Content now; undefined when the file was deleted. */
+	after: string | undefined;
+}
+
+function unquote(value: string): string {
+	return value.trim().replace(/^(['"])(.*)\1$/, "$2");
+}
+
+/** Split a flow list body on commas outside `{a,b}` brace groups. */
+function splitFlowList(body: string): string[] {
+	const items: string[] = [];
+	let depth = 0;
+	let current = "";
+	for (const char of body) {
+		if (char === "{") depth += 1;
+		if (char === "}") depth = Math.max(0, depth - 1);
+		if (char === "," && depth === 0) {
+			items.push(current);
+			current = "";
+		} else {
+			current += char;
+		}
+	}
+	items.push(current);
+	return items.map(unquote).filter(Boolean);
+}
+
+const TEMP_PATH = /(^|[\s'"=:])(\/private)?\/tmp\/|\/var\/folders\/|\$\{?TMPDIR\b/;
+
+/**
+ * Parse the card's frontmatter: scalars, flow lists (`[a, b]`) and block lists
+ * (`- a`). Returns an error string instead of throwing, for the CLI to print.
+ */
+export function parseCard(text: string): Card | string {
+	const match = /^\s*---\n([\s\S]*?)\n---/.exec(text.replace(/\r\n/g, "\n"));
+	if (!match) return "card has no --- frontmatter";
+	const fields = new Map<string, string | string[]>();
+	let listKey: string | undefined;
+	for (const line of match[1].split("\n")) {
+		const item = /^\s+-\s+(.*)$/.exec(line);
+		if (item && listKey) {
+			const list = fields.get(listKey);
+			if (Array.isArray(list)) list.push(unquote(item[1]));
+			continue;
+		}
+		const pair = /^([\w-]+):\s*(.*)$/.exec(line);
+		if (!pair) continue;
+		const [, key, raw] = pair;
+		listKey = undefined;
+		if (/^[|>]/.test(raw)) return `card field ${key} uses a YAML block scalar; put it on one line`;
+		if (raw === "") {
+			fields.set(key, []);
+			listKey = key;
+		} else if (raw.startsWith("[") && raw.endsWith("]")) {
+			fields.set(key, splitFlowList(raw.slice(1, -1)));
+		} else {
+			fields.set(key, unquote(raw));
+		}
+	}
+	const outcome = fields.get("outcome");
+	if (typeof outcome !== "string" || outcome === "") return "card needs an outcome";
+	const doneWhenField = fields.get("done-when");
+	const doneWhen = typeof doneWhenField === "string" ? [doneWhenField] : (doneWhenField ?? []);
+	if (doneWhen.length === 0) return "card needs at least one done-when command";
+	const temp = doneWhen.find((c) => TEMP_PATH.test(c));
+	if (temp) return `done-when must not run anything under /tmp or $TMPDIR: ${temp}`;
+	const files = fields.get("files");
+	if (!Array.isArray(files) || files.length === 0) return "card needs a non-empty files list";
+	return { outcome, doneWhen, files };
+}
+
+/** True when a repo-relative path matches one of the card's globs. */
+export function isAllowed(path: string, globs: readonly string[]): boolean {
+	if (!path || isAbsolute(path)) return false;
+	const p = normalize(path);
+	if (p.startsWith("..")) return false;
+	return globs.some((glob) => p === normalize(glob) || matchesGlob(p, glob));
+}
+
+export const TEST_FILE = /(\.(test|spec)\.[cm]?[jt]sx?$)|(^|\/)__tests__\/|(^|\/)test_[^/]*\.py$|_test\.py$/;
+const TEST_CASE = /\b(it|test|describe)\s*\(|\bassert\b|\bexpect\s*\(|^\s*(async\s+)?def\s+test_/gm;
+const TEST_SKIP =
+	/\.(skip|only|todo)\s*\(|\b(xit|xdescribe|xtest|fit|fdescribe)\s*\(|\b(skip|only|todo)\s*:\s*true|@pytest\.mark\.(skip|skipif|xfail)\b|\bpytest\.skip\s*\(|@unittest\.skip/g;
+
+function count(text: string | undefined, pattern: RegExp): number {
+	return text === undefined ? 0 : (text.match(pattern) ?? []).length;
+}
+
+/**
+ * Why a test file's change looks like weakened tests rather than fixed code:
+ * fewer cases or assertions than at the base, or new skip/only markers.
+ */
+export function testWeakening(before: string | undefined, after: string | undefined): string | undefined {
+	// Markers first: `test.skip(` also stops counting as a case, and the marker is the clearer reason.
+	if (count(after, TEST_SKIP) > count(before, TEST_SKIP)) return "new skip/only/xfail markers";
+	const was = count(before, TEST_CASE);
+	const now = count(after, TEST_CASE);
+	if (now < was) return `test cases or assertions dropped from ${was} to ${now}`;
+	return undefined;
+}
+
+/** Whether a failed command means "the code is wrong" or "this machine can't run it". */
+export function cannotRun(result: CommandResult): boolean {
+	if (result.timedOut || result.code === 126 || result.code === 127 || result.code === 77) return true;
+	return /ECONNREFUSED|ENOTFOUND|EAI_AGAIN|command not found/.test(result.output);
+}
+
+/** The verdict and its reasons; cannot-run beats fail, since more code can't fix the machine. */
+export function judge(card: Card, results: readonly CommandResult[], changes: readonly FileChange[]): { verdict: Verdict; reasons: string[] } {
+	const reasons: string[] = [];
+	let blocked = false;
+	for (const r of results) {
+		if (r.code === 0 && !r.timedOut) continue;
+		if (cannotRun(r)) blocked = true;
+		reasons.push(`done-when \`${r.command}\` ${r.timedOut ? "timed out" : `exit ${String(r.code)}`}`);
+	}
+	const outside = changes.map((c) => c.path).filter((p) => !isAllowed(p, card.files));
+	if (outside.length) reasons.push(`files outside the card: ${outside.join(", ")}`);
+	for (const c of changes) {
+		if (!TEST_FILE.test(c.path)) continue;
+		const why = testWeakening(c.before, c.after);
+		if (why) reasons.push(`${c.path}: ${why}; restore the tests and fix the code`);
+	}
+	const verdict: Verdict = blocked ? "CANNOT-RUN" : reasons.length ? "FAIL" : "PASS";
+	return { verdict, reasons };
+}
