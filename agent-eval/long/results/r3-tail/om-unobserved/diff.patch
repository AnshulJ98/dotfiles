-export interface WorkerSpec {
-  filesAllowed: string[];
-  tests: string;
-  maxLines: number;
-  allowedCommands: string[];
-  /** Globs whose export headers must not change; empty means no freeze. */
-  interfaceFrozen: string[];
-}
-
-export interface CheckFailure {
-  kind: "fail" | "cannot-run";
-  reason: string;
