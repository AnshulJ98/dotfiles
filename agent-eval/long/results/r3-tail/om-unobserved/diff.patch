+// Run: node --test 'config/pi/tests/*.test.ts'
+// lib/slice-check.ts through its exports, and bin/slice-check end to end in temp repos.
+import assert from "node:assert/strict";
+import { execFileSync, spawnSync } from "node:child_process";
+import { mkdirSync, mkdtempSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { dirname, join, resolve } from "node:path";
+import { test } from "node:test";
+import { type Card, type CommandResult, isAllowed, judge, parseCard, testWeakening } from "../lib/slice-check.ts";
+
+const BIN = resolve(import.meta.dirname, "../bin/slice-check");
+
+const CARD = "---\noutcome: slugs are lowercase\ndone-when:\n  - npm test\n  - npx tsc --noEmit\ninterface: unchanged\nmechanism: slugify()\nfiles: [src/slug.ts, src/slug.test.ts]\nout: unicode\n---\n";
+
+test("parseCard: block list done-when and flow list files", () => {
+	assert.deepEqual(parseCard(CARD), { outcome: "slugs are lowercase", doneWhen: ["npm test", "npx tsc --noEmit"], files: ["src/slug.ts", "src/slug.test.ts"] });
+});
+
+const CARD_ERRORS: Array<[string, string, string]> = [
+	["no frontmatter", "outcome: x\n", "card has no --- frontmatter"],
+	["no outcome", "---\ndone-when: [true]\nfiles: [a]\n---\n", "card needs an outcome"],
+	["no done-when", "---\noutcome: x\nfiles: [a]\n---\n", "card needs at least one done-when command"],
+	["no files", "---\noutcome: x\ndone-when: [true]\n---\n", "card needs a non-empty files list"],
+	["a /tmp check", "---\noutcome: x\ndone-when: [bash /tmp/t.sh]\nfiles: [a]\n---\n", "done-when must not run anything under /tmp or $TMPDIR: bash /tmp/t.sh"],
+	["block scalar", "---\noutcome: >\n  x\n---\n", "card field outcome uses a YAML block scalar; put it on one line"],
+];
+for (const [name, text, want] of CARD_ERRORS) {
+	test(`parseCard: ${name}`, () => assert.equal(parseCard(text), want));
+}
+
+test("parseCard: a single done-when scalar is a one-item list", () => {
+	const card = parseCard("---\noutcome: x\ndone-when: npm test\nfiles: [a]\n---\n");
+	assert.ok(typeof card !== "string");
+	assert.deepEqual(card.doneWhen, ["npm test"]);
+});
+
+const ALLOWED: Array<[string, string[], boolean]> = [
+	["src/a.ts", ["src/**"], true],
+	["test/a.ts", ["src/**"], false],
+	["./README.md", ["README.md"], true],
+	["../x.ts", ["**"], false],
+	["/etc/passwd", ["**"], false],
+];
+for (const [path, globs, want] of ALLOWED) {
+	test(`isAllowed: ${path} in ${globs.join(",")}`, () => assert.equal(isAllowed(path, globs), want));
+}
+
+const WEAKENED: Array<[string, string | undefined, string | undefined, string | undefined]> = [
+	["a test added", "test('a', () => {})", "test('a', () => {})\ntest('b', () => {})", undefined],
+	["a test removed", "test('a', () => {})\ntest('b', () => {})", "test('a', () => {})", "test cases or assertions dropped from 2 to 1"],
+	["an assertion removed", "test('a', () => { assert.ok(x); assert.ok(y) })", "test('a', () => { assert.ok(x) })", "test cases or assertions dropped from 3 to 2"],
+	["skip added", "test('a', () => {})", "test.skip('a', () => {})", "new skip/only/xfail markers"],
+	["pytest skip added", "def test_a():\n    assert f() == 1\n", "@pytest.mark.skip\ndef test_a():\n    assert f() == 1\n", "new skip/only/xfail markers"],
+	["pytest test removed", "def test_a():\n    assert 1\ndef test_b():\n    assert 2\n", "def test_a():\n    assert 1\n", "test cases or assertions dropped from 4 to 2"],
+	["new file", undefined, "test('a', () => {})", undefined],
+	["file deleted", "test('a', () => {})", undefined, "test cases or assertions dropped from 1 to 0"],
+];
+for (const [name, before, after, want] of WEAKENED) {
+	test(`testWeakening: ${name}`, () => assert.equal(testWeakening(before, after), want));
+}
+
+const card: Card = { outcome: "x", doneWhen: ["npm test"], files: ["src/**"] };
+const ok = (command = "npm test"): CommandResult => ({ command, code: 0, timedOut: false, output: "" });
+const JUDGE: Array<[string, CommandResult[], Array<{ path: string; before?: string; after?: string }>, string, string[]]> = [
+	["all green, inside the card", [ok()], [{ path: "src/a.ts", after: "x" }], "PASS", []],
+	["a red check", [{ ...ok(), code: 1 }], [], "FAIL", ["done-when `npm test` exit 1"]],
+	["a missing binary", [{ ...ok(), code: 127 }], [], "CANNOT-RUN", ["done-when `npm test` exit 127"]],
+	["a refused connection", [{ ...ok(), code: 1, output: "connect ECONNREFUSED 127.0.0.1:5432" }], [], "CANNOT-RUN", ["done-when `npm test` exit 1"]],
+	["a timeout", [{ ...ok(), code: null, timedOut: true }], [], "CANNOT-RUN", ["done-when `npm test` timed out"]],
+	["a file outside", [ok()], [{ path: "package.json", before: "{}", after: "{ }" }], "FAIL", ["files outside the card: package.json"]],
+	[
+		"a weakened test inside the card",
+		[ok()],
+		[{ path: "src/a.test.ts", before: "test('a', () => {})\ntest('b', () => {})", after: "test('a', () => {})" }],
+		"FAIL",
+		["src/a.test.ts: test cases or assertions dropped from 2 to 1; restore the tests and fix the code"],
+	],
+];
+for (const [name, results, changes, verdict, reasons] of JUDGE) {
+	test(`judge: ${name}`, () => {
+		assert.deepEqual(judge(card, results, changes.map((c) => ({ path: c.path, before: c.before, after: c.after }))), { verdict, reasons });
+	});
+}
+
+/** A repo with `files` committed on its only commit; returns the repo path. */
+function repo(files: Record<string, string>): string {
+	const dir = mkdtempSync(join(tmpdir(), "slice-check-"));
+	const git = (...args: string[]) => execFileSync("git", ["-c", "user.name=t", "-c", "user.email=t@t", ...args], { cwd: dir });
+	git("init", "-q");
+	for (const [rel, text] of Object.entries(files)) {
+		mkdirSync(dirname(join(dir, rel)), { recursive: true });
+		writeFileSync(join(dir, rel), text);
+	}
+	git("add", ".");
+	git("commit", "-qm", "base");
+	return dir;
+}
+
+const cli = (cwd: string, cardText: string, args: string[] = []) => spawnSync(BIN, args, { cwd, input: cardText, encoding: "utf8" });
+const cardFor = (doneWhen: string, files: string) => `---\noutcome: x\ndone-when: [${doneWhen}]\nfiles: [${files}]\n---\n`;
+
+test("bin/slice-check: a green slice inside the card passes with exit 0", () => {
+	const dir = repo({ "src/a.ts": "1\n" });
+	writeFileSync(join(dir, "src/a.ts"), "2\n");
+	writeFileSync(join(dir, "src/b.ts"), "new\n");
+	const r = cli(dir, cardFor("grep -q 2 src/a.ts", "src/**"));
+	assert.equal(r.status, 0, r.stdout + r.stderr);
+	assert.equal(r.stdout.split("\n")[0], "SLICE-CHECK: PASS");
+});
+
+test("bin/slice-check: an untracked file outside the card and a red check fail with exit 1", () => {
+	const dir = repo({ "src/a.ts": "1\n" });
+	writeFileSync(join(dir, "notes.md"), "x\n");
+	const r = cli(dir, cardFor("grep -q 2 src/a.ts", "src/**"));
+	assert.equal(r.status, 1);
+	assert.equal(r.stdout.split("\n")[0], "SLICE-CHECK: FAIL done-when `grep -q 2 src/a.ts` exit 1; files outside the card: notes.md");
+});
+
+test("bin/slice-check: --base compares with an older commit, so committed changes still count", () => {
+	const dir = repo({ "src/a.ts": "1\n" });
+	const base = execFileSync("git", ["rev-parse", "HEAD"], { cwd: dir, encoding: "utf8" }).trim();
+	writeFileSync(join(dir, "README.md"), "x\n");
+	execFileSync("git", ["-c", "user.name=t", "-c", "user.email=t@t", "add", "."], { cwd: dir });
+	execFileSync("git", ["-c", "user.name=t", "-c", "user.email=t@t", "commit", "-qm", "c"], { cwd: dir });
+	assert.equal(cli(dir, cardFor("true", "src/**")).status, 0, "against HEAD nothing changed");
+	const r = cli(dir, cardFor("true", "src/**"), ["--base", base]);
+	assert.equal(r.status, 1);
+	assert.match(r.stdout, /files outside the card: README\.md/);
+});
+
+test("bin/slice-check: a check that cannot start exits 3", () => {
+	const dir = repo({ "a.txt": "a\n" });
+	const r = cli(dir, cardFor("no-such-binary-xyz", "a.txt"));
+	assert.equal(r.status, 3);
+	assert.match(r.stdout, /^SLICE-CHECK: CANNOT-RUN done-when `no-such-binary-xyz` exit 127/);
+});
+
+test("bin/slice-check: a bad card, a bad flag and a bad base exit 2", () => {
+	const dir = repo({ "a.txt": "a\n" });
+	assert.equal(cli(dir, "no card").status, 2);
+	assert.equal(cli(dir, cardFor("true", "a.txt"), ["--bogus"]).status, 2);
+	assert.equal(cli(dir, cardFor("true", "a.txt"), ["--base", "nope"]).status, 2);
+});
