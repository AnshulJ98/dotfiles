+// Run: node --test 'config/pi/tests/*.test.ts'
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { type CapAction, capAction } from "../extensions/compact-cap.ts";
+
+// [name, tokens, threshold, warned, want]
+const CASES: Array<[string, number | null | undefined, number, boolean, CapAction]> = [
+	["well under the cap", 50_000, 210_000, false, "none"],
+	["at 80% of the cap, first time", 168_000, 210_000, false, "warn"],
+	["at 80% of the cap, already warned", 168_000, 210_000, true, "none"],
+	["just under 80%", 167_999, 210_000, false, "none"],
+	["at the cap exactly", 210_000, 210_000, true, "none"],
+	["past the cap", 210_001, 210_000, true, "compact"],
+	["past the cap, never warned", 300_000, 210_000, false, "compact"],
+	["tokens unknown right after a compaction", null, 210_000, false, "none"],
+	["tokens missing", undefined, 210_000, false, "none"],
+	["cap off", 300_000, 0, false, "none"],
+];
+for (const [name, tokens, threshold, warned, want] of CASES) {
+	test(`capAction: ${name}`, () => assert.equal(capAction(tokens, threshold, warned), want));
+}
