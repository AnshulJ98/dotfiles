+++ b/config/pi/tests/slice-check.test.ts
@@ -0,0 +1,106 @@
+// Run: node --test 'config/pi/tests/*.test.ts'
+import assert from "node:assert/strict";
+import { execFileSync, spawnSync } from "node:child_process";
+import { mkdtempSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join, resolve } from "node:path";
+import { test } from "node:test";
+import { isAllowed, isTestFile, judgeSlice, testWeakening } from "../bin/slice-check.ts";
+
+const ALLOWED: Array<[string, string[], boolean]> = [
+	["src/a.ts", ["src/**"], true],
+	["src/deep/b.ts", ["src/**"], true],
+	["test/a.ts", ["src/**"], false],
+	["README.md", ["README.md"], true],
+	["./README.md", ["README.md"], true],
+	["../outside.ts", ["**"], false],
+	["/etc/passwd", ["**"], false],
+	["", ["**"], false],
+];
+for (const [path, globs, want] of ALLOWED) {
+	test(`isAllowed: '${path}' in ${globs.join(",")}`, () => assert.equal(isAllowed(path, globs), want));
+}
+
+const WEAKENED: Array<[string, string | undefined, string | undefined, boolean]> = [
+	["test added", "test('a', () => {})", "test('a', () => {})\ntest('b', () => {})", false],
+	["test removed", "test('a', () => {})\ntest('b', () => {})", "test('a', () => {})", true],
+	["assertion removed", "test('a', () => { assert.ok(x); assert.ok(y) })", "test('a', () => { assert.ok(x) })", true],
+	["skip added", "test('a', () => {})", "test.skip('a', () => {})", true],
+	["only added", "it('a', () => {})", "it.only('a', () => {})", true],
+	["pytest test removed", "def test_a():\n    assert x\ndef test_b():\n    assert y\n", "def test_a():\n    assert x\n", true],
+	["pytest skip added", "def test_a():\n    assert x\n", "@pytest.mark.skip\ndef test_a():\n    assert x\n", true],
+	["new test file", undefined, "test('a', () => {})", false],
+	["test file deleted", "test('a', () => {})", undefined, true],
+];
+for (const [name, before, after, weakened] of WEAKENED) {
+	test(`testWeakening: ${name}`, () => assert.equal(testWeakening(before, after) !== undefined, weakened));
+}
+
+const TEST_FILES: Array<[string, boolean]> = [
+	["src/a.test.ts", true],
+	["src/__tests__/a.ts", true],
+	["tests/test_slug.py", true],
+	["pkg/slug_test.go", true],
+	["src/a.ts", false],
+	["src/testing.ts", false],
+];
+for (const [path, want] of TEST_FILES) {
+	test(`isTestFile: ${path}`, () => assert.equal(isTestFile(path), want));
+}
+
+const JUDGE: Array<[string, Parameters<typeof judgeSlice>, string[]]> = [
+	["clean slice, tests green", [[{ path: "src/a.ts", before: "a", after: "b" }], ["src/**"], 0], []],
+	["no allowlist and no command: only test files are judged", [[{ path: "x.ts", before: undefined, after: "x" }], undefined, undefined], []],
+	["file outside the allowlist", [[{ path: "other.ts", before: "a", after: "b" }], ["src/**"], 0], ["other.ts: outside --files"]],
+	["red tests", [[], undefined, 1], ["tests exited 1"]],
+	[
+		"weakened test file",
+		[[{ path: "a.test.ts", before: "test('a', () => {})\ntest('b', () => {})", after: "test('a', () => {})" }], undefined, 0],
+		["a.test.ts: test cases or assertions dropped from 2 to 1"],
+	],
+];
+for (const [name, args, want] of JUDGE) {
+	test(`judgeSlice: ${name}`, () => assert.deepEqual(judgeSlice(...args), want));
+}
+
+const BIN = resolve(import.meta.dirname, "../bin/slice-check.ts");
+const env = { ...process.env, GIT_CONFIG_GLOBAL: "/dev/null", GIT_CONFIG_NOSYSTEM: "1", GIT_AUTHOR_NAME: "t", GIT_AUTHOR_EMAIL: "t@t", GIT_COMMITTER_NAME: "t", GIT_COMMITTER_EMAIL: "t@t" };
+
+function repo(): string {
+	const dir = mkdtempSync(join(tmpdir(), "slice-check-"));
+	const git = (...args: string[]) => execFileSync("git", args, { cwd: dir, env, stdio: "ignore" });
+	git("init", "-q");
+	writeFileSync(join(dir, "a.test.ts"), "test('a', () => {})\ntest('b', () => {})\n");
+	git("add", ".");
+	git("commit", "-qm", "init");
+	return dir;
+}
+
+test("slice-check: a weakened test and a file outside --files fail, an untracked file counts as changed", () => {
+	const dir = repo();
+	writeFileSync(join(dir, "a.test.ts"), "test('a', () => {})\n");
+	writeFileSync(join(dir, "new.ts"), "x\n");
+	const run = spawnSync(BIN, ["HEAD", "--files", "*.test.ts", "--", "true"], { cwd: dir, env, encoding: "utf8" });
+	assert.equal(run.status, 1, run.stderr);
+	assert.match(run.stdout, /^SLICE-CHECK: FAIL \(2 files changed since HEAD\)$/m);
+	assert.match(run.stdout, /^- new\.ts: outside --files$/m);
+	assert.match(run.stdout, /^- a\.test\.ts: test cases or assertions dropped from 2 to 1$/m);
+});
+
+test("slice-check: a clean slice with a passing command passes; a failing command fails", () => {
+	const dir = repo();
+	writeFileSync(join(dir, "a.test.ts"), "test('a', () => {})\ntest('b', () => {})\ntest('c', () => {})\n");
+	const pass = spawnSync(BIN, ["HEAD", "--", "exit", "0"], { cwd: dir, env, encoding: "utf8" });
+	assert.equal(pass.status, 0, pass.stdout + pass.stderr);
+	assert.match(pass.stdout, /^SLICE-CHECK: PASS/);
+	const fail = spawnSync(BIN, ["HEAD", "--", "exit", "3"], { cwd: dir, env, encoding: "utf8" });
+	assert.equal(fail.status, 1);
+	assert.match(fail.stdout, /^- tests exited 3$/m);
+});
+
+test("slice-check: usage errors and an unknown base exit 2", () => {
+	const dir = repo();
+	assert.equal(spawnSync(BIN, [], { cwd: dir, env }).status, 2);
+	assert.equal(spawnSync(BIN, ["HEAD", "--files"], { cwd: dir, env }).status, 2);
+	assert.equal(spawnSync(BIN, ["nope"], { cwd: dir, env }).status, 2);
+});
