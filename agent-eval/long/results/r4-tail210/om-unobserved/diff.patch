diff --git a/config/pi/bin/slice-check.ts b/config/pi/bin/slice-check.ts
new file mode 100755
index 0000000..07c802f
--- /dev/null
+++ b/config/pi/bin/slice-check.ts
@@ -0,0 +1,116 @@
+#!/usr/bin/env -S node --no-warnings
+/**
+ * slice-check — the done-when gate for one slice, run by the session that wrote it.
+ *
+ * usage: slice-check.ts BASE [--files GLOB,GLOB...] [-- TEST COMMAND...]
+ *
+ * Compares the working tree (untracked files included) with BASE and fails when:
+ * - a changed file falls outside --files (when given);
+ * - a changed test file has fewer cases or assertions than at BASE, or new
+ *   skip/only/todo markers;
+ * - the test command (run with bash -c) exits non-zero.
+ *
+ * Prints `SLICE-CHECK: PASS` or `SLICE-CHECK: FAIL` then one reason per line.
+ * Exit 0 pass, 1 fail, 2 usage. The counts are a heuristic over the text, so a
+ * rename like `assert` -> `expect` can trip it; read the file before overriding.
+ */
+import { spawnSync } from "node:child_process";
+import { existsSync, readFileSync } from "node:fs";
+import { isAbsolute, matchesGlob, normalize, resolve } from "node:path";
+
+export interface ChangedFile {
+	path: string;
+	/** Content at BASE; undefined when the file is new. */
+	before: string | undefined;
+	/** Content now; undefined when the file was deleted. */
+	after: string | undefined;
+}
+
+const TEST_FILE = /(\.(test|spec)\.[cm]?[jt]sx?$)|(^|\/)__tests__\/|(^|\/)test_[^/]*\.py$|_test\.(py|go)$/;
+const TEST_CASE = /\b(it|test|describe)\s*\(|\bassert\b|\bexpect\s*\(|^\s*def test_|^func Test/gm;
+const TEST_SKIP = /\.(skip|only|todo)\s*\(|\b(xit|xdescribe|xtest|fit|fdescribe)\s*\(|\b(skip|only|todo)\s*:\s*true|@pytest\.mark\.skip|\bt\.Skip\(/g;
+
+function occurrences(text: string | undefined, pattern: RegExp): number {
+	return text === undefined ? 0 : (text.match(pattern) ?? []).length;
+}
+
+export function isTestFile(path: string): boolean {
+	return TEST_FILE.test(path);
+}
+
+/** Why a test file's change looks like weakened tests, or undefined when it does not. */
+export function testWeakening(before: string | undefined, after: string | undefined): string | undefined {
+	const casesBefore = occurrences(before, TEST_CASE);
+	const casesAfter = occurrences(after, TEST_CASE);
+	if (casesAfter < casesBefore) return `test cases or assertions dropped from ${casesBefore} to ${casesAfter}`;
+	if (occurrences(after, TEST_SKIP) > occurrences(before, TEST_SKIP)) return "new skip/only/todo markers";
+	return undefined;
+}
+
+/** True when a repo-relative path matches one of the globs. */
+export function isAllowed(repoRelativePath: string, globs: readonly string[]): boolean {
+	if (!repoRelativePath || isAbsolute(repoRelativePath)) return false;
+	const path = normalize(repoRelativePath);
+	if (path.startsWith("..")) return false;
+	return globs.some((glob) => path === normalize(glob) || matchesGlob(path, glob));
+}
+
+/** Every reason the slice fails; empty means it passes. testsExit is undefined when no command was given. */
+export function judgeSlice(changed: readonly ChangedFile[], allowed: readonly string[] | undefined, testsExit: number | undefined): string[] {
+	const reasons: string[] = [];
+	if (allowed) {
+		for (const file of changed) if (!isAllowed(file.path, allowed)) reasons.push(`${file.path}: outside --files`);
+	}
+	for (const file of changed) {
+		if (!isTestFile(file.path)) continue;
+		const why = testWeakening(file.before, file.after);
+		if (why) reasons.push(`${file.path}: ${why}`);
+	}
+	if (testsExit !== undefined && testsExit !== 0) reasons.push(`tests exited ${testsExit}`);
+	return reasons;
+}
+
+function git(root: string, args: string[]): { ok: boolean; out: string } {
+	const run = spawnSync("git", args, { cwd: root, encoding: "utf8", maxBuffer: 64 * 1024 * 1024 });
+	return { ok: run.status === 0, out: run.stdout ?? "" };
+}
+
+function main(argv: string[]): number {
+	const dash = argv.indexOf("--");
+	const head = dash === -1 ? argv : argv.slice(0, dash);
+	const command = dash === -1 ? [] : argv.slice(dash + 1);
+	const [base, flag, globs] = head;
+	if (!base || (flag !== undefined && (flag !== "--files" || !globs)) || head.length > 3) {
+		process.stderr.write("usage: slice-check.ts BASE [--files GLOB,GLOB...] [-- TEST COMMAND...]\n");
+		return 2;
+	}
+	const top = git(process.cwd(), ["rev-parse", "--show-toplevel"]);
+	if (!top.ok) {
+		process.stderr.write("slice-check: not inside a git repo\n");
+		return 2;
+	}
+	const root = top.out.trim();
+	if (!git(root, ["rev-parse", "--verify", "--quiet", `${base}^{commit}`]).ok) {
+		process.stderr.write(`slice-check: unknown base ${base}\n`);
+		return 2;
+	}
+	const paths = new Set(
+		[...git(root, ["diff", "--name-only", "-z", base]).out.split("\0"), ...git(root, ["ls-files", "--others", "--exclude-standard", "-z"]).out.split("\0")].filter(Boolean),
+	);
+	const changed: ChangedFile[] = [...paths].map((path) => {
+		const shown = git(root, ["show", `${base}:${path}`]);
+		const abs = resolve(root, path);
+		return { path, before: shown.ok ? shown.out : undefined, after: existsSync(abs) ? readFileSync(abs, "utf8") : undefined };
+	});
+	let testsExit: number | undefined;
+	if (command.length > 0) {
+		const run = spawnSync("bash", ["-c", command.join(" ")], { cwd: process.cwd(), stdio: ["ignore", "inherit", "inherit"] });
+		testsExit = run.status ?? 1;
+	}
+	const reasons = judgeSlice(changed, globs?.split(","), testsExit);
+	process.stdout.write(`SLICE-CHECK: ${reasons.length ? "FAIL" : "PASS"} (${changed.length} files changed since ${base}${command.length ? "" : "; no test command given"})\n`);
+	for (const reason of reasons) process.stdout.write(`- ${reason}\n`);
+	return reasons.length ? 1 : 0;
+}
+
+if (import.meta.main) process.exitCode = main(process.argv.slice(2));
