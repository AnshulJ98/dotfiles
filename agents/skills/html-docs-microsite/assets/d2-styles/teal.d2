# Theme "teal": deep teal on mint grey. Diagrams are light only.
# Use: put  ...@"<path to this folder>/teal"  on the first line of a diagram, and render with --theme 0 (the default).
vars: {
  palette: {
    ink: "#16302f"
    ink2: "#47605f"
    n3: "#7f9695"
    n4: "#b3c4c3"
    n5: "#d3dedd"
    n6: "#eef4f3"
    accent: "#1f6f6b"
    mid: "#4fa39e"
    b3: "#b9dcd9"
    b4: "#d9eeec"
    b5: "#eaf6f5"
    b6: "#f3faf9"
  }
  d2-config: {
    theme-overrides: {
      N1: ${palette.ink}; N2: ${palette.ink2}; N3: ${palette.n3}; N4: ${palette.n4}; N5: ${palette.n5}; N6: ${palette.n6}; N7: "#ffffff"
      B1: ${palette.accent}; B2: ${palette.accent}; B3: ${palette.b3}; B4: ${palette.b4}; B5: ${palette.b5}; B6: ${palette.b6}
      AA2: ${palette.accent}; AA4: ${palette.b4}; AA5: ${palette.b5}; AB4: ${palette.b4}; AB5: ${palette.b5}
    }
  }
}
...@vocabulary
