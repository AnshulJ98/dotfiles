# Theme "slate": steel blue on warm grey, the default. Diagrams are light only.
# Use: put  ...@"<path to this folder>/slate"  on the first line of a diagram, and render with --theme 0 (the default).
vars: {
  palette: {
    ink: "#24221e"
    ink2: "#69655d"
    n3: "#8d8d86"
    n4: "#bcbbb5"
    n5: "#dad9d6"
    n6: "#f9f9f8"
    accent: "#3b62a0"
    mid: "#6a9bcc"
    b3: "#bcd0ea"
    b4: "#dfe8f3"
    b5: "#eef2f8"
    b6: "#f6f8fb"
  }
  d2-config: {
    theme-overrides: {
      N1: ${palette.ink}; N2: ${palette.ink2}; N3: ${palette.n3}; N4: ${palette.n4}; N5: ${palette.n5}; N6: ${palette.n6}; N7: "#ffffff"
      B1: ${palette.accent}; B2: ${palette.accent}; B3: ${palette.b3}; B4: ${palette.b4}; B5: ${palette.b5}; B6: ${palette.b6}
      AA2: ${palette.accent}; AA4: ${palette.b4}; AA5: ${palette.b5}; AB4: ${palette.b4}; AB5: ${palette.b5}
    }
  }
}
...@vocabulary
