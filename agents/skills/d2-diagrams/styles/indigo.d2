# Theme "indigo": navy strokes on lavender. Diagrams are light only.
# Use: put  ...@"<path to this folder>/indigo"  on the first line of a diagram, and render with --theme 0 (the default).
vars: {
  palette: {
    ink: "#1f2340"
    ink2: "#4b5068"
    n3: "#8a8fa3"
    n4: "#b9bdcc"
    n5: "#d6d9e6"
    n6: "#eef0f8"
    accent: "#2f3a8f"
    mid: "#6f79d8"
    b3: "#c9cdf0"
    b4: "#e3e6fa"
    b5: "#edf0fd"
    b6: "#f4f5fe"
  }
  d2-config: {
    theme-overrides: {
      N1: ${palette.ink}; N2: ${palette.ink2}; N3: ${palette.n3}; N4: ${palette.n4}; N5: ${palette.n5}; N6: ${palette.n6}; N7: "#ffffff"
      B1: ${palette.accent}; B2: ${palette.accent}; B3: ${palette.b3}; B4: ${palette.b4}; B5: ${palette.b5}; B6: ${palette.b6}
      AA2: ${palette.accent}; AA4: ${palette.b4}; AA5: ${palette.b5}; AB4: ${palette.b4}; AB5: ${palette.b5}
    }
  }
}
...@vocabulary
