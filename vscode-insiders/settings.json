{
  "includeCoAuthoredBy": false,
  "scm.addAICoAuthor": "off",
  "git.addAICoAuthor": "off",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.productIconTheme": "material-product-icons",
  "editor.fontFamily": "Iosevka Nerd Font",
  "editor.codeLensFontFamily": "Iosevka Nerd Font",
  "editor.inlayHints.fontFamily": "Iosevka Nerd Font",
  "debug.console.fontFamily": "Iosevka Nerd Font",
  "markdown.preview.fontFamily": "Iosevka Nerd Font",
  "win-ca.inject": "append",
  "security.workspace.trust.untrustedFiles": "open",
  "keyboard.dispatch": "keyCode",
  "http.noProxy": ["localhost,127.0.0.1,::1"],
  "workbench.colorCustomizations": {
    "editorBracketHighlight.foreground1": "#ffee00",
    "editorBracketHighlight.foreground2": "#ff44ff",
    "editorBracketHighlight.foreground3": "#44ddff",
    "editorBracketHighlight.foreground4": "#cc88ff",
    "editorBracketHighlight.foreground5": "#44ffcc",
    "editorBracketHighlight.foreground6": "#ff3377",
    "editorBracketHighlight.unexpectedBracket.foreground": "#ff5555",
    "terminal.background": "#00000000",
    "editorPane.background": "#161f2700",
    "editorGroupHeader.tabsBackground": "#161f2700",
    "editorGroupHeader.noTabsBackground": "#161f2700",
    "breadcrumb.background": "#161f2700",
    "editorGutter.background": "#161f2700",
    "panel.background": "#161f2700",
    "tab.activeBackground": "#161f2700",
    "tab.unfocusedActiveBackground": "#161f2700",
    "sideBar.background": "#161f27b3",
    "sideBarTitle.background": "#161f27b3",
    "activityBar.background": "#161f27b3",
    "editor.background": "#161f27b3",
    "tab.inactiveBackground": "#161f27b3",
    "tab.unfocusedInactiveBackground": "#161f27b3",
    "editorStickyScroll.background": "#161f27bf",
    "editorStickyScrollGutter.background": "#161f27bf",
    "sideBarStickyScroll.background": "#161f27bf",
    "panelStickyScroll.background": "#161f27bf",
    "terminalStickyScroll.background": "#161f27bf",
    "inlineChat.background": "#161f27e6",
    "editorWidget.background": "#161f27e6",
    "editorHoverWidget.background": "#161f27e6",
    "editorSuggestWidget.background": "#161f27e6",
    "notifications.background": "#161f27e6",
    "notificationCenterHeader.background": "#161f27e6",
    "menu.background": "#161f27e6",
    "quickInput.background": "#161f27e6",
  },
  "window.titleBarStyle": "custom",
  "git.autofetch": true,
  "remote.autoForwardPortsSource": "hybrid",
  "remote.autoForwardPortsFallback": 50,
  "terminal.integrated.cursorStyle": "line",
  "postman.mcp.notifications.postmanMCP": false,
  "terminal.integrated.scrollback": 100000,
  "security.allowedUNCHosts": ["wsl.localhost"],
  "remote.SSH.remotePlatform": {
    "localhost": "linux",
  },
  "[dockercompose]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": true,
    },
    "editor.defaultFormatter": "redhat.vscode-yaml",
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
  },
  "redhat.telemetry.enabled": false,
  "yaml.customTags": [
    "!And",
    "!And sequence",
    "!If",
    "!If sequence",
    "!Not",
    "!Not sequence",
    "!Equals",
    "!Equals sequence",
    "!Or",
    "!Or sequence",
    "!FindInMap",
    "!FindInMap sequence",
    "!Base64",
    "!Join",
    "!Join sequence",
    "!Cidr",
    "!Ref",
    "!Sub",
    "!Sub sequence",
    "!GetAtt",
    "!GetAZs",
    "!ImportValue",
    "!ImportValue sequence",
    "!Select",
    "!Select sequence",
    "!Split",
    "!Split sequence",
  ],
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "workbench.secondarySideBar.defaultVisibility": "visible",
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "editor.inlineSuggest.fontFamily": "Iosevka Nerd Font",
  "scm.inputFontFamily": "Iosevka Nerd Font",
  "debug.allowBreakpointsEverywhere": true,
  "debug.toolBarLocation": "commandCenter",
  "editor.fontSize": 17,
  "workbench.fontAliasing": "subpixel-antialiased",
  "debug.console.fontSize": 15,
  "terminal.integrated.fontFamily": "Iosevka Nerd Font",
  "terminal.integrated.fontLigatures.enabled": true,
  "terminal.integrated.fontSize": 16,
  "terminal.integrated.fontWeight": "500",
  "dev.containers.dockerPath": "podman",
  "application.shellEnvironmentResolutionTimeout": 20,
  "githubPullRequests.pullBranch": "never",
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.hideCursorInOverviewRuler": true,
  "editor.overviewRulerBorder": false,
  "editor.scrollbar.horizontal": "hidden",
  "editor.scrollbar.vertical": "hidden",
  "color-highlight.markRuler": false,
  "workbench.tree.renderIndentGuides": "none",
  "explorer.openEditors.visible": 0,
  "editor.cursorBlinking": "phase",
  "editor.cursorSmoothCaretAnimation": "on",
  "workbench.layoutControl.type": "menu",
  "scm.inputFontSize": 15,
  "markdown.preview.fontSize": 17,
  "vim.disableExtension": true,
  "terminal.integrated.gpuAcceleration": "off",
  "window.autoDetectColorScheme": true,
  "workbench.layoutControl.enabled": false,
  "workbench.colorTheme": "Gruvbox Dark Hard",
  "aws.telemetry": false,
  "python.defaultInterpreterPath": "/opt/homebrew/bin/python3",
  "editor.aiStats.enabled": false,
  "spellright.language": ["en"],
  "spellright.documentTypes": ["latex", "plaintext", "markdown"],
  "vscode-pets.throwBallWithMouse": true,
  "vscode-pets.petSize": "large",
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
  },
  "vim.autoSwitchInputMethod.enable": true,
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1,
  },
  "editor.semanticHighlighting.enabled": true,
  "editor.semanticTokenColorCustomizations": {
    "[Bearded Theme Monokai Black Pro Filter]": {
      "enabled": true,
      "rules": {
        "variable.readonly": {
          "fontStyle": "italic",
        },
        "property.readonly": {
          "fontStyle": "italic",
        },
        "namespace": {
          "foreground": "#44ddff",
        },
        "typeParameter": {
          "foreground": "#cc88ff",
          "fontStyle": "italic",
        },
        "enumMember": {
          "foreground": "#ffee00",
        },
      },
    },
    "[Ayu Dark]": {
      "enabled": true,
      "rules": {
        "property": "#f07178",
        "variable": "#bfbdb6",
        "variable.readonly": "#d2a6ff",
        "parameter": "#d2a6ff",
        "enumMember": "#d2a6ff",
      },
    },
  },
  "editor.tokenColorCustomizations": {
    "[Ayu Dark]": {
      "textMateRules": [
        {
          "scope": [
            "variable.other.readwrite.alias",
            "meta.object-literal.key",
            "variable.other.constant",
          ],
          "settings": { "foreground": "#f07178" },
        },
      ],
    },
  },
  "editor.bracketPairColorization.enabled": true,
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
  "editor.guides.bracketPairs": "active",
  "editor.guides.highlightActiveIndentation": true,
  "editor.guides.bracketPairsHorizontal": "active",
  "editor.guides.indentation": true,
  "editor.inlayHints.enabled": "onUnlessPressed",
  "js/ts.inlayHints.parameterNames.enabled": "literals",
  "js/ts.inlayHints.parameterTypes.enabled": true,
  "js/ts.inlayHints.variableTypes.enabled": true,
  "js/ts.inlayHints.functionLikeReturnTypes.enabled": true,
  "js/ts.inlayHints.propertyDeclarationTypes.enabled": true,
  "editor.stickyScroll.enabled": true,
  "editor.stickyScroll.maxLineCount": 5,
  "editor.minimap.enabled": false,
  "hediet.vscode-drawio.resizeImages": null,
  "hediet.vscode-drawio.theme": "kennedy",
  "hediet.vscode-drawio.appearance": "dark",
  "hediet.vscode-drawio.codeLinkActivated": true,
  "terminal.external.linuxExec": "xterm-kitty",
  "terminal.integrated.allowInUntrustedWorkspace": true,
  "postman.telemetry.enabled": false,
  "git.useEditorAsCommitInput": false,
  "markdown-preview-enhanced.codeBlockTheme": "vscode.css",
  "markdown-preview-enhanced.previewTheme": "atom-dark.css",
  "markdown-preview-enhanced.revealjsTheme": "none.css",
  "terminal.integrated.enableImages": true,
  "editor.experimentalGpuAcceleration": "on",
  "dev.containers.gpuAvailability": "all",
  "vscode_vibrancy.opacity": 0.7,
  "vscode_vibrancy.refreshInterval": 10,
  "vscode_vibrancy.backgroundOverride": "#161f27",
  "vscode_vibrancy.enableAutoTheme": true,
  "vscode_vibrancy.theme": "Default Dark",
  "workbench.preferredDarkColorTheme": "Bearded Theme HC Midnight Void",
  "editor.wordWrap": "on",
  "custom-ui-style.electron": {
    "frame": false,
    "transparent": true,
    "opacity": "0.7",
    "backgroundColor": "rgba(0, 0, 0, 0)",
    "vibrancy": "fullscreen-ui",
  },
  "terminal.external.osxExec": "kitty.app",
  "vscode_custom_css.imports": [
    "file:///Users/anshulj/Library/Application Support/Code - Insiders/User/css/.vscode-custom.css",
  ],
  "vscode_vibrancy.disableThemeFixes": true,
  "workbench.experimental.modernUI": true,
  "chat.instructionsFilesLocations": {
    ".github/instructions": true,
    ".claude/rules": true,
    "~/.copilot/instructions": true,
    "~/.claude/rules": true,
    "/var/folders/vj/vd1_qxf96633zxvwp1rmv07r0000gn/T/postman-collections-post-response.instructions.md": true,
    "/var/folders/vj/vd1_qxf96633zxvwp1rmv07r0000gn/T/postman-collections-pre-request.instructions.md": true,
    "/var/folders/vj/vd1_qxf96633zxvwp1rmv07r0000gn/T/postman-folder-post-response.instructions.md": true,
    "/var/folders/vj/vd1_qxf96633zxvwp1rmv07r0000gn/T/postman-folder-pre-request.instructions.md": true,
    "/var/folders/vj/vd1_qxf96633zxvwp1rmv07r0000gn/T/postman-http-request-post-response.instructions.md": true,
    "/var/folders/vj/vd1_qxf96633zxvwp1rmv07r0000gn/T/postman-http-request-pre-request.instructions.md": true,
  },
  "chat.editor.fontSize": 17,
  "editor.minimap.sectionHeaderFontSize": 12,
  "chat.fontSize": 16,
  "vscode-neovim.revealCursorScrollLine": true,
  "vscode-neovim.neovimInitVimPaths.darwin": "~/Dev/dotfiles/config/nvim/init.lua",
