[init]
	# Hooks for new repos; existing repos: config/git/bin/git-hooks-install <repo>...
	templateDir = ~/.config/git/template
[user]
	name = Anshul Joshi
	email = joshianshul98@gmail.com
[credential]
	helper = osxkeychain
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[core]
	excludesfile = ~/.gitignore_global
[merge]
	tool = nvimdiff
[mergetool]
	prompt = false
	keepBackup = false
[diff]
	tool = hunk
[difftool]
	prompt = false
[include]
	# The active theme's [delta "theme"] feature, used by lazygit's diffRenderers.
	# `theme <name>` repoints ~/.config/themes/current.
	path = ~/.config/themes/current/delta.gitconfig
[difftool "hunk"]
	cmd = hunk difftool \"$LOCAL\" \"$REMOTE\" \"$MERGED\"
