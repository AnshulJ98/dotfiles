# macOS
.DS_Store

# Common backups / orig files
*.bak
*.bak.*
*.orig
*.pre-rebuild
*.tui-migration.bak

# Lock files and build artifacts that shouldn't be tracked here
node_modules/
package-lock.json
bun.lock
yarn.lock
pnpm-lock.yaml

# Machine-only kitty settings (kitty.conf globincludes it)
config/kitty/local.conf

# The active theme: links that `theme <name>` (config/themes/theme) repoints
config/themes/current
config/pi/themes/current.json

# Restored from config/yazi/package.toml by `ya pkg install`
config/yazi/plugins/

# Runtime state / caches / logs (always machine-local)
*.log
logs/
session-state/
session-store.db
session-store.db-shm
session-store.db-wal
command-history-state.json
vscode.session.metadata.cache.json
mcp-needs-auth-cache.json
ide/

# Secrets — never commit
.env
.env.*
*credentials*
*.pem
*.key
*.p12
*_rsa
*_ed25519
*_ecdsa
.pi-subagents/

# pi's managed-install launcher, written into ~/.pi/agent/bin (a link to config/pi/bin).
# Copied to a machine without that install, it shadows the real pi on PATH.
config/pi/bin/pi

# agent-eval probe outputs
agent-eval/results/
agent-eval/long/.pkgs/
agent-eval/long/results/*/grade/**/judge/home/
# r3-tail's runaway arm left 564M of snapshots; snapshots are reproducible from session.jsonl, not kept from r3 on
agent-eval/long/results/r[3-9]*/*/snapshots/

# Claude Code account-synced skills (runtime cache; ~/.claude/skills links here)
claude/skills/synced/

# Anthropic's skills: proprietary licence, so install.sh fetches them from
# github.com/anthropics/skills and links them here instead of committing them
agents/skills/pptx
agents/skills/docx
agents/skills/xlsx
agents/skills/pdf
agents/skills/skill-creator

# Python bytecode (kitty compiles its watcher next to it)
__pycache__/
config/wezterm/local.lua
config/powershell/local.ps1
